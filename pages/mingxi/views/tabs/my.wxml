                    <text class="ledger-due-name">应付</text>
                    <text class="ledger-due-desc">我欠别人 · {{ledgerPayableCount}} 笔</text>
                  </view>
                  <view class="ledger-due-right">
                    <text class="ledger-due-val ledger-due-val--out">-{{ledgerPayable}}</text>
                    <view class="ledger-due-arrow"></view>
                  </view>
                </view>
                <view class="ledger-due-net">
                  <text class="ledger-due-net-label">净往来</text>
                  <text class="ledger-due-net-val {{ledgerNetPos ? 'ledger-due-val--in' : 'ledger-due-val--out'}}">{{ledgerNetPos ? '+' : ''}}{{ledgerNet}}</text>
                </view>
              </block>
              <view wx:else class="ledger-due-empty">暂无未结清往来款</view>
            </view>
          </view>

          <!-- 公司账本：资产概览 -->
          <view wx:if="{{ledgerScope === 'company'}}" class="ledger-sec">
            <view class="ledger-sec-head">
              <text class="ledger-sec-title">资产概览</text>
              <text class="ledger-sec-sub">{{ledgerMonthLabel}}</text>
            </view>
            <view class="ledger-stat-row">
              <view class="ledger-stat">
                <text class="ledger-stat-val">{{ledgerFunds}}</text>
                <text class="ledger-stat-label">总资金</text>
              </view>
              <view class="ledger-stat-sep"></view>
              <view class="ledger-stat">
                <text class="ledger-stat-val ledger-stat-val--out">{{ledgerLiability}}</text>
                <text class="ledger-stat-label">总负债</text>
              </view>
            </view>
            <view class="ledger-asset-divider"></view>
            <view class="ledger-stat-row">
              <view class="ledger-stat">
                <text class="ledger-stat-val {{ledgerNetAssetsPos ? 'ledger-stat-val--in' : 'ledger-stat-val--out'}}">{{ledgerNetAssets}}</text>
                <text class="ledger-stat-label">净资产</text>
              </view>
              <view class="ledger-stat-sep"></view>
              <view class="ledger-stat">
                <text class="ledger-stat-val {{ledgerDisposablePos ? 'ledger-stat-val--in' : 'ledger-stat-val--out'}}">{{ledgerDisposable}}</text>
                <text class="ledger-stat-label">可支配资产</text>
              </view>
            </view>
          </view>

          <!-- 往来款（公司账本） -->
          <view wx:if="{{ledgerScope === 'company'}}" class="ledger-sec">
            <view class="ledger-sec-head">
              <text class="ledger-sec-title">往来款</text>
              <text class="ledger-sec-sub">未结清</text>
            </view>
            <block wx:if="{{ledgerReceivableCount > 0 || ledgerPayableCount > 0}}">
              <view class="ledger-due-row" bindtap="onLedgerGotoSettle">
                <view class="ledger-due-left">
                  <text class="ledger-due-name">应收</text>
                  <text class="ledger-due-desc">别人欠我 · {{ledgerReceivableCount}} 笔</text>
                </view>
                <view class="ledger-due-right">
                  <text class="ledger-due-val ledger-due-val--in">+{{ledgerReceivable}}</text>
                  <view class="ledger-due-arrow"></view>
                </view>
              </view>
              <view class="ledger-due-row" bindtap="onLedgerGotoSettle">
                <view class="ledger-due-left">
                  <text class="ledger-due-name">应付</text>
                  <text class="ledger-due-desc">我欠别人 · {{ledgerPayableCount}} 笔</text>
                </view>
                <view class="ledger-due-right">
                  <text class="ledger-due-val ledger-due-val--out">-{{ledgerPayable}}</text>
                  <view class="ledger-due-arrow"></view>
                </view>
              </view>
              <view class="ledger-due-net">
                <text class="ledger-due-net-label">净往来</text>
                <text class="ledger-due-net-val {{ledgerNetPos ? 'ledger-due-val--in' : 'ledger-due-val--out'}}">{{ledgerNetPos ? '+' : ''}}{{ledgerNet}}</text>
              </view>
            </block>
            <view wx:else class="ledger-due-empty">暂无未结清往来款</view>
          </view>

          <!-- 月度预算（仅个人账本） -->
          <view wx:if="{{ledgerScope === 'personal'}}" class="ledger-sec ledger-budget-sec" id="ledger-budget">
            <view class="ledger-sec-head">
              <text class="ledger-sec-title">月度预算</text>
              <text class="ledger-budget-remain {{ledgerOverBudget ? 'ledger-budget-remain--over' : ''}}">{{ledgerBudgetRemainText}}</text>
            </view>

            <view wx:if="{{ledgerBudget > 0}}" class="ledger-budget-bar">
              <view class="ledger-budget-fill {{ledgerOverBudget ? 'ledger-budget-fill--over' : ''}}" style="width: {{ledgerBudgetUsedPct}}%;"></view>
            </view>
            <view wx:if="{{ledgerBudget > 0}}" class="ledger-budget-meta">
              <text class="ledger-budget-meta-txt">已用 ¥{{ledgerBudgetUsed}}</text>
              <text class="ledger-budget-meta-txt">{{ledgerBudgetUsedPct}}%</text>
              <text class="ledger-budget-meta-txt">预算 ¥{{ledgerBudget}}</text>
            </view>

            <view class="ledger-budget-edit">
              <view class="ledger-budget-input-wrap">
                <text class="ledger-budget-cny">¥</text>
                <input class="ledger-budget-input" type="digit" placeholder="设置本月预算" placeholder-class="ledger-budget-ph" value="{{ledgerBudgetInput}}" bindinput="onLedgerBudgetInput"/>
              </view>
              <view class="ledger-budget-save" bindtap="onLedgerBudgetSave">保存</view>
            </view>
          </view>
          </view>
        </scroll-view>
      </view>
      <!-- 正常我的页面 -->
      <view class="card grid-span-3 my-card" wx:else>
        <view class="my-profile">
          <text class="my-login-text" bindtap="onLoginEntry" wx:if="{{isLoggedIn === false}}">{{t.my_login_register}}</text>
          <text class="my-nickname" bindtap="onMyAvatarTap" wx:else>{{userInfo.nickName}}</text>
          <image class="my-avatar" src="{{avatarDisplay}}" wx:if="{{isLoggedIn && avatarDisplay}}" mode="aspectFill" bindtap="onMyAvatarTap"></image>
          <view class="my-avatar my-avatar--empty" wx:elif="{{isLoggedIn}}" bindtap="onMyAvatarTap"><text class="my-avatar-plus">＋</text></view>
          <view class="my-avatar" wx:else></view>
        </view>
        <view class="my-group">
          <view class="my-item {{vipStatus && vipStatus.vipLevel > 0 ? 'my-item--vip' : 'my-item--vip-free'}}" bindtap="onVipEntry">
            <view class="my-item-icon-wrap">
              <image class="my-item-icon" src="/assets/icons/VIP.png" mode="aspectFit"/>
              <view class="my-item-vip-badge" wx:if="{{vipStatus && vipStatus.vipLevel > 0}}"><text class="my-item-vip-badge-text">PRO</text></view>
            </view>
            <view class="my-item-body">
              <text class="my-item-title {{vipStatus && vipStatus.vipLevel > 0 ? 'my-item-title--vip' : ''}}">{{vipStatus && vipStatus.vipLevel > 0 ? vipCards[vipStatus.vipLevel - 1].name : t.vip_title}}</text>
              <text class="my-item-sub" wx:if="{{!vipStatus || vipStatus.vipLevel === 0}}">{{vipStatus && vipStatus.usage ? '' + vipStatus.usage.asr + '/' + vipStatus.limits.asr + ' · 导出 ' + vipStatus.usage.export + '/' + vipStatus.limits.export : t.vip_sub}}</text>
              <view class="my-item-vip-expire" wx:else>
                <text class="my-item-vip-expire-text">{{vipExpiresText}}</text>
                <text class="my-item-vip-expire-days" wx:if="{{vipTrialDays > 0}}">剩 {{vipTrialDays}} 天</text>
              </view>
            </view>
            <view class="my-item-arrow-wrap">
              <text class="my-item-arrow my-item-arrow--vip" wx:if="{{vipStatus && vipStatus.vipLevel > 0}}">〉</text>
              <text class="my-item-arrow" wx:else>〉</text>
            </view>
          </view>
          <view class="my-icon-row">
            <view class="my-icon-item" bindtap="onGotoPersonalLedger"><image class="my-icon-circle" src="/assets/icons/gerenzhangben.png" mode="aspectFit"/><text class="my-icon-label">{{t.detail_personal_ledger}}</text></view>
            <view class="my-icon-item" wx:if="{{canSeeCompanyLedger}}" bindtap="onGotoCompanyLedger"><image class="my-icon-circle" src="/assets/icons/gongsizhangben.png" mode="aspectFit"/><text class="my-icon-label">{{t.detail_company_ledger}}</text></view>
            <view class="my-icon-item" bindtap="onAuditEntry">
              <view class="my-icon-circle my-icon-circle--badge-host">
                <image class="my-icon-circle-img" src="/assets/icons/shenhe.png" mode="aspectFit"/>
                <view class="notify-badge" wx:if="{{hasPendingAudit}}"></view>
              </view>
              <text class="my-icon-label">{{t.my_audit}}</text>
            </view>
            <view class="my-icon-item" bindtap="onNotifyEntry">
              <view class="my-icon-circle my-icon-circle--badge-host">
                <image class="my-icon-circle-img" src="/assets/icons/tongzhi.png" mode="aspectFit"/>
                <view class="notify-badge" wx:if="{{hasUnreadNotify}}"></view>
              </view>
              <text class="my-icon-label">{{t.my_notify}}</text>
            </view>
          </view>
        </view>
        <view class="my-group">
          <view class="my-item" bindtap="onCustomOverviewEntry">
            <image class="my-item-icon" src="/assets/icons/jianlan.png" mode="aspectFit"/>
            <view class="my-item-body">
              <text class="my-item-title">{{t.custom_overview_title}}</text>
              <text class="my-item-sub">{{t.custom_overview_sub}}</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item" bindtap="onCustomCategoryEntry">
            <image class="my-item-icon" src="/assets/icons/fenlei.png" mode="aspectFit"/>
            <view class="my-item-body">
              <text class="my-item-title">{{t.custom_cat_title}}</text>
              <text class="my-item-sub">{{t.custom_cat_sub}}</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item my-share-entry" bindtap="onCompanyShareEntry">
            <image class="my-item-icon" src="/assets/icons/lianjiegongsigongxiangtongyizhangben.png" mode="aspectFit"/>
            <view class="my-item-body">
              <!-- 员工待审核 -->
              <block wx:if="{{settingsLedgerRole === 'employee' && settingsCompanyStatus === 'pending'}}">
                <text class="my-item-title" style="color:#fa9d3b">等待审核中...</text>
                <text class="my-item-sub">请联系老板通过审核</text>
              </block>
              <!-- 员工已通过 -->
              <block wx:elif="{{settingsLedgerRole === 'employee' && settingsCompanyStatus === 'approved'}}">
                <text class="my-item-title" style="color:#07c160">{{companyName || '公司账本'}}</text>
                <text class="my-item-sub">{{companyBossTitle || 'BOSS'}}</text>
              </block>
              <!-- 老板 -->
              <block wx:elif="{{settingsLedgerRole === 'boss'}}">
                <text class="my-item-title" style="color:#07c160">{{companyName || t.my_share_ledger}}</text>
                <text class="my-item-sub">{{companyBossTitle || 'BOSS'}}</text>
              </block>
              <!-- 未加入 -->
              <block wx:else>
                <text class="my-item-title">{{t.my_share_ledger}}</text>
                <text class="my-item-sub">{{t.my_share_sub}}</text>
              </block>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item" bindtap="onExportBillEntry">
            <image class="my-item-icon" src="/assets/icons/daochu.png" mode="aspectFit"/>
            <view class="my-item-body">
              <text class="my-item-title">{{t.my_export}}</text>
              <text class="my-item-sub">{{t.my_export_sub}}</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
        </view>
        <view class="my-group">
          <view class="my-item" bindtap="onContactEntry">
            <image class="my-item-icon" src="/assets/icons/screenshot.png" mode="aspectFit"/>
            <view class="my-item-body">
              <text class="my-item-title">{{t.my_contact}}</text>
              <text class="my-item-sub">{{t.my_contact_sub}}</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item my-item-last" bindtap="onSettingsEntry">
            <image class="my-item-icon" src="/assets/icons/shezhi.png" mode="aspectFit"/>
            <view class="my-item-body"><text class="my-item-title">{{t.my_settings}}</text></view>
            <text class="my-item-arrow">〉</text>
          </view>
        </view>
      </view>
    </block>
