    <!-- Tab 4: 我的 -->
    <block wx:if="{{currentTab === 4}}">
      <!-- VIP升级页 -->
      <view class="card grid-span-3 my-card vip-main-card" wx:if="{{showVipPage}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onVipBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/VIP.png" mode="aspectFit"/><text class="custom-cat-title">{{t.vip_subscribe}}</text></view>
        </view>
        <!-- 试用激活横幅 -->
        <view class="vip-trial-banner" wx:if="{{showTrialBanner}}">
          <view class="vip-trial-banner-bg">
            <text class="vip-trial-banner-title">新用户限时福利</text>
            <text class="vip-trial-banner-desc">领取 3 个月企业版 PRO 免费试用</text>
            <view class="vip-trial-banner-countdown">
              <text class="vip-trial-banner-countdown-num">{{trialOfferDays}}</text>
              <text class="vip-trial-banner-countdown-label">天后截止</text>
            </view>
            <text class="vip-trial-banner-date">截止日期 2026-09-25</text>
            <view class="vip-trial-banner-btn" bindtap="onActivateTrial"><text class="vip-trial-banner-btn-text">立即领取</text></view>
            <text class="vip-trial-banner-note">试用期间导出账单和凭证扫描仍有广告</text>
          </view>
        </view>
        <!-- 体验版：占位 spacer 保持标题置顶 -->
        <view style="flex: 1;"></view>
        <!-- 体验版暂不显示个人/企业版套餐卡 -->
        <scroll-view wx:if="{{false}}" class="vip-plan-list" scroll-y enhanced show-scrollbar="{{false}}">
          <!-- 三张卡垂直排列 -->
          <view class="vip-plan-card vip-plan--{{item.theme}} {{vipSelected === index ? 'vip-plan--selected' : ''}}" wx:for="{{vipCards}}" wx:key="id" wx:for-index="index" bindtap="onVipSelect" data-id="{{index}}">
            <!-- 卡片头部 -->
            <view class="vip-plan-hd">
              <view class="vip-plan-name-row">
                <text class="vip-plan-name">{{item.name}}</text>
                <text class="vip-plan-tagline">{{item.tagline}}</text>
              </view>
            </view>
            <!-- 功能列表 -->
            <view class="vip-plan-features">
              <view class="vip-plan-feat" wx:for="{{item.features}}" wx:key="*this" wx:for-item="f">
                <view class="vip-plan-feat-dot"></view>
                <text class="vip-plan-feat-text">{{f}}</text>
              </view>
            </view>
            <!-- 企业版席位选择器 -->
            <view class="vip-seats-row" wx:if="{{item.isEnterprise}}">
              <text class="vip-seats-label">席位人数</text>
              <view class="vip-seats-ctrl">
                <view class="vip-seats-btn {{vipEnterpriseSeats <= item.enterpriseSeats.min ? 'vip-seats-btn--disabled' : ''}}" catchtap="onVipSeatsMinus"><text class="vip-seats-btn-text">−</text></view>
                <text class="vip-seats-num">{{vipEnterpriseSeats}}</text>
                <view class="vip-seats-btn {{vipEnterpriseSeats >= 20 ? 'vip-seats-btn--disabled' : ''}}" catchtap="onVipSeatsPlus"><text class="vip-seats-btn-text">+</text></view>
              </view>
              <text class="vip-seats-hint">4-20人</text>
            </view>
            <!-- 价格区域 -->
            <view class="vip-plan-price">
              <block wx:if="{{item.isContact}}">
                <view class="vip-contact-btn"><text class="vip-contact-text">联系我们</text></view>
              </block>
              <block wx:elif="{{item.isEnterprise}}">
                <!-- 企业版动态价格 -->
                <view class="vip-price-row" wx:if="{{vipEnterpriseSeats <= item.enterpriseSeats.annualOnlyAbove}}">
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{item.enterpriseSeats.basePrice + (vipEnterpriseSeats - item.enterpriseSeats.min) * item.enterpriseSeats.pricePerSeat}}</text>
                  <text class="vip-price-unit">/月</text>
                </view>
                <view class="vip-price-row" wx:else>
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{(item.enterpriseSeats.basePrice + (vipEnterpriseSeats - item.enterpriseSeats.min) * item.enterpriseSeats.pricePerSeat) * 12 * item.enterpriseSeats.annualDiscount}}</text>
                  <text class="vip-price-unit">/年</text>
                  <view class="vip-annual-badge"><text class="vip-annual-badge-text">8.8折</text></view>
                </view>
                <text class="vip-price-hint" wx:if="{{vipEnterpriseSeats > item.enterpriseSeats.annualOnlyAbove}}">超过10人仅提供年费</text>
                <text class="vip-per-seat-hint" wx:else>每增加1席位 +8元/月</text>
              </block>
              <block wx:else>
                <!-- 个人版固定价格 -->
                <view class="vip-price-row">
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{item.price}}</text>
                  <text class="vip-price-unit">{{item.unit}}</text>
                </view>
              </block>
            </view>
          </view>
        </scroll-view>
        <!-- 体验版暂不显示订阅确认按钮 -->
        <view class="vip-confirm-wrap" wx:if="{{false}}">
          <view class="vip-confirm-btn" bindtap="onVipConfirm"><text class="vip-confirm-text">确认订阅</text></view>
        </view>
      </view>
      <!-- 自定义分类页 -->
      <view class="card grid-span-3 my-card custom-cat-card" wx:elif="{{showCustomCategory}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onCustomCategoryBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/fenlei.png" mode="aspectFit"/><text class="custom-cat-title">{{t.custom_cat_title}}</text></view>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="custom-cat-personal-block">
          <view class="custom-cat-section-hd">
            <text class="custom-cat-section-label">个人分类</text>
            <view class="custom-cat-tabs">
              <view class="custom-cat-tab {{catTabPersonal === 'out' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="out">支出</view>
              <view class="custom-cat-tab {{catTabPersonal === 'in' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="in">收入</view>
              <view class="custom-cat-tab {{catTabPersonal === 'payForward' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="payForward">垫付</view>
              <view class="custom-cat-tab {{catTabPersonal === 'payable' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="payable">应付</view>
            </view>
          </view>
          <view class="custom-cat-scroll-wrap">
            <scroll-view class="custom-cat-grid-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-flex>
              <view class="custom-cat-grid">
                <view class="custom-cat-item" wx:for="{{personalCategories}}" wx:key="id" wx:if="{{item.inOut === catTabPersonal}}" bindlongtap="onDeleteCategory" data-id="{{item.id}}" data-scope="personal">
                  <view class="custom-cat-icon-wrap">
                    <text class="custom-cat-emoji">{{item.emoji}}</text>
                  </view>
                  <text class="custom-cat-name">{{item.name}}</text>
                </view>
              </view>
              <view class="custom-cat-add" bindtap="onAddCategory" data-scope="personal">
                <view class="custom-cat-add-icon">+</view>
              </view>
            </scroll-view>
          </view>
        </view>
        <view class="custom-cat-divider" wx:if="{{canSeeCompanyLedger}}"></view>
        <view class="custom-cat-company-block" wx:if="{{canSeeCompanyLedger}}">
          <view class="custom-cat-section-hd">
            <text class="custom-cat-section-label">公司分类</text>
            <view class="custom-cat-tabs">
              <view class="custom-cat-tab {{catTabCompany === 'out' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="out">支出</view>
              <view class="custom-cat-tab {{catTabCompany === 'in' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="in">收入</view>
              <view class="custom-cat-tab {{catTabCompany === 'payForward' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="payForward">垫付</view>
              <view class="custom-cat-tab {{catTabCompany === 'payable' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="payable">应付</view>
            </view>
          </view>
          <view class="custom-cat-scroll-wrap">
            <scroll-view class="custom-cat-grid-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-flex>
              <view class="custom-cat-grid">
                <view class="custom-cat-item" wx:for="{{companyCategories}}" wx:key="id" wx:if="{{item.inOut === catTabCompany}}" bindlongtap="onDeleteCategory" data-id="{{item.id}}" data-scope="company">
                  <view class="custom-cat-icon-wrap">
                    <text class="custom-cat-emoji">{{item.emoji}}</text>
                  </view>
                  <text class="custom-cat-name">{{item.name}}</text>
                </view>
              </view>
              <view class="custom-cat-add" bindtap="onAddCategory" data-scope="company">
                <view class="custom-cat-add-icon">+</view>
              </view>
            </scroll-view>
          </view>
        </view>
        <!-- 添加分类弹窗 -->
        <view class="cat-modal-mask" wx:if="{{showCatModal}}" bindtap="onCatModalClose"></view>
        <view class="cat-modal" wx:if="{{showCatModal}}">
          <view class="cat-modal-hd">
            <text class="cat-modal-title">添加分类</text>
            <view class="cat-modal-close" bindtap="onCatModalClose">✕</view>
          </view>
          <view class="cat-modal-body">
            <view class="cat-modal-field">
              <text class="cat-modal-label">名称</text>
              <input class="cat-modal-input" value="{{catModalName}}" bindinput="onCatModalNameInput" placeholder="输入分类名称" maxlength="10"/>
            </view>
            <view class="cat-modal-field">
              <text class="cat-modal-label">图标</text>
              <view class="cat-modal-emoji-grid">
                <view class="cat-modal-emoji-item {{catModalEmoji === item ? 'cat-modal-emoji--on' : ''}}" wx:for="{{catEmojiList}}" wx:key="*this" wx:for-item="item" bindtap="onCatModalPickEmoji" data-emoji="{{item}}">{{item}}</view>
              </view>
            </view>
          </view>
          <view class="cat-modal-ft">
            <view class="cat-modal-btn cat-modal-btn--cancel" bindtap="onCatModalClose">取消</view>
            <view class="cat-modal-btn cat-modal-btn--confirm" bindtap="onCatModalConfirm">确认</view>
          </view>
        </view>
      </view>
      <!-- 登录/注册页 -->
      <view class="card grid-span-3 my-card login-card" wx:elif="{{showLoginPage}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onLoginBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <text class="custom-cat-title">{{t.my_login_text}}</text>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="login-body">
          <view class="login-spacer"></view>
          <view class="login-form-wrap">
            <button class="login-wx-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetRealtimePhoneNumber" bindtap="_devLoginFallback">
              <view class="login-wx-icon">
                <view class="login-wx-icon-inner"></view>
              </view>
              <text class="login-wx-text">微信一键登录</text>
            </button>
          </view>
          <view class="login-spacer"></view>
          <view class="login-agreement">
            <text>登录即代表同意《用户协议》和《隐私政策》</text>
          </view>
        </view>
      </view>
      <!-- 链接公司共享同一账本 -->
      <view class="card grid-span-3 my-card company-share-card" wx:elif="{{showCompanyShare}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onCompanyShareBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/lianjiegongsigongxiangtongyizhangben.png" mode="aspectFit"/><text class="custom-cat-title">{{t.my_link_company}}</text></view>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="company-share-body" wx:if="{{companyShareStep === 0}}">
          <view class="company-share-btn" bindtap="onBossTap">我是老板</view>
          <view class="company-share-btn" bindtap="onEmployeeTap">我是员工</view>
        </view>
        <!-- 老板：创建公司表单 -->
        <view class="company-boss-body" wx:elif="{{companyShareStep === 1 && companyRole === 'boss'}}">
          <view class="company-boss-form">
            <text class="company-boss-tip">检测到还未创建公司，填写后创建</text>
            <view class="company-boss-field">
              <text class="company-boss-label">公司名称</text>
              <view class="company-boss-input-wrap">
                <input class="company-boss-input" value="{{companyName}}" placeholder="请输入公司名称" bindinput="onCompanyNameInput"/>
              </view>
            </view>
            <view class="company-boss-field">
              <text class="company-boss-label">BOSS 称呼</text>
              <view class="company-boss-input-wrap">
                <input class="company-boss-input" value="{{companyBossTitle}}" placeholder="BOSS" bindinput="onCompanyBossTitleInput"/>
              </view>
            </view>
            <view class="company-boss-field">
              <text class="company-boss-label">UID 码</text>
              <view class="company-boss-input-wrap">
                <input class="company-boss-input" value="{{companyUid}}" placeholder="点击下方按钮生成" disabled/>
              </view>
            </view>
            <text class="company-boss-note">注：企业版 UID 才可共享</text>
            <view class="company-boss-uid-btn" bindtap="onCreateUid">创建专属 UID</view>
          </view>
          <view class="company-boss-submit" bindtap="onCompanyCreate">确认创建</view>
        </view>
        <!-- 员工：加入公司表单 -->
        <view class="company-boss-body" wx:elif="{{companyShareStep === 1 && companyRole === 'employee'}}">
          <view class="company-boss-form">
            <text class="company-boss-tip">检测到还未加入公司，填写 UID 后加入</text>
            <view class="company-boss-field">
              <text class="company-boss-label">UID 码</text>
              <view class="company-boss-input-wrap">
                <input class="company-boss-input" value="{{employeeUid}}" placeholder="请输入公司 UID 码" bindinput="onEmployeeUidInput"/>
              </view>
            </view>
            <view class="company-employee-note">
              <text class="company-employee-note-text">加入企业后，获得个人版全部功能，</text>
              <text class="company-employee-note-strong">无需再次开通</text>
              <text class="company-employee-note-text">。</text>
            </view>
            <view class="company-employee-note">
              <text class="company-employee-note-text">个人垫付款、采购款等垫资款将</text>
              <text class="company-employee-note-strong">直接同步</text>
              <text class="company-employee-note-text">到公司账本。</text>
            </view>
            <view class="company-employee-note">
              <text class="company-employee-note-text">个人记录依旧保存在</text>
              <text class="company-employee-note-strong">本地</text>
              <text class="company-employee-note-text">，不会上传至公司。</text>
            </view>
          </view>
          <view class="company-boss-submit" bindtap="onEmployeeJoin">一键加入公司</view>
        </view>
        <!-- 老板：创建成功 -->
        <view class="company-boss-body" wx:elif="{{companyShareStep === 2 && companyRole === 'boss'}}">
          <view class="company-boss-form">
            <text class="company-boss-tip company-boss-success-tip">公司创建成功</text>
            <view class="company-success-card">
              <view class="company-success-row">
                <text class="company-success-key">UID 码</text>
                <text class="company-success-val">{{companyUid}}</text>
              </view>
              <text class="company-boss-note company-success-note">注：企业版 UID 才可共享</text>
              <view class="company-success-row">
                <text class="company-success-key">公司名称</text>
                <text class="company-success-val">{{companyName}}</text>
              </view>
              <view class="company-success-row">
                <text class="company-success-key">BOSS 称呼</text>
                <text class="company-success-val">{{companyBossTitle || 'BOSS'}}</text>
              </view>
            </view>
            <view class="company-share-action-btn" bindtap="onShareCompany">一键分享</view>
          </view>
        </view>
        <!-- 员工：加入成功 -->
        <view class="company-boss-body" wx:elif="{{companyShareStep === 2 && companyRole === 'employee'}}">
          <view class="company-boss-form company-employee-success-form">
            <text class="company-employee-success-role">员工</text>
            <view class="company-employee-success-spacer"></view>
            <text class="company-employee-success-title">已链接公司</text>
            <view class="company-employee-success-spacer"></view>
            <view class="company-employee-success-notes"><text class="company-employee-success-note-text">注：企业版员工个人记录依旧保存在</text><text class="company-employee-success-note-strong">本地</text><text class="company-employee-success-note-text">，不会上传至公司。个人垫付款，采购款等垫资款将</text><text class="company-employee-success-note-strong">直接同步</text><text class="company-employee-success-note-text">到公司账本。（非实时更新）加入企业后，获得个人版全部功能，</text><text class="company-employee-success-note-strong">无需再次开通</text><text class="company-employee-success-note-text">。公司端结清账单后，你需要确认资金是否到位，再点击</text><text class="company-employee-success-note-strong">确认结清</text><text class="company-employee-success-note-text">，一旦结清，公司则会认为你已经到账，为了避免后续纠纷，请一定要</text><text class="company-employee-success-note-strong">确认清楚</text><text class="company-employee-success-note-text">再点击结清。</text></view>
          </view>
        </view>
      </view>
      <!-- 导出账单 -->
      <view class="card grid-span-3 my-card export-bill-card" wx:elif="{{showExportBill}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onExportBillBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/daochu.png" mode="aspectFit"/><text class="custom-cat-title">{{t.export_title}}</text></view>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="report-period-bar">
          <view class="report-period-item {{exportPeriod === 0 ? 'report-period-item--active' : ''}}" bindtap="onExportPeriodTap" data-period="{{0}}">
            <text class="report-period-text {{exportPeriod === 0 ? 'report-period-text--active' : ''}}">月度</text>
          </view>
          <view class="report-period-item {{exportPeriod === 1 ? 'report-period-item--active' : ''}}" bindtap="onExportPeriodTap" data-period="{{1}}">
            <text class="report-period-text {{exportPeriod === 1 ? 'report-period-text--active' : ''}}">季度</text>
          </view>
          <view class="report-period-item {{exportPeriod === 2 ? 'report-period-item--active' : ''}}" bindtap="onExportPeriodTap" data-period="{{2}}">
            <text class="report-period-text {{exportPeriod === 2 ? 'report-period-text--active' : ''}}">年度</text>
          </view>
          <view class="report-period-item {{exportPeriod === 3 ? 'report-period-item--active' : ''}}" bindtap="onExportPeriodTap" data-period="{{3}}">
            <text class="report-period-text {{exportPeriod === 3 ? 'report-period-text--active' : ''}}">日度</text>
          </view>
        </view>
        <view class="export-book-body">
          <!-- 时间范围 + 导出格式 -->
          <view class="export-bill-top">
            <view class="export-bill-range">
              <text class="export-bill-range-label">时间</text>
              <picker wx:if="{{exportPeriod === 0}}" mode="date" fields="month" value="{{exportPickerDate}}" end="{{maxDate}}" bindchange="onExportPickerChange">
                <view class="detail-date-box">
                  <text class="report-date-text">{{exportDateText}}</text>
                  <view class="report-date-arrow"></view>
                </view>
              </picker>
              <picker wx:elif="{{exportPeriod === 1}}" mode="multiSelector" range="{{reportQuarterRange}}" value="{{exportQuarterMultiIndex}}" bindchange="onExportQuarterChange" bindcolumnchange="onExportQuarterColumnChange">
                <view class="detail-date-box">
                  <text class="report-date-text">{{exportDateText}}</text>
                  <view class="report-date-arrow"></view>
                </view>
              </picker>
              <picker wx:elif="{{exportPeriod === 2}}" mode="date" fields="year" value="{{exportPickerDate}}" end="{{maxDate}}" bindchange="onExportPickerChange">
                <view class="detail-date-box">
                  <text class="report-date-text">{{exportDateText}}</text>
                  <view class="report-date-arrow"></view>
                </view>
              </picker>
              <picker wx:elif="{{exportPeriod === 3}}" mode="date" value="{{exportPickerDate}}" end="{{maxDate}}" bindchange="onExportPickerChange">
                <view class="detail-date-box">
                  <text class="report-date-text">{{exportDateText}}</text>
                  <view class="report-date-arrow"></view>
                </view>
              </picker>
            </view>
            <view class="export-bill-format">
              <text class="export-bill-format-label">导出格式</text>
              <picker mode="selector" range="{{exportFormatOptions}}" value="{{exportFormatIndex}}" bindchange="onExportFormatChange">
                <view class="detail-date-box">
                  <text class="report-date-text">{{exportFormatOptions[exportFormatIndex]}}</text>
                  <view class="report-date-arrow"></view>
                </view>
              </picker>
            </view>
          </view>
          <text class="export-book-lead">选择要导出的账本</text>
          <view class="export-book-picker">
            <view class="export-book-card export-book-card--personal" hover-class="export-book-card--press" hover-stay-time="60" bindtap="onExportPersonal">
              <view class="export-book-badge"><image class="export-book-icon" src="/assets/icons/gerenzhangben.png" mode="aspectFit"/></view>
              <view class="export-book-info">
                <text class="export-book-title">个人账本</text>
                <text class="export-book-desc">导出你的个人收支明细</text>
              </view>
              <view class="export-book-arrow"></view>
