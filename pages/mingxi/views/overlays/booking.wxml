  <!-- 底部 TabBar -->
  <!-- 语音录入指示器 -->
  <view class="chat-voice-indicator {{chatRecording || searchRecording ? 'chat-voice-indicator--show' : ''}}">
    <view class="chat-voice-wave">
      <view class="chat-voice-bar"></view>
      <view class="chat-voice-bar"></view>
      <view class="chat-voice-bar"></view>
      <view class="chat-voice-bar"></view>
      <view class="chat-voice-bar"></view>
    </view>
    <text class="chat-voice-tip">正在聆听…</text>
  </view>

  <view class="tab-bar-wrapper">
    <view class="tab-bar-center-btn" data-index="{{2}}" bindtouchstart="onTabCenterTouchStart" bindtouchend="onTabCenterTouchEnd" bindtouchcancel="onTabCenterTouchEnd">
      <image class="tab-icon-center-img" src="{{tabs[2].icon}}" mode="aspectFit"/>
    </view>
    <text class="tab-center-label">{{tabs[2].text}}</text>
    <view class="tab-bar">
      <view class="tab-item {{index === 1 ? 'tab-item--push-left' : ''}} {{index === 3 ? 'tab-item--push-right' : ''}} {{index === 4 ? 'tab-item-mine' : ''}}" wx:for="{{tabs}}" wx:key="index" data-index="{{index}}" bindtap="switchTab">
        <view wx:if="{{index !== 2}}" class="tab-icon"><image class="tab-icon-img" src="{{item.icon}}" mode="aspectFit"/><view class="tab-badge" wx:if="{{index === 4 && hasMyTabBadge}}"></view></view>
        <text wx:if="{{index !== 2}}" class="tab-label {{index === currentTab && !showOverview ? 'tab-label-active' : ''}}">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="book-mask" wx:if="{{showBookPopup}}" bindtap="onBookClose">
    <view class="book-sheet {{bookPhoto ? 'book-sheet--with-photo' : ''}} {{bookMode === 'multi' ? 'book-sheet--multi' : ''}}" catchtap="nop">
      <!-- 模式切换 Tab -->
      <view class="book-mode-tabs">
        <view class="book-mode-tab {{bookMode === 'normal' ? 'book-mode-tab--active' : ''}}" bindtap="onBookModeSwitch" data-mode="normal"><text>普通记账</text></view>
        <view class="book-mode-tab book-mode-tab--multi {{bookMode === 'multi' ? 'book-mode-tab--active' : ''}}" bindtap="onBookModeSwitch" data-mode="multi"><text>多笔记账</text></view>
      </view>

      <!-- ========== 普通记账 ========== -->
      <view class="book-mode-body {{bookMode !== 'normal' ? 'book-mode-body--hidden' : ''}}">
        <view class="book-photo-row" wx:if="{{bookPhoto}}">
          <image class="book-photo-thumb" src="{{bookPhoto}}" mode="aspectFill" bindtap="onBookPhotoPreview"></image>
          <view class="book-photo-meta">
            <text class="book-photo-tag">凭证已识别</text>
            <text class="book-photo-hint">请核对金额与分类</text>
          </view>
          <view class="book-photo-remove" catchtap="onBookPhotoRemove"><text>✕</text></view>
        </view>
        <view class="book-date-row">
          <picker mode="date" value="{{bookForm.date}}" end="{{maxDate}}" bindchange="onBookDateChange">
            <view class="book-date-picker">
              <text class="book-date-label">日期</text>
              <text class="book-date-value">{{bookForm.date}}</text>
            </view>
          </picker>
        </view>
        <view class="book-amount-row">
          <view class="book-amount-left">
            <text class="book-yen">¥</text>
            <text class="book-amount-value">{{bookForm.amount || '0.00'}}</text>
          </view>
          <input class="book-note-input" placeholder="添加备注" value="{{bookForm.note}}" bindinput="onBookNoteInput" maxlength="50"/>
        </view>
        <view class="book-cat-select">
          <view class="book-cat-tags" bindtap="onBookOpenCatPanel">
            <text class="book-cat-select-label">{{bookScopeLabel}}</text>
            <text class="book-cat-select-sep">·</text>
            <text class="book-cat-select-label">{{bookTypeLabel}}</text>
            <block wx:if="{{bookForm.type === 'payForward' || bookForm.type === 'payable' || bookForm.target}}">
              <text class="book-cat-select-sep">→</text>
              <text class="book-target-tag" catchtap="onBookTargetTap">{{bookForm.target || '选择对象'}}</text>
            </block>
            <text class="book-cat-select-sep">·</text>
            <text class="book-cat-select-val">{{bookForm.category || '选择分类'}}</text>
          </view>
          <text class="book-cat-select-arrow" bindtap="onBookOpenCatPanel">›</text>
        </view>
        <view class="book-keypad">
          <view class="book-keypad-row">
            <view class="book-key" bindtap="onBookKey" data-key="1"><text>1</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="2"><text>2</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="3"><text>3</text></view>
          </view>
          <view class="book-keypad-row">
            <view class="book-key" bindtap="onBookKey" data-key="4"><text>4</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="5"><text>5</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="6"><text>6</text></view>
          </view>
          <view class="book-keypad-row">
            <view class="book-key" bindtap="onBookKey" data-key="7"><text>7</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="8"><text>8</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="9"><text>9</text></view>
          </view>
          <view class="book-keypad-row">
            <view class="book-key book-key--dot" bindtap="onBookKey" data-key="."><text>.</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="0"><text>0</text></view>
            <view class="book-key book-key--del" bindtap="onBookKey" data-key="del"><text>⌫</text></view>
          </view>
        </view>
        <view class="book-btn-row">
          <view class="book-btn-save" catchtap="onBookSave"><text>记一笔</text></view>
        </view>
      </view>

      <!-- ========== 多笔记账 ========== -->
      <view class="book-mode-body {{bookMode !== 'multi' ? 'book-mode-body--hidden' : ''}}">
        <view class="multi-meta-row">
          <view class="multi-scope-toggle">
            <view class="multi-scope-tab {{multiScope === 'personal' ? 'multi-scope-tab--active' : ''}}" bindtap="onMultiScopeToggle" data-scope="personal"><text>个人</text></view>
            <view class="multi-scope-tab {{multiScope === 'company' ? 'multi-scope-tab--active' : ''}}" bindtap="onMultiScopeToggle" data-scope="company"><text>公司</text></view>
          </view>
          <view class="multi-type-toggle">
            <view class="multi-type-tab {{multiType === 'income' ? 'multi-type-tab--active multi-type-tab--income' : ''}}" bindtap="onMultiTypeToggle" data-type="income"><text>收入</text></view>
            <view class="multi-type-tab {{multiType === 'expense' ? 'multi-type-tab--active multi-type-tab--expense' : ''}}" bindtap="onMultiTypeToggle" data-type="expense"><text>支出</text></view>
          </view>
        </view>
        <view class="multi-meta-row">
          <input class="multi-note-input" placeholder="添加备注" value="{{multiNote}}" bindinput="onMultiNoteInput" maxlength="50"/>
        </view>
        <view class="multi-date-row">
          <picker mode="date" value="{{multiStartDate}}" end="{{maxDate}}" bindchange="onMultiStartDateChange">
            <view class="multi-date-picker">
              <text class="multi-date-label">开始</text>
              <text class="multi-date-value">{{multiStartDate}}</text>
            </view>
          </picker>
          <text class="multi-date-sep">~</text>
          <picker mode="date" value="{{multiEndDate}}" end="{{maxDate}}" bindchange="onMultiEndDateChange">
            <view class="multi-date-picker">
              <text class="multi-date-label">结束</text>
              <text class="multi-date-value">{{multiEndDate}}</text>
            </view>
          </picker>
        </view>
        <view class="multi-calc-display">
          <text class="multi-calc-expression">{{multiExpression || '0'}}</text>
          <view class="multi-calc-info">
            <text class="multi-calc-count">{{multiCount}} 笔</text>
            <text class="multi-calc-result">= {{multiResult}}</text>
          </view>
        </view>
        <view class="book-keypad book-keypad--multi">
          <view class="book-keypad-main">
            <view class="book-keypad-nums">
              <view class="book-keypad-row">
                <view class="book-key" bindtap="onBookKey" data-key="7"><text>7</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="8"><text>8</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="9"><text>9</text></view>
              </view>
              <view class="book-keypad-row">
                <view class="book-key" bindtap="onBookKey" data-key="4"><text>4</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="5"><text>5</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="6"><text>6</text></view>
              </view>
              <view class="book-keypad-row">
                <view class="book-key" bindtap="onBookKey" data-key="1"><text>1</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="2"><text>2</text></view>
                <view class="book-key" bindtap="onBookKey" data-key="3"><text>3</text></view>
              </view>
            </view>
            <view class="book-keypad-ops">
              <view class="book-key book-key--op book-key--op-tall" bindtap="onBookKey" data-key="+"><text>+</text></view>
              <view class="book-key book-key--op book-key--op-tall" bindtap="onBookKey" data-key="-"><text>−</text></view>
            </view>
          </view>
          <view class="book-keypad-row">
            <view class="book-key book-key--clear" bindtap="onBookKey" data-key="C"><text>C</text></view>
            <view class="book-key" bindtap="onBookKey" data-key="0"><text>0</text></view>
            <view class="book-key book-key--dot" bindtap="onBookKey" data-key="."><text>.</text></view>
            <view class="book-key book-key--del" bindtap="onBookKey" data-key="del"><text>⌫</text></view>
          </view>
        </view>
        <view class="book-btn-row">
          <view class="book-btn-save" catchtap="onMultiSave"><text>记 {{multiCount || 0}} 笔</text></view>
        </view>
      </view>
    </view>
    <view class="book-cat-panel" wx:if="{{showBookCatPanel}}" catchtap="nop">
      <view class="book-cat-panel-scope">
        <view class="book-scope-tab {{bookScope === 'personal' ? 'book-scope-tab--active' : ''}}" bindtap="onBookScopeToggle" data-scope="personal"><text>个人</text></view>
        <view class="book-scope-tab {{bookScope === 'company' ? 'book-scope-tab--active' : ''}}" bindtap="onBookScopeToggle" data-scope="company"><text>公司</text></view>
      </view>
      <view class="book-type-bar">
        <view class="book-type-tab book-type-tab--income {{bookForm.type === 'income' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="income"><text>收入</text></view>
        <view class="book-type-tab book-type-tab--expense {{bookForm.type === 'expense' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="expense"><text>支出</text></view>
        <view class="book-type-tab book-type-tab--payForward {{bookForm.type === 'payForward' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="payForward"><text>垫付</text></view>
        <view class="book-type-tab book-type-tab--payable {{bookForm.type === 'payable' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="payable"><text>应付</text></view>
      </view>
      <scroll-view class="book-cat-panel-grid" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="book-cat-panel-icons">
          <view class="book-cat-panel-item" wx:for="{{bookCatPanelData}}" wx:key="id" bindtap="onBookCatPanelSelect" data-cat="{{item.name}}">
            <view class="book-cat-panel-emoji"><text>{{item.emoji}}</text></view>
            <text class="book-cat-panel-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
