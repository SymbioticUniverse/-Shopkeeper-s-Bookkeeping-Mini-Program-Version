  <!-- 首次引导弹窗（旧） -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <!-- Step 0: 欢迎 -->
    <view class="guide-card guide-card--welcome" wx:if="{{guideStep === 0}}">
      <!-- 深色模式切换 -->
      <view class="guide-theme-toggle" catchtap="onToggleDarkMode">
        <text class="guide-theme-icon">{{isDarkMode ? '🌙' : '☀️'}}</text>
      </view>
      <view class="guide-logo">
        <image class="guide-logo-img" src="/assets/zhangguihuizhang.png" mode="aspectFit"/>
      </view>
      <text class="guide-app-name">掌柜记账</text>
      <text class="guide-slogan">公私分明的智能记账本</text>
      <view class="guide-features">
        <view class="guide-feature-card">
          <view class="guide-feature-icon-wrap guide-feature-icon-wrap--boss">
            <text class="guide-feature-emoji">👤</text>
          </view>
          <view class="guide-feature-body">
            <text class="guide-feature-text"><text class="guide-feature-bold">老板</text>：创建公司，邀请员工，审核结清</text>
          </view>
        </view>
        <view class="guide-feature-card">
          <view class="guide-feature-icon-wrap guide-feature-icon-wrap--emp">
            <text class="guide-feature-emoji">🙋</text>
          </view>
          <view class="guide-feature-body">
            <text class="guide-feature-text"><text class="guide-feature-bold">员工</text>：加入公司，垫付记账，自动结算</text>
          </view>
        </view>
        <view class="guide-feature-card">
          <view class="guide-feature-icon-wrap guide-feature-icon-wrap--multi">
            <text class="guide-feature-emoji">📝</text>
          </view>
          <view class="guide-feature-body">
            <text class="guide-feature-text"><text class="guide-feature-bold">多笔记账</text>：一笔完成累积账单，记账更高效</text>
          </view>
        </view>
        <view class="guide-feature-card">
          <view class="guide-feature-icon-wrap guide-feature-icon-wrap--voice">
            <text class="guide-feature-emoji">🎙</text>
          </view>
          <view class="guide-feature-body">
            <text class="guide-feature-text"><text class="guide-feature-bold">文本语音记账</text>：说话或打字都能记账，开口即所得</text>
            <text class="guide-feature-sub">语音转文字后智能解析，语音不准也能手动改</text>
          </view>
        </view>
        <view class="guide-feature-card">
          <view class="guide-feature-icon-wrap guide-feature-icon-wrap--ocr">
            <text class="guide-feature-emoji">📷</text>
          </view>
          <view class="guide-feature-body">
            <text class="guide-feature-text"><text class="guide-feature-bold">凭证识别</text>：拍照识别，垫付/应付款自动计算</text>
          </view>
        </view>
      </view>
      <view class="guide-btn" bindtap="onGuideNext">开始使用</view>
      <view class="guide-dots">
        <view class="guide-dot guide-dot--active"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
      </view>
    </view>

    <!-- Step 1: 登录 -->
    <view class="guide-card" wx:elif="{{guideStep === 1}}">
      <text class="guide-card-title">登录 / 注册</text>
      <text class="guide-card-desc">微信一键登录，数据云端同步</text>
      <!-- 微信一键登录（手机号实时验证） -->
      <button class="guide-wx-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetRealtimePhoneNumber" bindtap="_devLoginFallback">
        <view class="guide-wx-icon-wrap">
          <text class="guide-wx-icon-emoji">💬</text>
        </view>
        <text>微信一键登录</text>
      </button>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
        <view class="guide-dot"></view>
      </view>
    </view>

    <!-- Step 2: 身份选择 -->
    <view class="guide-card" wx:elif="{{guideStep === 2}}">
      <text class="guide-card-title">选择身份</text>
      <text class="guide-card-desc">可以稍后在「我的 → 链接公司」中设置</text>
      <view class="guide-role-btn" bindtap="onGuideRole" data-role="boss">
        <view class="guide-role-icon guide-role-icon--boss">B</view>
        <view class="guide-role-info">
          <text class="guide-role-label">我是老板</text>
          <text class="guide-role-hint">创建公司，邀请员工</text>
        </view>
        <text class="guide-role-arrow">></text>
      </view>
      <view class="guide-role-btn" bindtap="onGuideRole" data-role="employee">
        <view class="guide-role-icon guide-role-icon--emp">E</view>
        <view class="guide-role-info">
          <text class="guide-role-label">我是员工</text>
          <text class="guide-role-hint">输入 UID 加入公司</text>
        </view>
        <text class="guide-role-arrow">></text>
      </view>
      <text class="guide-skip" bindtap="onGuideComplete">稍后再说</text>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
      </view>
    </view>

    <!-- Step 3: 公司表单 -->
    <view class="guide-card" wx:elif="{{guideStep === 3}}">
      <block wx:if="{{guideRole === 'boss'}}">
        <text class="guide-card-title">创建公司</text>
        <view class="guide-form">
          <view class="guide-input-row">
            <input class="guide-input" placeholder="公司名称" value="{{companyName}}"
                   bindinput="onCompanyNameInput"/>
          </view>
          <view class="guide-input-row">
            <input class="guide-input" placeholder="老板称谓（选填，默认 BOSS）" value="{{companyBossTitle}}"
                   bindinput="onCompanyBossTitleInput"/>
          </view>
          <view class="guide-uid-row">
            <text class="guide-uid-label">公司 UID</text>
            <text class="guide-uid-value">{{companyUid || '—'}}</text>
            <view class="guide-uid-gen" bindtap="onCreateUid">生成</view>
          </view>
        </view>
        <view class="guide-btn" bindtap="onGuideCompanyCreate">确认创建</view>
      </block>
      <block wx:elif="{{guideRole === 'employee'}}">
        <text class="guide-card-title">加入公司</text>
        <text class="guide-card-desc">输入老板提供的公司 UID</text>
        <view class="guide-form">
          <view class="guide-input-row">
            <input class="guide-input" placeholder="公司 UID" value="{{employeeUid}}"
                   bindinput="onEmployeeUidInput"/>
          </view>
        </view>
        <view class="guide-btn" bindtap="onGuideEmployeeJoin">申请加入</view>
      </block>
      <text class="guide-back" bindtap="onGuideBack">← 返回</text>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
      </view>
    </view>
  </view>

  <!-- 聚光引导（功能教程） -->
  <spotlight-guide
    visible="{{showSpotlightGuide}}"
    stepConfig="{{spotlightStepConfig}}"
    targetRect="{{spotlightTargetRect}}"
    totalSteps="{{spotlightTotalSteps}}"
    currentStep="{{spotlightStep}}"
    bind:next="onSpotlightNext"
    bind:skip="onSpotlightSkip"
    bind:welcomenext="onSpotlightWelcomeNext"
    bind:intronext="onSpotlightIntroNext"
  />

  <!-- 语音记账操作提示（引导完成后弹出） -->
  <view class="voice-tip-overlay" wx:if="{{showVoiceTip}}" catchtap="onVoiceTipDismiss">
    <view class="voice-tip-card" catchtap="nop">
      <view class="voice-tip-icon-wrap">
        <text class="voice-tip-emoji">🎤</text>
      </view>
      <text class="voice-tip-title">试试语音记账</text>
      <text class="voice-tip-desc">长按底部 ⊕ 按钮，说出「金额 + 分类 + 类型」就能自动记账</text>
      <view class="voice-tip-demo">
        <text class="voice-tip-demo-text">「办公用品 200 元 垫付」</text>
      </view>
      <view class="voice-tip-btn" bindtap="onVoiceTipDismiss">知道了</view>
    </view>
  </view>
