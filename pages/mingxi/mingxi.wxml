  <!-- 自定义简览页 · 拖拽弹窗 -->
  <view class="popup-mask" wx:if="{{showPopup}}" catchtouchstart="onPopupDragStart" catchtouchmove="onPopupDragMove" catchtouchend="onPopupDragEnd">
    <view class="popup-card" catchtap="nop">
      <view class="popup-card-header">
        <text class="popup-card-title">拖入卡槽</text>
        <text class="popup-card-drag-hint">拖拽下方卡片到目标槽位</text>
      </view>
      <view class="popup-slots">
        <view class="popup-slot popup-slot--span{{item.span}} {{ghostDrag.slotHover === index ? 'popup-slot--hover' : ''}} {{item.isEmpty ? 'popup-slot--empty' : ''}}" wx:for="{{visibleSlots}}" wx:key="col" wx:for-item="item" data-col="{{item.col}}" data-span="{{item.span}}">
          <block wx:if="{{!item.isEmpty}}">
            <text class="popup-slot-name">{{item.card.name}}</text>
            <text class="popup-slot-meta">占{{item.span}}格 · 将被替换</text>
          </block>
          <block wx:else>
            <text class="popup-slot-empty-text">空槽位 · 占{{item.span}}格</text>
          </block>
        </view>
      </view>
    </view>
    <view wx:if="{{ghostDrag.visible}}" class="ghost-card" style="left: {{ghostDrag.x}}px; top: {{ghostDrag.y}}px;">
      <text class="ghost-card-title">{{ghostDrag.name}}</text>
      <text class="ghost-card-hint">拖到槽位松手</text>
    </view>
  </view>

  <!-- 自定义相机扫描页 -->
  <view class="camera-page" wx:if="{{showCamera}}">
    <camera class="camera-view" device-position="back" flash="off" binderror="onCameraError"></camera>
    <view class="camera-back" bindtap="onCameraClose">
      <view class="camera-back-arrow"></view>
    </view>
    <view class="camera-scan-frame"></view>
    <text class="camera-hint">将凭证放入框内拍摄</text>
    <view class="camera-bar">
      <view class="camera-album" bindtap="onCameraAlbum">
        <view class="camera-album-icon"></view>
      </view>
      <view class="camera-shutter" bindtap="onCameraShoot">
        <view class="camera-shutter-ring"></view>
      </view>
      <view class="camera-bar-spacer"></view>
    </view>
  </view>

  <!-- 凭证识别中 -->
  <view class="scan-recog-mask" wx:if="{{scanRecognizing}}">
    <view class="scan-recog-card">
      <view class="scan-recog-frame">
        <image class="scan-recog-photo" src="{{bookPhoto}}" mode="aspectFill"></image>
        <view class="scan-recog-line"></view>
      </view>
      <text class="scan-recog-text">正在识别凭证…</text>
    </view>
  </view>

  <!-- 账单详情弹窗 -->
  <view class="bill-modal-mask" wx:if="{{modalItem}}" catchtap="onModalClose">
    <view class="bill-modal" catchtap="nop">
      <text class="bill-modal-title">{{modalItem.category}}</text>
      <view wx:if="{{modalItem._autoSettle}}" class="bill-modal-auto-tag">系统自动生成</view>
      <view class="bill-modal-divider"></view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">类型</text>
        <text class="bill-modal-value {{modalItem.type === 'in' ? 'bill-modal-value--in' : 'bill-modal-value--out'}}">{{modalItem.typeLabel}}</text>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">分类</text>
        <text wx:if="{{modalItem._readonly}}" class="bill-modal-value">{{modalEdit.category}}</text>
        <input wx:else class="bill-modal-input" value="{{modalEdit.category}}" bindinput="onModalFieldEdit" data-field="category"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">金额</text>
        <text wx:if="{{modalItem._readonly}}" class="bill-modal-value">¥{{modalEdit.amount}}</text>
        <input wx:else class="bill-modal-input" value="{{modalEdit.amount}}" bindinput="onModalFieldEdit" data-field="amount" type="digit"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">备注</text>
        <text wx:if="{{modalItem._readonly}}" class="bill-modal-value">{{modalEdit.note || '-'}}</text>
        <input wx:else class="bill-modal-input" value="{{modalEdit.note}}" bindinput="onModalFieldEdit" data-field="note"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">时间</text>
        <text class="bill-modal-value">{{modalItem._timeText || modalItem.date}}</text>
      </view>
      <view wx:if="{{modalItem.voucher}}" class="bill-modal-row">
        <text class="bill-modal-label">凭证</text>
        <image class="bill-modal-voucher" src="{{modalItem.voucher}}" mode="aspectFill" catchtap="onVoucherPreview" data-src="{{modalItem.voucher}}"></image>
      </view>
      <view wx:if="{{modalItem.settleInfo}}" class="bill-modal-row">
        <text class="bill-modal-label">结清</text>
        <text class="bill-modal-settle-info">{{modalItem._settleText || modalItem.settleInfo}}</text>
      </view>
      <view class="bill-modal-divider"></view>
      <view class="bill-modal-btns">
        <view wx:if="{{!modalItem._readonly}}" class="bill-modal-btn bill-modal-save" bindtap="onModalSave">保存</view>
        <view wx:if="{{modalItem.typeLabel === '应付' && modalItem.settleStatus !== 'settled'}}" class="bill-modal-btn bill-modal-settle" bindtap="onBillSettle" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">结清</view>
        <view wx:elif="{{modalItem.typeLabel === '垫付' && modalItem.settleStatus === 'company_settled'}}" class="bill-modal-btn bill-modal-settle" bindtap="onBillSettle" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">确认到账</view>
        <view wx:if="{{!modalItem._readonly && !modalItem._voided}}" class="bill-modal-btn bill-modal-void" bindtap="onBillVoid" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">作废</view>
        <view wx:elif="{{!modalItem._readonly && modalItem._voided}}" class="bill-modal-btn bill-modal-unvoid" bindtap="onBillUnvoid" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">恢复</view>
        <view wx:if="{{!modalItem._readonly && modalItem.typeLabel !== '垫付' && modalIsPersonal}}" class="bill-modal-btn bill-modal-delete" bindtap="onBillDelete" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 底部 TabBar -->
  <!-- 语音录入指示器 -->
  <view class="ai-voice-indicator {{aiRecording || searchRecording ? 'ai-voice-indicator--show' : ''}}">
    <view class="ai-voice-wave">
      <view class="ai-voice-bar"></view>
      <view class="ai-voice-bar"></view>
      <view class="ai-voice-bar"></view>
      <view class="ai-voice-bar"></view>
      <view class="ai-voice-bar"></view>
    </view>
    <text class="ai-voice-tip">正在聆听…</text>
  </view>

  <view class="tab-bar-wrapper">
    <view class="tab-bar-center-btn" data-index="{{2}}" bindtouchstart="onTabCenterTouchStart" bindtouchend="onTabCenterTouchEnd" bindtouchcancel="onTabCenterTouchEnd">
      <image class="tab-icon-center-img" src="{{tabs[2].icon}}" mode="aspectFit"/>
    </view>
    <text class="tab-center-label">{{tabs[2].text}}</text>
    <view class="tab-bar">
      <view class="tab-item {{index === 1 ? 'tab-item--push-left' : ''}} {{index === 3 ? 'tab-item--push-right' : ''}}" wx:for="{{tabs}}" wx:key="index" data-index="{{index}}" bindtap="switchTab">
        <view wx:if="{{index !== 2}}" class="tab-icon"><image class="tab-icon-img" src="{{item.icon}}" mode="aspectFit"/></view>
        <text wx:if="{{index !== 2}}" class="tab-label {{index === currentTab && !showOverview ? 'tab-label-active' : ''}}">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="book-mask" wx:if="{{showBookPopup}}" bindtap="onBookClose">
    <view class="book-sheet {{bookPhoto ? 'book-sheet--with-photo' : ''}}" catchtap="nop">
      <view class="book-photo-row" wx:if="{{bookPhoto}}">
        <image class="book-photo-thumb" src="{{bookPhoto}}" mode="aspectFill" bindtap="onBookPhotoPreview"></image>
        <view class="book-photo-meta">
          <text class="book-photo-tag">凭证已识别</text>
          <text class="book-photo-hint">请核对金额与分类</text>
        </view>
        <view class="book-photo-remove" catchtap="onBookPhotoRemove"><text>✕</text></view>
      </view>
      <view class="book-date-row">
        <picker mode="date" value="{{bookForm.date}}" end="{{maxDate}}" bindchange="onBookDateChange">
          <view class="book-date-picker">
            <text class="book-date-label">日期</text>
            <text class="book-date-value">{{bookForm.date}}</text>
          </view>
        </picker>
      </view>
      <view class="book-amount-row">
        <view class="book-amount-left">
          <text class="book-yen">¥</text>
          <text class="book-amount-value">{{bookForm.amount || '0.00'}}</text>
        </view>
        <input class="book-note-input" placeholder="添加备注" value="{{bookForm.note}}" bindinput="onBookNoteInput" maxlength="50"/>
      </view>
      <view class="book-cat-select">
        <view class="book-cat-tags" bindtap="onBookOpenCatPanel">
          <text class="book-cat-select-label">{{bookScopeLabel}}</text>
          <text class="book-cat-select-sep">·</text>
          <text class="book-cat-select-label">{{bookTypeLabel}}</text>
          <block wx:if="{{bookForm.type === 'payForward' || bookForm.type === 'payable' || bookForm.target}}">
            <text class="book-cat-select-sep">→</text>
            <text class="book-target-tag" catchtap="onBookTargetTap">{{bookForm.target || '选择对象'}}</text>
          </block>
          <text class="book-cat-select-sep">·</text>
          <text class="book-cat-select-val">{{bookForm.category || '选择分类'}}</text>
        </view>
        <text class="book-cat-select-arrow" bindtap="onBookOpenCatPanel">›</text>
      </view>
      <view class="book-keypad">
        <view class="book-keypad-row">
          <view class="book-key" bindtap="onBookKey" data-key="1"><text>1</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="2"><text>2</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="3"><text>3</text></view>
        </view>
        <view class="book-keypad-row">
          <view class="book-key" bindtap="onBookKey" data-key="4"><text>4</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="5"><text>5</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="6"><text>6</text></view>
        </view>
        <view class="book-keypad-row">
          <view class="book-key" bindtap="onBookKey" data-key="7"><text>7</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="8"><text>8</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="9"><text>9</text></view>
        </view>
        <view class="book-keypad-row">
          <view class="book-key book-key--dot" bindtap="onBookKey" data-key="."><text>.</text></view>
          <view class="book-key" bindtap="onBookKey" data-key="0"><text>0</text></view>
          <view class="book-key book-key--del" bindtap="onBookKey" data-key="del"><text>⌫</text></view>
        </view>
      </view>
      <view class="book-btn-row">
        <view class="book-btn-save" bindtap="onBookSave"><text>记一笔</text></view>
      </view>
    </view>
    <view class="book-cat-panel" wx:if="{{showBookCatPanel}}" catchtap="nop">
      <view class="book-cat-panel-scope">
        <view class="book-scope-tab {{bookScope === 'personal' ? 'book-scope-tab--active' : ''}}" bindtap="onBookScopeToggle" data-scope="personal"><text>个人</text></view>
        <view class="book-scope-tab {{bookScope === 'company' ? 'book-scope-tab--active' : ''}}" bindtap="onBookScopeToggle" data-scope="company"><text>公司</text></view>
      </view>
      <view class="book-type-bar">
        <view class="book-type-tab book-type-tab--income {{bookForm.type === 'income' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="income"><text>收入</text></view>
        <view class="book-type-tab book-type-tab--expense {{bookForm.type === 'expense' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="expense"><text>支出</text></view>
        <view class="book-type-tab book-type-tab--payForward {{bookForm.type === 'payForward' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="payForward"><text>垫付</text></view>
        <view class="book-type-tab book-type-tab--payable {{bookForm.type === 'payable' ? 'book-type-tab--active' : ''}}" bindtap="onBookTypeSelect" data-type="payable"><text>应付</text></view>
      </view>
      <scroll-view class="book-cat-panel-grid" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="book-cat-panel-icons">
          <view class="book-cat-panel-item" wx:for="{{bookCatPanelData}}" wx:key="id" bindtap="onBookCatPanelSelect" data-cat="{{item.name}}">
            <view class="book-cat-panel-emoji"><text>{{item.emoji}}</text></view>
            <text class="book-cat-panel-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- AI 对话窗口 -->
  <view class="ai-chat-overlay" wx:if="{{showAiChat}}" catchtap="onAiOverlayTap" bindtouchend="onAiOverlayTouchEnd" bindtouchcancel="onAiOverlayTouchEnd">
    <view class="ai-chat-card" catchtap="nop">
      <view class="ai-chat-header">
        <text class="ai-chat-title">AI 记账助手</text>
        <view class="ai-chat-close" bindtap="onAiChatClose">×</view>
      </view>
      <!-- 录音中指示器 -->
      <view class="ai-recording-banner" wx:if="{{aiRecording}}">
        <view class="ai-recording-pulse"></view>
        <text class="ai-recording-text">正在聆听… 松开发送</text>
      </view>
      <scroll-view class="ai-chat-messages" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{aiScrollTop}}" scroll-with-animation>
        <view class="ai-msg" wx:for="{{aiMessages}}" wx:key="index" id="ai-msg-{{index}}">
          <view class="ai-msg-bubble ai-msg-bubble--{{item.role}} {{item.card ? 'ai-msg-bubble--ai-card' : ''}}">
            <text class="ai-msg-text">{{item.text}}</text>
            <!-- 待确认：3行布局卡片 -->
            <view wx:if="{{item.card && item.confirmed === undefined}}" class="ai-bill-card ai-bill-card--{{item.card.type}}">
              <!-- Row 1: Amount (大) + Type -->
              <view class="ai-bill-row ai-bill-row--main">
                <view class="ai-bill-amount-wrap">
                  <text class="ai-bill-currency">¥</text>
                  <input class="ai-bill-amount-input" type="digit" value="{{item.card.amount}}" bindinput="onAiCardAmountInput" data-idx="{{index}}" placeholder="0.00"/>
                </view>
                <picker mode="selector" range="{{typeOptions}}" value="{{item._typeIdx}}" bindchange="onAiCardTypeChange" data-idx="{{index}}">
                  <view class="ai-bill-tag-picker ai-bill-tag-picker--{{item.card.type}}">
                    <text class="ai-bill-tag-text">{{item.card.typeLabel}}</text>
                    <text class="ai-bill-arrow">▼</text>
                  </view>
                </picker>
              </view>
              <!-- Row 2: Category + Date + Target -->
              <view class="ai-bill-row ai-bill-row--fields">
                <picker mode="selector" range="{{catOptions}}" value="{{item._catIdx}}" bindchange="onAiCardCatChange" data-idx="{{index}}">
                  <view class="ai-bill-chip">
                    <text class="ai-bill-chip-text">{{item.card.category}}</text>
                    <text class="ai-bill-arrow">▼</text>
                  </view>
                </picker>
                <picker mode="date" value="{{item.card.date}}" bindchange="onAiCardDateChange" data-idx="{{index}}">
                  <view class="ai-bill-chip">
                    <text class="ai-bill-chip-text">{{item.card.date}}</text>
                    <text class="ai-bill-arrow">▼</text>
                  </view>
                </picker>
                <picker mode="selector" range="{{targetOptions}}" value="{{item._targetIdx}}" bindchange="onAiCardTargetChange" data-idx="{{index}}">
                  <view class="ai-bill-chip">
                    <text class="ai-bill-chip-text">{{item.card.target || '对象'}}</text>
                    <text class="ai-bill-arrow">▼</text>
                  </view>
                </picker>
              </view>
              <!-- Row 3: Note -->
              <view class="ai-bill-row ai-bill-row--note">
                <input class="ai-bill-input" value="{{item.card.note}}" bindinput="onAiCardNoteInput" data-idx="{{index}}" placeholder="添加备注..."/>
              </view>
              <!-- Buttons -->
              <view class="ai-bill-btns">
                <view class="ai-bill-btn ai-bill-btn--reject" catchtap="onAiReject" data-idx="{{index}}">取消</view>
                <view class="ai-bill-btn ai-bill-btn--confirm" catchtap="onAiConfirm" data-idx="{{index}}">确认记账</view>
              </view>
            </view>
            <!-- 已确认：原卡片 + 链接 -->
            <view wx:elif="{{item.card && item.confirmed === true}}" class="ai-bill-card ai-bill-card--{{item.card.type}}" catchtap="onAiBillTap" data-idx="{{index}}">
              <view class="ai-bill-row">
                <view class="ai-bill-dot"></view>
                <text class="ai-bill-cat">{{item.card.category}}</text>
                <text class="ai-bill-type">{{item.card.typeLabel}}</text>
                <text class="ai-bill-link">查看明细 ></text>
              </view>
              <view class="ai-bill-row ai-bill-row--bottom">
                <text class="ai-bill-amount">¥{{item.card.amount}}</text>
                <text wx:if="{{item.card.target}}" class="ai-bill-target-confirmed">{{item.card.target}}</text>
                <text class="ai-bill-date">{{item.card.date}}</text>
              </view>
            </view>
            <!-- 已取消：灰色 + 重新输入提示 -->
            <view wx:elif="{{item.card && item.confirmed === false}}" class="ai-bill-card ai-bill-card--rejected">
              <view class="ai-bill-row">
                <view class="ai-bill-dot"></view>
                <text class="ai-bill-cat">{{item.card.category}}</text>
                <text class="ai-bill-type">{{item.card.typeLabel}}</text>
              </view>
              <view class="ai-bill-row ai-bill-row--bottom">
                <text class="ai-bill-amount">¥{{item.card.amount}}</text>
                <text class="ai-bill-date">已取消</text>
              </view>
              <text class="ai-cancel-hint">{{item._ocrIndex !== undefined ? '此笔已跳过' : '识别有误？换个说法再试一次吧'}}</text>
            </view>
          </view>
          <text class="ai-msg-time ai-msg-time--{{item.role}}">{{item.time}}</text>
        </view>
        <view class="ai-msg" wx:if="{{aiThinking}}">
          <view class="ai-msg-bubble ai-msg-bubble--ai">
            <view class="ai-thinking-dots">
              <view class="ai-thinking-dot"></view>
              <view class="ai-thinking-dot"></view>
              <view class="ai-thinking-dot"></view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="ai-chat-input-bar">
        <view class="ai-input-toggle" bindtap="onAiToggleMode">
          <text class="ai-toggle-label">{{aiVoiceMode ? 'Aa' : 'mic'}}</text>
        </view>
        <block wx:if="{{aiVoiceMode}}">
          <view class="ai-voice-btn {{aiRecording ? 'ai-voice-btn--recording' : ''}}"
                bindtouchstart="onAiVoiceStart" bindtouchend="onAiVoiceEnd" bindtouchcancel="onAiVoiceEnd">
            <text class="ai-voice-text">{{aiRecording ? '松开 结束' : '按住 说话'}}</text>
          </view>
        </block>
        <block wx:else>
          <input class="ai-chat-input" placeholder="输入记账内容" value="{{aiInputText}}" bindinput="onAiInput" bindconfirm="onAiSend" confirm-type="send"/>
          <view class="ai-chat-send {{aiInputText ? 'ai-chat-send--active' : ''}}" bindtap="onAiSend">
            <text class="ai-send-arrow">↑</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 首次启动引导 -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <!-- Step 0: 欢迎 -->
    <view class="guide-card" wx:if="{{guideStep === 0}}">
      <view class="guide-logo">
        <view class="guide-logo-icon">
          <view class="guide-logo-bar guide-logo-bar--1"></view>
          <view class="guide-logo-bar guide-logo-bar--2"></view>
          <view class="guide-logo-bar guide-logo-bar--3"></view>
        </view>
      </view>
      <text class="guide-app-name">掌柜记账</text>
      <text class="guide-slogan">简单好用的智能记账工具</text>
      <view class="guide-btn" bindtap="onGuideNext">开始使用</view>
      <view class="guide-dots">
        <view class="guide-dot guide-dot--active"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
      </view>
    </view>

    <!-- Step 1: 登录 -->
    <view class="guide-card" wx:elif="{{guideStep === 1}}">
      <text class="guide-card-title">登录 / 注册</text>
      <view class="guide-form">
        <view class="guide-input-row">
          <text class="guide-prefix">+86</text>
          <input class="guide-input" placeholder="手机号" type="number" maxlength="11"
                 value="{{loginPhone}}" bindinput="onLoginPhoneInput"/>
        </view>
        <view class="guide-input-row">
          <input class="guide-input" placeholder="验证码" type="number" maxlength="6"
                 value="{{loginCode}}" bindinput="onLoginCodeInput"/>
          <view class="guide-code-btn {{loginCodeSending ? 'guide-code-btn--disabled' : ''}}"
                bindtap="onSendCode">
            {{loginCodeSending ? loginCodeCountdown + 's' : '获取验证码'}}
          </view>
        </view>
      </view>
      <view class="guide-btn" bindtap="onGuidePhoneLogin">登录</view>
      <view class="guide-divider-row">
        <view class="guide-divider-line"></view>
        <text class="guide-divider-text">或</text>
        <view class="guide-divider-line"></view>
      </view>
      <button class="guide-wx-btn" open-type="getUserInfo" bindgetuserinfo="onGuideWxLogin">微信一键登录</button>
      <text class="guide-skip" bindtap="onGuideSkipLogin">跳过登录</text>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
        <view class="guide-dot"></view>
      </view>
    </view>

    <!-- Step 2: 身份选择 -->
    <view class="guide-card" wx:elif="{{guideStep === 2}}">
      <text class="guide-card-title">选择身份</text>
      <text class="guide-card-desc">可以稍后在「我的 → 链接公司」中设置</text>
      <view class="guide-role-btn" bindtap="onGuideRole" data-role="boss">
        <view class="guide-role-icon guide-role-icon--boss">B</view>
        <view class="guide-role-info">
          <text class="guide-role-label">我是老板</text>
          <text class="guide-role-hint">创建公司，邀请员工</text>
        </view>
        <text class="guide-role-arrow">></text>
      </view>
      <view class="guide-role-btn" bindtap="onGuideRole" data-role="employee">
        <view class="guide-role-icon guide-role-icon--emp">E</view>
        <view class="guide-role-info">
          <text class="guide-role-label">我是员工</text>
          <text class="guide-role-hint">输入 UID 加入公司</text>
        </view>
        <text class="guide-role-arrow">></text>
      </view>
      <text class="guide-skip" bindtap="onGuideComplete">稍后再说</text>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
      </view>
    </view>

    <!-- Step 3: 公司表单 -->
    <view class="guide-card" wx:elif="{{guideStep === 3}}">
      <block wx:if="{{guideRole === 'boss'}}">
        <text class="guide-card-title">创建公司</text>
        <view class="guide-form">
          <view class="guide-input-row">
            <input class="guide-input" placeholder="公司名称" value="{{companyName}}"
                   bindinput="onCompanyNameInput"/>
          </view>
          <view class="guide-input-row">
            <input class="guide-input" placeholder="老板称谓（选填，默认 BOSS）" value="{{companyBossTitle}}"
                   bindinput="onCompanyBossTitleInput"/>
          </view>
          <view class="guide-uid-row">
            <text class="guide-uid-label">公司 UID</text>
            <text class="guide-uid-value">{{companyUid || '—'}}</text>
            <view class="guide-uid-gen" bindtap="onCreateUid">生成</view>
          </view>
        </view>
        <view class="guide-btn" bindtap="onGuideCompanyCreate">确认创建</view>
      </block>
      <block wx:elif="{{guideRole === 'employee'}}">
        <text class="guide-card-title">加入公司</text>
        <text class="guide-card-desc">输入老板提供的公司 UID</text>
        <view class="guide-form">
          <view class="guide-input-row">
            <input class="guide-input" placeholder="公司 UID" value="{{employeeUid}}"
                   bindinput="onEmployeeUidInput"/>
          </view>
        </view>
        <view class="guide-btn" bindtap="onGuideEmployeeJoin">申请加入</view>
      </block>
      <text class="guide-back" bindtap="onGuideBack">← 返回</text>
      <view class="guide-dots">
        <view class="guide-dot"></view>
        <view class="guide-dot"></view>
        <view class="guide-dot guide-dot--active"></view>
      </view>
    </view>
  </view>

  <!-- 资料设置弹窗（新用户引导 + 我的页编辑共用） -->
  <view class="profile-modal-mask" wx:if="{{showProfileModal}}" catchtap="onProfileMaskTap">
    <view class="profile-modal" catchtap="nop">
      <text class="profile-modal-title">{{profileEditMode ? '编辑资料' : '完善资料'}}</text>
      <text class="profile-modal-subtitle">{{profileEditMode ? '修改你的昵称和头像' : '设置你的昵称和头像'}}</text>
      <view class="profile-avatar-pick" catchtap="onChooseAvatar">
        <image wx:if="{{profileAvatarLocal}}" class="profile-avatar-img" src="{{profileAvatarLocal}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar-ph"><text class="my-avatar-plus">＋</text></view>
        <view class="profile-avatar-badge"><text class="profile-avatar-badge-ico">＋</text></view>
      </view>
      <text class="profile-avatar-tip">{{profileUploading ? '上传中…' : '点击更换头像'}}</text>
      <view class="profile-field">
        <view class="profile-field-head">
          <text class="profile-field-label">昵称</text>
          <text class="profile-field-count">{{profileName.length}}/20</text>
        </view>
        <input class="profile-name-input" value="{{profileName}}" placeholder="请输入昵称" placeholder-class="profile-name-ph" maxlength="20" bindinput="onProfileNameInput"/>
      </view>
      <view class="profile-modal-btns">
        <view class="profile-btn profile-btn--skip" catchtap="onProfileSkip">{{profileEditMode ? '取消' : '跳过'}}</view>
        <view class="profile-btn profile-btn--save {{profileUploading ? 'is-disabled' : ''}}" catchtap="onProfileSave">完成</view>
      </view>
    </view>
  </view>

  <!-- 冲突解决面板 -->
  <view class="conflict-panel-mask" wx:if="{{showConflictPanel}}" catchtap="">
    <view class="conflict-panel" catchtap="">
      <view class="conflict-panel-header">
        <text class="conflict-panel-title">数据冲突 ({{conflicts.length}})</text>
        <text class="conflict-panel-subtitle">以下账单在本地和云端有冲突，请选择保留哪个版本</text>
      </view>

      <view class="conflict-progress">
        <text class="conflict-progress-text">{{conflictIndex + 1}} / {{conflicts.length}}</text>
        <view class="conflict-progress-bar">
          <view class="conflict-progress-fill" style="width: {{(conflictIndex + 1) / conflicts.length * 100}}%"></view>
        </view>
      </view>

      <block wx:for="{{conflicts}}" wx:key="id">
        <view class="conflict-card" wx:if="{{index === conflictIndex}}">
          <view class="conflict-reason">
            <view class="conflict-reason-icon"><text>!</text></view>
            <text class="conflict-reason-text">{{item.reason}}</text>
          </view>

          <!-- 本地版本 -->
          <view class="conflict-version" wx:if="{{item.localVersion}}">
            <view class="conflict-version-header">
              <text class="conflict-version-label conflict-version-label--local">本地版本</text>
              <text wx:if="{{item.localVersion._dirty}}" class="conflict-version-badge">已修改</text>
            </view>
            <view class="conflict-item-row">
              <text class="conflict-item-icon">&#x1F4CC;</text>
              <text class="conflict-item-cat">{{item.localVersion.category}}</text>
              <text class="conflict-item-type">{{item.localVersion.typeLabel}}</text>
            </view>
            <view class="conflict-item-row">
              <text class="conflict-item-amount {{item.localVersion.type === 'in' ? 'conflict-amount--in' : 'conflict-amount--out'}}">&#165;{{item.localVersion.amount}}</text>
              <text class="conflict-item-date">{{item.localVersion.date}}</text>
            </view>
            <view class="conflict-item-row" wx:if="{{item.localVersion.note}}">
              <text class="conflict-item-note">{{item.localVersion.note}}</text>
            </view>
          </view>

          <view class="conflict-version conflict-version--deleted" wx:if="{{!item.localVersion}}">
            <view class="conflict-version-header">
              <text class="conflict-version-label conflict-version-label--deleted">本地已删除</text>
            </view>
            <text class="conflict-deleted-hint">此账单已在本地删除</text>
          </view>

          <view class="conflict-vs">
            <view class="conflict-vs-line"></view>
            <text class="conflict-vs-text">VS</text>
            <view class="conflict-vs-line"></view>
          </view>

          <!-- 云端版本 -->
          <view class="conflict-version" wx:if="{{item.serverVersion}}">
            <view class="conflict-version-header">
              <text class="conflict-version-label conflict-version-label--server">云端版本</text>
            </view>
            <view class="conflict-item-row">
              <text class="conflict-item-icon">&#x1F4CC;</text>
              <text class="conflict-item-cat">{{item.serverVersion.category}}</text>
              <text class="conflict-item-type">{{item.serverVersion.typeLabel}}</text>
            </view>
            <view class="conflict-item-row">
              <text class="conflict-item-amount {{item.serverVersion.type === 'in' ? 'conflict-amount--in' : 'conflict-amount--out'}}">&#165;{{item.serverVersion.amount}}</text>
              <text class="conflict-item-date">{{item.serverVersion.date}}</text>
            </view>
            <view class="conflict-item-row" wx:if="{{item.serverVersion.note}}">
              <text class="conflict-item-note">{{item.serverVersion.note}}</text>
            </view>
          </view>

          <view class="conflict-version conflict-version--deleted" wx:if="{{!item.serverVersion}}">
            <view class="conflict-version-header">
              <text class="conflict-version-label conflict-version-label--deleted">云端已删除</text>
            </view>
            <text class="conflict-deleted-hint">此账单在云端已不存在</text>
          </view>

          <view class="conflict-btns">
            <block wx:if="{{item.type !== 'server_voided'}}">
              <view class="conflict-btn conflict-btn--local {{item.resolution === 'local' ? 'conflict-btn--active' : ''}}" bindtap="onConflictResolve" data-id="{{item.id}}" data-scope="{{item.scope}}" data-resolution="local"><text>保留本地</text></view>
              <view class="conflict-btn conflict-btn--server {{item.resolution === 'server' ? 'conflict-btn--active' : ''}}" bindtap="onConflictResolve" data-id="{{item.id}}" data-scope="{{item.scope}}" data-resolution="server"><text>保留云端</text></view>
            </block>
            <block wx:else>
              <view class="conflict-btn conflict-btn--local {{item.resolution === 'server_voided_restore' ? 'conflict-btn--active' : ''}}" bindtap="onConflictResolve" data-id="{{item.id}}" data-scope="{{item.scope}}" data-resolution="server_voided_restore"><text>保留本地</text></view>
              <view class="conflict-btn conflict-btn--server {{item.resolution === 'server_voided_accept' ? 'conflict-btn--active' : ''}}" bindtap="onConflictResolve" data-id="{{item.id}}" data-scope="{{item.scope}}" data-resolution="server_voided_accept"><text>接受删除</text></view>
            </block>
          </view>

          <view class="conflict-resolved-tag" wx:if="{{item.resolution}}">
            <text>已选择: {{item.resolution === 'local' || item.resolution === 'server_voided_restore' ? '本地版本' : (item.resolution === 'server' || item.resolution === 'server_voided_accept' ? '云端版本' : '')}}</text>
          </view>
        </view>
      </block>

      <view class="conflict-nav">
        <view class="conflict-nav-btn {{conflictIndex === 0 ? 'conflict-nav-btn--disabled' : ''}}" bindtap="onConflictPrev"><text>上一个</text></view>
        <view class="conflict-nav-dots">
          <view class="conflict-nav-dot {{idx === conflictIndex ? 'conflict-nav-dot--active' : ''}} {{conflicts[idx].resolution ? 'conflict-nav-dot--resolved' : ''}}" wx:for="{{conflicts}}" wx:key="id" wx:for-index="idx"></view>
        </view>
        <view class="conflict-nav-btn {{conflictIndex === conflicts.length - 1 ? 'conflict-nav-btn--disabled' : ''}}" bindtap="onConflictNext"><text>下一个</text></view>
      </view>

      <view class="conflict-apply {{conflictResolving ? 'conflict-apply--loading' : ''}}" bindtap="onConflictDismiss">
        <text>应用所有选择</text>
      </view>
    </view>
  </view>
</view>
