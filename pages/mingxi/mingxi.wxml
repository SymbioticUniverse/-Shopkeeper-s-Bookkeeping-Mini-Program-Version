                <view class="notify-dot" wx:if="{{!item.read}}"></view>
                <text class="notify-text">{{item.text}}</text>
                <text class="notify-time">{{item.time}}</text>
              </view>
            </view>
          </block>
          <view class="notify-empty" wx:if="{{notifyList.length === 0}}">
            <text>暂无通知</text>
