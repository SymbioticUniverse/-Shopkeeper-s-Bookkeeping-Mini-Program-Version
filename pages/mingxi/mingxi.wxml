<view class="page">
  <!-- 标题栏 -->
  <view class="header">
    <view class="header-left" wx:if="{{showOverview && !showCustomOverview && !showCustomCategory}}">
      <text class="year-text">2026年</text>
      <view class="date-badge">
        <text class="date-month-num">06</text>
        <text class="date-month-label">月</text>
        <view class="date-arrow"></view>
      </view>
    </view>
    <view class="header-back-btn" wx:if="{{!showOverview || showCustomOverview}}" bindtap="goOverview">
      <view class="back-arrow"></view>
      <text class="back-text">返回简览页</text>
    </view>
    <text class="header-title">公私OPC记账</text>
    <view class="header-right-icon">
      <view class="avatar-circle"></view>
    </view>
  </view>

  <!-- 卡片网格区 -->
  <view class="card-grid">

    <!-- ===== 自定义简览页 ===== -->
    <block wx:if="{{showCustomOverview && showOverview}}">
      <view class="custom-overview-container">
        <view class="card grid-span-3 my-card custom-edit-card">
          <view class="custom-cat-header">
            <view class="custom-cat-back" bindtap="onExitEditMode">
              <view class="custom-cat-back-arrow"></view>
            </view>
            <text class="custom-cat-title">自定义简览页</text>
          </view>
          <scroll-view class="custom-edit-canvas" scroll-y enhanced show-scrollbar="{{false}}">
            <!-- 占1格卡片 -->
            <view class="custom-section-label">占 1 格</view>
            <view class="custom-card-row">
              <block wx:for="{{span1Templates}}" wx:key="id">
                <view class="custom-template-card custom-template-card--span1" bindtouchstart="onTemplateTouchStart" bindtouchmove="onDragOverlayMove" bindtouchend="onDragOverlayEnd" data-id="{{item.id}}">
                  <view class="custom-glass-inner custom-glass-inner--s1">
                    <view class="custom-tpl-card custom-tpl-card--span1">
                      <view class="card-header">
                        <view class="card-avatar" wx:if="{{item.hasAvatar}}"></view>
                        <text class="card-title">{{item.name}}</text>
                        <text class="card-subtitle">{{item.subtitle}}</text>
                      </view>
                      <view class="card-divider card-divider--down"></view>
                      <!-- 折线图预览（参照报表页 stock chart：净值线 + 绿红块 + 图例） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_line'}}">
                        <view class="mini-chart mini-chart--line">
                          <view class="mini-dot" style="left: 4%; bottom: 24%;"></view>
                          <view class="mini-dot" style="left: 18%; bottom: 50%;"></view>
                          <view class="mini-dot" style="left: 32%; bottom: 32%;"></view>
                          <view class="mini-dot" style="left: 46%; bottom: 56%;"></view>
                          <view class="mini-dot" style="left: 60%; bottom: 20%;"></view>
                          <view class="mini-dot" style="left: 74%; bottom: 44%;"></view>
                          <view class="mini-dot" style="left: 88%; bottom: 36%;"></view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <!-- 柱状图预览（参照报表页 bar chart：绿红柱对 + 虚线分隔） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_bar'}}">
                        <view class="mini-chart mini-chart--bar">
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 18rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 24rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 30rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 14rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 22rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 20rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 14rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 28rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 26rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 18rpx;"></view>
                          </view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <!-- 饼状图预览（参照报表页 pie chart：多色分段圆） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_pie'}}">
                        <view class="mini-chart mini-chart--pie">
                          <view class="mini-pie"></view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <block wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                        <block wx:if="{{!row.threeCol}}">
                          <view class="card-row">
                            <text class="row-label">{{row.label}}</text>
                            <view class="value-tag {{row.color}}">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{row.value}}</text>
                            </view>
                          </view>
                        </block>
                        <block wx:else>
                          <view class="card-divider card-divider--tight"></view>
                          <view class="card-row three-col">
                            <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
                          </view>
                          <view class="card-row three-col">
                            <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{val}}</text>
                            </view>
                          </view>
                        </block>
                      </block>
                    </view>
                  </view>
                </view>
              </block>
            </view>
            <!-- 占2格卡片 -->
            <view class="custom-section-label">占 2 格</view>
            <view class="custom-card-row">
              <block wx:for="{{span2Templates}}" wx:key="id">
                <view class="custom-template-card custom-template-card--span2" bindtouchstart="onTemplateTouchStart" bindtouchmove="onDragOverlayMove" bindtouchend="onDragOverlayEnd" data-id="{{item.id}}">
                  <view class="custom-glass-inner custom-glass-inner--s2">
                    <!-- 明细页风格：交易流水列表截断 -->
                    <view class="custom-tpl-card custom-tpl-card--span2" wx:if="{{item.previewStyle === 'detail'}}">
                      <view class="custom-tpl-detail-head">
                        <text class="custom-tpl-detail-title">{{item.name}}</text>
                        <view class="custom-tpl-detail-toggle">
                          <text class="custom-tpl-toggle-item custom-tpl-toggle-item--active">个人</text>
                          <text class="custom-tpl-toggle-item">公司</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-period">
                        <text class="custom-tpl-period-item custom-tpl-period-item--active">月度</text>
                        <text class="custom-tpl-period-item">季度</text>
                        <text class="custom-tpl-period-item">年度</text>
                        <text class="custom-tpl-period-item">日度</text>
                      </view>
                      <view class="custom-tpl-detail-date-row">
                        <text class="custom-tpl-detail-date-tag">2026年06月</text>
                        <view class="custom-tpl-detail-inout">
                          <text class="custom-tpl-inout-dot custom-tpl-inout-dot--in"></text>
                          <text class="custom-tpl-inout-label">收入</text>
                          <text class="custom-tpl-inout-dot custom-tpl-inout-dot--out"></text>
                          <text class="custom-tpl-inout-label">支出</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-cols">
                        <text class="custom-tpl-col-hd" style="width: 50rpx">分类</text>
                        <text class="custom-tpl-col-hd" style="width: 44rpx">类型</text>
                        <text class="custom-tpl-col-hd" style="flex: 1">备注</text>
                        <text class="custom-tpl-col-hd" style="width: 56rpx; text-align: right">金额</text>
                        <text class="custom-tpl-col-hd" style="width: 64rpx; text-align: right">日期</text>
                      </view>
                      <view class="custom-tpl-detail-bills">
                        <view class="custom-tpl-bill-row" wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                          <view class="custom-tpl-bill-dot"></view>
                          <text class="custom-tpl-bill-cat">{{row.label}}</text>
                          <text class="custom-tpl-bill-type">收入</text>
                          <text class="custom-tpl-bill-note">-</text>
                          <text class="custom-tpl-bill-val {{row.color === 'green' ? 'custom-tpl-bill-val--in' : 'custom-tpl-bill-val--out'}}">¥{{row.value}}</text>
                          <text class="custom-tpl-bill-date">06-10</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-cut">...</view>
                    </view>
                    <!-- 简览页风格：card rows -->
                    <view class="custom-tpl-card custom-tpl-card--span2" wx:else>
                      <view class="card-header">
                        <text class="card-title">{{item.name}}</text>
                        <text class="card-subtitle">{{item.subtitle}}</text>
                      </view>
                      <view class="card-divider card-divider--down"></view>
                      <block wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                        <block wx:if="{{!row.threeCol}}">
                          <view class="card-row">
                            <text class="row-label">{{row.label}}</text>
                            <view class="value-tag {{row.color}}">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{row.value}}</text>
                            </view>
                          </view>
                        </block>
                        <block wx:else>
                          <view class="card-divider card-divider--tight"></view>
                          <view class="card-row three-col">
                            <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
                          </view>
                          <view class="card-row three-col">
                            <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{val}}</text>
                            </view>
                          </view>
                        </block>
                      </block>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    <!-- ===== 拖放全屏遮罩（触摸模板卡片后出现，松手消失） ===== -->
    <view class="drag-overlay" wx:if="{{dragFloat.visible}}">
      <view class="drag-float-card" style="left: {{dragFloat.x}}px; top: {{dragFloat.y}}px;">
        <text class="drag-float-name">{{dragFloat.name}}</text>
        <text class="drag-float-sub" wx:if="{{dragFloat.subtitle}}">{{dragFloat.subtitle}}</text>
      </view>
    </view>
    <!-- ===== 槽位弹窗（拖动浮现，松手后保留） ===== -->
    <view class="slot-modal-mask" wx:if="{{showSlotModal}}" catchtap="">
      <view class="slot-modal" id="slotModalContent">
        <text class="slot-modal-title">拖放卡片到卡槽</text>
        <view class="slot-list">
          <view class="slot-item {{slotHover === item.index ? 'slot-item--hover' : ''}} {{item.card ? 'slot-item--filled' : ''}} slot-item--h{{item.height}}"
                wx:for="{{slotLayout}}" wx:key="index" wx:for-item="item">
            <block wx:if="{{item.card}}">
              <text class="slot-card-name">{{item.card.name}}</text>
              <text class="slot-card-sub">{{item.card.subtitle}}</text>
              <text class="slot-card-span">占 {{item.card.span}} 格</text>
            </block>
            <block wx:else>
              <text class="slot-placeholder">卡槽 {{item.index + 1}}</text>
            </block>
          </view>
        </view>
        <view class="slot-modal-btns">
          <view class="slot-btn slot-btn--cancel" bindtap="onSlotCancel"><text>取消</text></view>
          <view class="slot-btn slot-btn--confirm" bindtap="onSlotConfirm"><text>确认</text></view>
        </view>
      </view>
    </view>

    <!-- ===== 默认简览（动态渲染 overviewCards） ===== -->
    <block wx:if="{{!showCustomOverview && showOverview}}">
      <view class="card grid-span-{{item.span}}" wx:for="{{overviewCards}}" wx:key="id" bindtap="switchTab" data-index="0">
        <view class="card-header {{item.span >= 2 ? 'compact' : ''}}">
          <view class="card-avatar" wx:if="{{item.hasAvatar}}"></view>
          <text class="card-title">{{item.name}}</text>
          <text class="card-arrow">〉</text>
          <text class="card-subtitle">{{item.subtitle}}</text>
        </view>
        <view class="card-divider card-divider--down"></view>
        <!-- 折线图 canvas（复用报表页 drawStockChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_line'}}" type="2d" id="ovLine_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 柱状图 canvas（复用报表页 drawBarChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_bar'}}" type="2d" id="ovBar_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 饼状图 canvas（复用报表页 drawPieChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_pie'}}" type="2d" id="ovPie_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 非图表卡片：渲染 rows -->
        <block wx:if="{{!item.previewStyle || item.previewStyle === 'overview' || item.previewStyle === 'detail'}}" wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
          <block wx:if="{{!row.threeCol}}">
            <view class="card-row">
              <text class="row-label">{{row.label}}</text>
              <view class="value-tag {{row.color}}">
                <text class="value-yen">¥</text>
                <text class="value-num">{{row.value}}</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="card-divider card-divider--tight"></view>
            <view class="card-row three-col">
              <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
            </view>
            <view class="card-row three-col">
              <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                <text class="value-yen">¥</text>
                <text class="value-num">{{val}}</text>
              </view>
            </view>
          </block>
        </block>
      </view>
    </block>

    <!-- ===== 非简览页：各 Tab 内容 ===== -->
    <block wx:if="{{!showOverview}}">

    <!-- Tab 0: 明细 -->
    <block wx:if="{{currentTab === 0}}">
      <view class="card grid-span-3 detail-card">
        <view class="detail-header">
          <text class="detail-title">明细</text>
          <view class="report-type-toggle" bindtap="switchDetailType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{detailType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{detailType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{detailType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="report-period-bar">
          <view class="report-period-item {{detailPeriod === 0 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{0}}">
            <text class="report-period-text {{detailPeriod === 0 ? 'report-period-text--active' : ''}}">月度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 1 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{1}}">
            <text class="report-period-text {{detailPeriod === 1 ? 'report-period-text--active' : ''}}">季度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 2 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{2}}">
            <text class="report-period-text {{detailPeriod === 2 ? 'report-period-text--active' : ''}}">年度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 3 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{3}}">
            <text class="report-period-text {{detailPeriod === 3 ? 'report-period-text--active' : ''}}">日度</text>
          </view>
        </view>
        <view class="detail-list-area">
          <view class="detail-date-row">
            <picker wx:if="{{detailPeriod === 0}}" mode="date" fields="month" value="{{detailPickerDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 1}}" mode="multiSelector" range="{{reportQuarterRange}}" value="{{reportQuarterMultiIndex}}" bindchange="onDetailQuarterChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 2}}" mode="date" fields="year" value="{{detailPickerDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 3}}" mode="date" value="{{detailPickerDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <view class="detail-inout-box">
              <view class="report-inout-item">
                <view class="report-dot report-dot--green"></view>
                <text class="report-inout-label">收入</text>
              </view>
              <view class="report-inout-item">
                <view class="report-dot report-dot--red"></view>
                <text class="report-inout-label">支出</text>
              </view>
            </view>
          </view>
          <view class="detail-col-headers">
            <view class="bill-header-row">
              <text class="bill-header-label" style="width:70rpx">分类</text>
              <text class="bill-header-label" style="width:70rpx">类型</text>
              <text class="bill-header-label" style="width:80rpx">备注</text>
              <text class="bill-header-label" style="flex:1;text-align:right;margin-right:12rpx">金额</text>
              <text class="bill-header-label" style="width:110rpx;text-align:right">日期</text>
            </view>
          </view>
          <scroll-view class="detail-list" scroll-y enhanced show-scrollbar="{{false}}">
            <view wx:for="{{detailItems}}" wx:key="id" class="bill-row">
              <view class="bill-actions">
                <view class="bill-act-btn bill-act-settle" catchtap="onBillSettle" data-id="{{item.id}}" data-from="detail">结清</view>
                <view class="bill-act-btn bill-act-delete" catchtap="onBillDelete" data-id="{{item.id}}" data-from="detail">删除</view>
                <view wx:if="{{!item._voided}}" class="bill-act-btn bill-act-void" catchtap="onBillVoid" data-id="{{item.id}}" data-from="detail">作废</view>
                <view wx:else class="bill-act-btn bill-act-unvoid" catchtap="onBillUnvoid" data-id="{{item.id}}" data-from="detail">恢复</view>
              </view>
              <view class="bill-item {{item.typeLabel === '垫付' ? 'bill-item--advance' : ''}} {{item.typeLabel === '应付' ? 'bill-item--payable' : ''}} {{item._voided ? 'bill-item--voided' : ''}}"
                    bindtouchstart="onBillTouchStart"
                    bindtouchmove="onBillTouchMove"
                    bindtouchend="onBillTouchEnd"
                    bindtap="onBillTap"
                    data-id="{{item.id}}"
                    data-from="detail">
                <view class="bill-dot"></view>
                <text class="bill-cat">{{item.category}}</text>
                <text class="bill-type">{{item.typeLabel}}</text>
                <text class="bill-note-inline">{{item.note || '-'}}</text>
                <text class="bill-amount {{item.type === 'in' ? 'bill-amount--in' : 'bill-amount--out'}}">¥{{item.amount}}</text>
                <text class="bill-date">{{item.date}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    <!-- Tab 1: 报表 -->
    <block wx:if="{{currentTab === 1}}">
      <view class="card grid-span-3 report-card">
        <view class="report-header">
          <text class="report-title">报表</text>
          <view class="report-type-toggle" bindtap="switchReportType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{reportType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{reportType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{reportType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="report-period-bar">
          <view class="report-period-item {{reportPeriod === 0 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{0}}">
            <text class="report-period-text {{reportPeriod === 0 ? 'report-period-text--active' : ''}}">月度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 1 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{1}}">
            <text class="report-period-text {{reportPeriod === 1 ? 'report-period-text--active' : ''}}">季度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 2 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{2}}">
            <text class="report-period-text {{reportPeriod === 2 ? 'report-period-text--active' : ''}}">年度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 3 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{3}}">
            <text class="report-period-text {{reportPeriod === 3 ? 'report-period-text--active' : ''}}">日度</text>
          </view>
        </view>
        <view class="report-chart-area">
          <view class="report-info-row">
            <picker wx:if="{{reportPeriod === 0}}" mode="date" fields="month" value="{{reportPickerDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 1}}" mode="multiSelector" range="{{reportQuarterRange}}" value="{{reportQuarterMultiIndex}}" bindchange="onReportQuarterChange" bindcolumnchange="onReportQuarterColumnChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 2}}" mode="date" fields="year" value="{{reportPickerDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 3}}" mode="date" value="{{reportPickerDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <view class="report-inout-box">
              <view class="report-inout-item">
                <view class="report-dot report-dot--green"></view>
                <text class="report-inout-label">收入</text>
              </view>
              <view class="report-inout-item">
                <view class="report-dot report-dot--red"></view>
                <text class="report-inout-label">支出</text>
              </view>
            </view>
          </view>
          <view class="report-chart-block">
            <canvas type="2d" id="lineChart" class="report-canvas" bindtouchstart="onChartTap"></canvas>
          </view>
          <text class="report-chart-label">收入 / 支出柱状图</text>
          <view class="report-chart-block">
            <canvas type="2d" id="barChart" class="report-canvas"></canvas>
          </view>
          <view class="report-pie-block">
            <view class="report-pie-row">
              <view class="report-pie-cell">
                <text class="report-pie-label">收入来源</text>
                <canvas type="2d" id="pieIncome" class="report-pie-canvas" bindtouchstart="onPieIncomeTap"></canvas>
              </view>
              <view class="report-pie-cell">
                <text class="report-pie-label">支出类别</text>
                <canvas type="2d" id="pieExpense" class="report-pie-canvas" bindtouchstart="onPieExpenseTap"></canvas>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- Tab 2: 记账 -->
    <block wx:if="{{currentTab === 2}}">
      <view class="card grid-span-1 placeholder-card"><text>收入</text></view>
      <view class="card grid-span-1 placeholder-card"><text>支出</text></view>
      <view class="card grid-span-1 placeholder-card"><text>转账</text></view>
    </block>

    <!-- Tab 3: 结清 -->
    <block wx:if="{{currentTab === 3}}">
      <view class="card grid-span-3 settle-card">
        <view class="settle-header">
          <view>
            <text class="settle-title">结清</text>
            <view class="settle-subtitle">{{settleType === 0 ? '个人垫付 · 应付' : '公司垫付 · 应付'}}</view>
          </view>
          <view class="report-type-toggle" bindtap="switchSettleType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{settleType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{settleType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{settleType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="settle-divider"></view>
        <scroll-view class="settle-list" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{settleItems}}" wx:key="id" class="bill-row">
            <view class="bill-actions">
              <view class="bill-act-btn bill-act-settle" catchtap="onBillSettle" data-id="{{item.id}}" data-from="settle">结清</view>
              <view class="bill-act-btn bill-act-delete" catchtap="onBillDelete" data-id="{{item.id}}" data-from="settle">删除</view>
              <view wx:if="{{!item._voided}}" class="bill-act-btn bill-act-void" catchtap="onBillVoid" data-id="{{item.id}}" data-from="settle">作废</view>
              <view wx:else class="bill-act-btn bill-act-unvoid" catchtap="onBillUnvoid" data-id="{{item.id}}" data-from="settle">恢复</view>
            </view>
            <view class="bill-item {{item.typeLabel === '垫付' ? 'bill-item--advance' : ''}} {{item.typeLabel === '应付' ? 'bill-item--payable' : ''}} {{item._voided ? 'bill-item--voided' : ''}}"
                  bindtouchstart="onBillTouchStart"
                  bindtouchmove="onBillTouchMove"
                  bindtouchend="onBillTouchEnd"
                  bindtap="onBillTap"
                  data-id="{{item.id}}"
                  data-from="settle">
              <view class="bill-dot"></view>
              <text class="bill-cat">{{item.category}}</text>
              <text class="bill-type">{{item.typeLabel}}</text>
              <text class="bill-note-inline">{{item.note || '-'}}</text>
              <text class="bill-amount {{item.type === 'in' ? 'bill-amount--in' : 'bill-amount--out'}}">¥{{item.amount}}</text>
              <text class="bill-date">{{item.date}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="settle-btn" bindtap="onSettleAll">
          <text class="settle-btn-text">一键全结清</text>
        </view>
        <text class="settle-warn">* 结清后相关收支将自动转为普通流水</text>
      </view>
    </block>

    <!-- Tab 4: 我的 -->
    <block wx:if="{{currentTab === 4}}">
      <!-- 自定义分类页 -->
      <view class="card grid-span-3 my-card custom-cat-card" wx:if="{{showCustomCategory}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onCustomCategoryBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <text class="custom-cat-title">自定义分类</text>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="custom-cat-body">
          <view class="custom-cat-personal-block">
            <view class="custom-cat-section-hd">
              <text class="custom-cat-section-label">个人分类</text>
              <view class="custom-cat-tabs">
                <view class="custom-cat-tab {{catTabPersonal === 'out' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="out">支出</view>
                <view class="custom-cat-tab {{catTabPersonal === 'in' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="in">收入</view>
              </view>
            </view>
            <scroll-view class="custom-cat-grid-scroll" scroll-y enhanced show-scrollbar="{{false}}">
              <view class="custom-cat-grid">
                <view class="custom-cat-item" wx:for="{{personalCategories}}" wx:key="id" wx:if="{{item.inOut === catTabPersonal}}" bindlongtap="onDeleteCategory" data-id="{{item.id}}" data-scope="personal">
                  <view class="custom-cat-icon-wrap">
                    <text class="custom-cat-emoji">{{item.emoji}}</text>
                  </view>
                  <text class="custom-cat-name">{{item.name}}</text>
                </view>
              </view>
            </scroll-view>
            <view class="custom-cat-add" bindtap="onAddCategory" data-scope="personal">
              <view class="custom-cat-add-icon">+</view>
            </view>
          </view>
          <view class="custom-cat-divider"></view>
          <view class="custom-cat-company-block">
            <view class="custom-cat-section-hd">
              <text class="custom-cat-section-label">公司分类</text>
              <view class="custom-cat-tabs">
                <view class="custom-cat-tab {{catTabCompany === 'out' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="out">支出</view>
                <view class="custom-cat-tab {{catTabCompany === 'in' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="company" data-tab="in">收入</view>
              </view>
            </view>
            <scroll-view class="custom-cat-grid-scroll" scroll-y enhanced show-scrollbar="{{false}}">
              <view class="custom-cat-grid">
                <view class="custom-cat-item" wx:for="{{companyCategories}}" wx:key="id" wx:if="{{item.inOut === catTabCompany}}" bindlongtap="onDeleteCategory" data-id="{{item.id}}" data-scope="company">
                  <view class="custom-cat-icon-wrap">
                    <text class="custom-cat-emoji">{{item.emoji}}</text>
                  </view>
                  <text class="custom-cat-name">{{item.name}}</text>
                </view>
              </view>
            </scroll-view>
            <view class="custom-cat-add" bindtap="onAddCategory" data-scope="company">
              <view class="custom-cat-add-icon">+</view>
            </view>
          </view>
          <view class="custom-cat-bottom-spacer"></view>
        </view>
        <!-- 添加分类弹窗 -->
        <view class="cat-modal-mask" wx:if="{{showCatModal}}" bindtap="onCatModalClose"></view>
        <view class="cat-modal" wx:if="{{showCatModal}}">
          <view class="cat-modal-hd">
            <text class="cat-modal-title">添加分类</text>
            <view class="cat-modal-close" bindtap="onCatModalClose">✕</view>
          </view>
          <view class="cat-modal-body">
            <view class="cat-modal-field">
              <text class="cat-modal-label">名称</text>
              <input class="cat-modal-input" value="{{catModalName}}" bindinput="onCatModalNameInput" placeholder="输入分类名称" maxlength="10"/>
            </view>
            <view class="cat-modal-field">
              <text class="cat-modal-label">图标</text>
              <view class="cat-modal-emoji-grid">
                <view class="cat-modal-emoji-item {{catModalEmoji === item ? 'cat-modal-emoji--on' : ''}}" wx:for="{{catEmojiList}}" wx:key="*this" wx:for-item="item" bindtap="onCatModalPickEmoji" data-emoji="{{item}}">{{item}}</view>
              </view>
            </view>
          </view>
          <view class="cat-modal-ft">
            <view class="cat-modal-btn cat-modal-btn--cancel" bindtap="onCatModalClose">取消</view>
            <view class="cat-modal-btn cat-modal-btn--confirm" bindtap="onCatModalConfirm">确认</view>
          </view>
        </view>
      </view>
      <!-- 正常我的页面 -->
      <view class="card grid-span-3 my-card" wx:else>
        <view class="my-profile">
          <text class="my-login-text">登录/注册</text>
          <view class="my-avatar"></view>
        </view>
        <view class="my-group">
          <view class="my-item" bindtap="onVipEntry">
            <view class="my-item-icon icon-vip"></view>
            <view class="my-item-body">
              <text class="my-item-title">升级为VIP</text>
              <text class="my-item-sub">畅享更多高级功能</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-icon-row">
            <view class="my-icon-item"><view class="my-icon-circle icon-link"></view><text class="my-icon-label">链接公司</text></view>
            <view class="my-icon-item"><view class="my-icon-circle icon-invite"></view><text class="my-icon-label">邀请员工</text></view>
            <view class="my-icon-item"><view class="my-icon-circle icon-audit"></view><text class="my-icon-label">审核</text></view>
            <view class="my-icon-item"><view class="my-icon-circle icon-notify"></view><text class="my-icon-label">通知</text></view>
          </view>
        </view>
        <view class="my-group">
          <view class="my-item" bindtap="onCustomOverviewEntry">
            <view class="my-item-icon icon-custom-view"></view>
            <view class="my-item-body">
              <text class="my-item-title">自定义简览页</text>
              <text class="my-item-sub">新简览</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item" bindtap="onCustomCategoryEntry">
            <view class="my-item-icon icon-custom-cat"></view>
            <view class="my-item-body">
              <text class="my-item-title">自定义分类</text>
              <text class="my-item-sub">新分类</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item">
            <view class="my-item-icon icon-share"></view>
            <view class="my-item-body">
              <text class="my-item-title">链接公司共享同一账本</text>
              <text class="my-item-sub">随时记账再也不忘</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item">
            <view class="my-item-icon icon-export"></view>
            <view class="my-item-body">
              <text class="my-item-title">导出账单</text>
              <text class="my-item-sub">一键导出</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
        </view>
        <view class="my-group">
          <view class="my-item">
            <view class="my-item-icon icon-contact"></view>
            <view class="my-item-body">
              <text class="my-item-title">联系我们获好礼</text>
              <text class="my-item-sub">提意见赠会员</text>
            </view>
            <text class="my-item-arrow">〉</text>
          </view>
          <view class="my-item my-item-last">
            <view class="my-item-icon icon-settings"></view>
            <view class="my-item-body"><text class="my-item-title">设置</text></view>
            <text class="my-item-arrow">〉</text>
          </view>
        </view>
      </view>
    </block>

    </block>
  </view>

  <!-- 自定义简览页 · 拖拽弹窗 -->
  <view class="popup-mask" wx:if="{{showPopup}}" catchtouchstart="onPopupDragStart" catchtouchmove="onPopupDragMove" catchtouchend="onPopupDragEnd">
    <view class="popup-card" catchtap="nop">
      <view class="popup-card-header">
        <text class="popup-card-title">拖入卡槽</text>
        <text class="popup-card-drag-hint">拖拽下方卡片到目标槽位</text>
      </view>
      <view class="popup-slots">
        <view class="popup-slot popup-slot--span{{item.span}} {{ghostDrag.slotHover === index ? 'popup-slot--hover' : ''}} {{item.isEmpty ? 'popup-slot--empty' : ''}}" wx:for="{{visibleSlots}}" wx:key="col" wx:for-item="item" data-col="{{item.col}}" data-span="{{item.span}}">
          <block wx:if="{{!item.isEmpty}}">
            <text class="popup-slot-name">{{item.card.name}}</text>
            <text class="popup-slot-meta">占{{item.span}}格 · 将被替换</text>
          </block>
          <block wx:else>
            <text class="popup-slot-empty-text">空槽位 · 占{{item.span}}格</text>
          </block>
        </view>
      </view>
    </view>
    <view wx:if="{{ghostDrag.visible}}" class="ghost-card" style="left: {{ghostDrag.x}}px; top: {{ghostDrag.y}}px;">
      <text class="ghost-card-title">{{ghostDrag.name}}</text>
      <text class="ghost-card-hint">拖到槽位松手</text>
    </view>
  </view>

  <!-- 账单详情弹窗 -->
  <view class="bill-modal-mask" wx:if="{{modalItem}}" catchtap="onModalClose">
    <view class="bill-modal" catchtap="nop">
      <text class="bill-modal-title">{{modalItem.category}}</text>
      <view class="bill-modal-divider"></view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">类型</text>
        <text class="bill-modal-value {{modalItem.type === 'in' ? 'bill-modal-value--in' : 'bill-modal-value--out'}}">{{modalItem.typeLabel}}</text>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">分类</text>
        <input class="bill-modal-input" value="{{modalEdit.category}}" bindinput="onModalFieldEdit" data-field="category"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">金额</text>
        <input class="bill-modal-input" value="{{modalEdit.amount}}" bindinput="onModalFieldEdit" data-field="amount" type="digit"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">备注</text>
        <input class="bill-modal-input" value="{{modalEdit.note}}" bindinput="onModalFieldEdit" data-field="note"/>
      </view>
      <view class="bill-modal-row">
        <text class="bill-modal-label">日期</text>
        <text class="bill-modal-value">{{modalItem.date}}</text>
      </view>
      <view class="bill-modal-divider"></view>
      <view class="bill-modal-btns">
        <view class="bill-modal-btn bill-modal-save" bindtap="onModalSave">保存</view>
        <view wx:if="{{modalItem.typeLabel === '垫付' || modalItem.typeLabel === '应付'}}" class="bill-modal-btn bill-modal-settle" bindtap="onBillSettle" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">结清</view>
        <view wx:if="{{!modalItem._voided}}" class="bill-modal-btn bill-modal-void" bindtap="onBillVoid" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">作废</view>
        <view wx:else class="bill-modal-btn bill-modal-unvoid" bindtap="onBillUnvoid" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">恢复</view>
        <view class="bill-modal-btn bill-modal-delete" bindtap="onBillDelete" data-id="{{modalItem.id}}" data-from="{{modalFrom}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 底部 TabBar -->
  <view class="tab-bar-wrapper">
    <view class="tab-bar-center-bg"></view>
    <view class="tab-bar">
      <view class="tab-item {{index === 2 ? 'tab-item-center' : ''}}" wx:for="{{tabs}}" wx:key="index" data-index="{{index}}" bindtap="switchTab">
        <view wx:if="{{index !== 2}}" class="tab-icon"><view class="tab-icon-placeholder"></view></view>
        <text class="tab-label {{index === currentTab && !showOverview ? 'tab-label-active' : ''}}">{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
