<view class="page {{isDarkMode ? 'page--dark' : ''}} {{tabSlideDir}}">
  <!-- 标题栏 -->
  <view class="header">
    <view class="header-left-group">
      <view class="header-left" wx:if="{{showOverview && !showCustomOverview && !showCustomCategory}}">
        <picker mode="date" fields="month" value="{{overviewMonth}}" end="{{overviewMonthMax}}" bindchange="onOverviewMonthChange">
          <text class="year-text">{{overviewYear}}年</text>
          <view class="date-badge">
            <text class="date-month-num">{{overviewMonthNum}}</text>
            <text class="date-month-label">月</text>
            <view class="date-arrow"></view>
          </view>
        </picker>
      </view>
      <view class="header-back-btn" wx:if="{{!showOverview || showCustomOverview}}" bindtap="goOverview">
        <view class="back-arrow"></view>
        <text class="back-text">返回简览</text>
      </view>
    </view>
    <text class="header-title">掌柜记账</text>
    <view class="header-right-group">
      <view class="header-search">
        <view class="header-search-mic" bindlongpress="onHeaderSearchVoiceStart" bindtouchend="onHeaderSearchVoiceEnd">
          <view class="mic-head"></view>
          <view class="mic-base"></view>
        </view>
        <input class="header-search-input" placeholder="" value="{{searchText}}" bindinput="onHeaderSearchInput" confirm-type="search" bindconfirm="onHeaderSearch" />
        <view class="header-search-go" bindtap="onHeaderSearch">
          <text class="search-go-icon">↵</text>
        </view>
      </view>
      <view class="header-right-icon" bindtap="onExpandMenuTap">
        <view class="header-expand-btn">
          <view class="expand-plus"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 拓展菜单 -->
  <view class="expand-menu-overlay" wx:if="{{showExpandMenu}}" catchtap="onExpandMenuTap">
    <view class="expand-menu-card" catchtap="nop">
      <view class="expand-menu-item" bindtap="onExpandMenuItem" data-action="scan">
        <view class="expand-menu-icon expand-menu-icon--scan">
          <text class="expand-icon-text">+</text>
        </view>
        <text class="expand-menu-label">扫描凭证记账</text>
        <text class="expand-menu-arrow">></text>
      </view>
      <view class="expand-menu-item" bindtap="onExpandMenuItem" data-action="category">
        <view class="expand-menu-icon expand-menu-icon--category">
          <text class="expand-icon-text expand-icon-text--cat">::</text>
        </view>
        <text class="expand-menu-label">自定义分类</text>
        <text class="expand-menu-arrow">></text>
      </view>
      <view class="expand-menu-divider"></view>
      <view class="expand-menu-item" bindtap="onExpandMenuItem" data-action="ai">
        <view class="expand-menu-icon expand-menu-icon--ai">
          <text class="expand-icon-text expand-icon-text--ai">*</text>
        </view>
        <text class="expand-menu-label">AI 对话</text>
        <text class="expand-menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 卡片网格区 -->
  <view class="card-grid">

    <!-- ===== 自定义简览页 ===== -->
    <block wx:if="{{showCustomOverview && showOverview}}">
      <view class="custom-overview-container">
        <view class="card grid-span-3 my-card custom-edit-card">
          <view class="custom-cat-header">
            <view class="custom-cat-back" bindtap="onExitEditMode">
              <view class="custom-cat-back-arrow"></view>
            </view>
            <text class="custom-cat-title">{{t.custom_overview_title}}</text>
          </view>
          <scroll-view class="custom-edit-canvas" scroll-y enhanced show-scrollbar="{{false}}">
            <!-- 占1格卡片 -->
            <view class="custom-section-label">占 1 格</view>
            <view class="custom-card-row">
              <block wx:for="{{span1Templates}}" wx:key="id">
                <view class="custom-template-card custom-template-card--span1" bindtouchstart="onTemplateTouchStart" bindtouchmove="onDragOverlayMove" bindtouchend="onDragOverlayEnd" data-id="{{item.id}}">
                  <view class="custom-glass-inner custom-glass-inner--s1">
                    <view class="custom-tpl-card custom-tpl-card--span1">
                      <view class="card-header">
                        <image class="card-avatar" wx:if="{{item.hasAvatar && avatarDisplay}}" src="{{avatarDisplay}}" mode="aspectFill"></image>
              <view class="card-avatar card-avatar--empty" wx:elif="{{item.hasAvatar}}"></view>
                        <text class="card-title">{{item.name}}</text>
                        <text class="card-subtitle">{{item.subtitle}}</text>
                      </view>
                      <view class="card-divider card-divider--down"></view>
                      <!-- 折线图预览（参照报表页 stock chart：净值线 + 绿红块 + 图例） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_line'}}">
                        <view class="mini-chart mini-chart--line">
                          <view class="mini-dot" style="left: 4%; bottom: 24%;"></view>
                          <view class="mini-dot" style="left: 18%; bottom: 50%;"></view>
                          <view class="mini-dot" style="left: 32%; bottom: 32%;"></view>
                          <view class="mini-dot" style="left: 46%; bottom: 56%;"></view>
                          <view class="mini-dot" style="left: 60%; bottom: 20%;"></view>
                          <view class="mini-dot" style="left: 74%; bottom: 44%;"></view>
                          <view class="mini-dot" style="left: 88%; bottom: 36%;"></view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <!-- 柱状图预览（参照报表页 bar chart：绿红柱对 + 虚线分隔） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_bar'}}">
                        <view class="mini-chart mini-chart--bar">
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 18rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 24rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 30rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 14rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 22rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 20rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 14rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 28rpx;"></view>
                          </view>
                          <view class="mini-bar-sep"></view>
                          <view class="mini-bar-group">
                            <view class="mini-bar mini-bar--green" style="height: 26rpx;"></view>
                            <view class="mini-bar mini-bar--red" style="height: 18rpx;"></view>
                          </view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <!-- 饼状图预览（参照报表页 pie chart：多色分段圆） -->
                      <view class="custom-tpl-chart-preview" wx:if="{{item.previewStyle === 'chart_pie'}}">
                        <view class="mini-chart mini-chart--pie">
                          <view class="mini-pie"></view>
                        </view>
                        <view class="mini-legend">
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--green"></view>
                            <text>收入</text>
                          </view>
                          <view class="mini-legend-item">
                            <view class="mini-legend-dot mini-legend-dot--red"></view>
                            <text>支出</text>
                          </view>
                        </view>
                      </view>
                      <block wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                        <block wx:if="{{!row.threeCol}}">
                          <view class="card-row">
                            <text class="row-label">{{row.label}}</text>
                            <view class="value-tag {{row.color}}">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{row.value}}</text>
                            </view>
                          </view>
                        </block>
                        <block wx:else>
                          <view class="card-divider card-divider--tight"></view>
                          <view class="card-row three-col">
                            <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
                          </view>
                          <view class="card-row three-col">
                            <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{val}}</text>
                            </view>
                          </view>
                        </block>
                      </block>
                    </view>
                  </view>
                </view>
              </block>
            </view>
            <!-- 占2格卡片 -->
            <view class="custom-section-label">占 2 格</view>
            <view class="custom-card-row">
              <block wx:for="{{span2Templates}}" wx:key="id">
                <view class="custom-template-card custom-template-card--span2" bindtouchstart="onTemplateTouchStart" bindtouchmove="onDragOverlayMove" bindtouchend="onDragOverlayEnd" data-id="{{item.id}}">
                  <view class="custom-glass-inner custom-glass-inner--s2">
                    <!-- 明细页风格：交易流水列表截断 -->
                    <view class="custom-tpl-card custom-tpl-card--span2" wx:if="{{item.previewStyle === 'detail'}}">
                      <view class="custom-tpl-detail-head">
                        <text class="custom-tpl-detail-title">{{item.name}}</text>
                        <view class="custom-tpl-detail-toggle">
                          <text class="custom-tpl-toggle-item custom-tpl-toggle-item--active">个人</text>
                          <text class="custom-tpl-toggle-item">公司</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-period">
                        <text class="custom-tpl-period-item custom-tpl-period-item--active">月度</text>
                        <text class="custom-tpl-period-item">季度</text>
                        <text class="custom-tpl-period-item">年度</text>
                        <text class="custom-tpl-period-item">日度</text>
                      </view>
                      <view class="custom-tpl-detail-date-row">
                        <text class="custom-tpl-detail-date-tag">2026年06月</text>
                        <view class="custom-tpl-detail-inout">
                          <text class="custom-tpl-inout-dot custom-tpl-inout-dot--in"></text>
                          <text class="custom-tpl-inout-label">收入</text>
                          <text class="custom-tpl-inout-dot custom-tpl-inout-dot--out"></text>
                          <text class="custom-tpl-inout-label">支出</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-cols">
                        <text class="custom-tpl-col-hd" style="width: 50rpx">分类</text>
                        <text class="custom-tpl-col-hd" style="width: 44rpx">类型</text>
                        <text class="custom-tpl-col-hd" style="flex: 1">备注</text>
                        <text class="custom-tpl-col-hd" style="width: 56rpx; text-align: right">金额</text>
                        <text class="custom-tpl-col-hd" style="width: 64rpx; text-align: right">日期</text>
                      </view>
                      <view class="custom-tpl-detail-bills">
                        <view class="custom-tpl-bill-row" wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                          <view class="custom-tpl-bill-dot"></view>
                          <text class="custom-tpl-bill-cat">{{row.label}}</text>
                          <text class="custom-tpl-bill-type">收入</text>
                          <text class="custom-tpl-bill-note">-</text>
                          <text class="custom-tpl-bill-val {{row.color === 'green' ? 'custom-tpl-bill-val--in' : 'custom-tpl-bill-val--out'}}">¥{{row.value}}</text>
                          <text class="custom-tpl-bill-date">06-10</text>
                        </view>
                      </view>
                      <view class="custom-tpl-detail-cut">...</view>
                    </view>
                    <!-- 简览页风格：card rows -->
                    <view class="custom-tpl-card custom-tpl-card--span2" wx:else>
                      <view class="card-header">
                        <text class="card-title">{{item.name}}</text>
                        <text class="card-subtitle">{{item.subtitle}}</text>
                      </view>
                      <view class="card-divider card-divider--down"></view>
                      <block wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
                        <block wx:if="{{!row.threeCol}}">
                          <view class="card-row">
                            <text class="row-label">{{row.label}}</text>
                            <view class="value-tag {{row.color}}">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{row.value}}</text>
                            </view>
                          </view>
                        </block>
                        <block wx:else>
                          <view class="card-divider card-divider--tight"></view>
                          <view class="card-row three-col">
                            <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
                          </view>
                          <view class="card-row three-col">
                            <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                              <text class="value-yen">¥</text>
                              <text class="value-num">{{val}}</text>
                            </view>
                          </view>
                        </block>
                      </block>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </scroll-view>
        </view>
      </view>
    </block>

    <!-- ===== 拖放全屏遮罩（触摸模板卡片后出现，松手消失） ===== -->
    <view class="drag-overlay" wx:if="{{dragFloat.visible}}">
      <view class="drag-float-card" style="left: {{dragFloat.x}}px; top: {{dragFloat.y}}px;">
        <text class="drag-float-name">{{dragFloat.name}}</text>
        <text class="drag-float-sub" wx:if="{{dragFloat.subtitle}}">{{dragFloat.subtitle}}</text>
      </view>
    </view>
    <!-- ===== 槽位弹窗（拖动浮现，松手后保留） ===== -->
    <view class="slot-modal-mask" wx:if="{{showSlotModal}}" catchtap="">
      <view class="slot-modal" id="slotModalContent">
        <text class="slot-modal-title">拖放卡片到卡槽</text>
        <view class="slot-list">
          <view class="slot-item {{slotHover === item.index ? 'slot-item--hover' : ''}} {{item.card ? 'slot-item--filled' : ''}} slot-item--h{{item.height}}"
                wx:for="{{slotLayout}}" wx:key="index" wx:for-item="item">
            <block wx:if="{{item.card}}">
              <text class="slot-card-name">{{item.card.name}}</text>
              <text class="slot-card-sub">{{item.card.subtitle}}</text>
              <text class="slot-card-span">占 {{item.card.span}} 格</text>
            </block>
            <block wx:else>
              <text class="slot-placeholder">卡槽 {{item.index + 1}}</text>
            </block>
          </view>
        </view>
        <view class="slot-modal-btns">
          <view class="slot-btn slot-btn--cancel" bindtap="onSlotCancel"><text>取消</text></view>
          <view class="slot-btn slot-btn--confirm" bindtap="onSlotConfirm"><text>确认</text></view>
        </view>
      </view>
    </view>

    <!-- ===== 默认简览（动态渲染 overviewCards） ===== -->
    <block wx:if="{{!showCustomOverview && showOverview}}">
      <view class="card grid-span-{{item.span}}" wx:for="{{overviewCards}}" wx:key="id" bindtap="onOverviewCardTap" data-type="{{item.type}}">
        <view class="card-header {{item.span >= 2 ? 'compact' : ''}}">
          <image class="card-avatar" wx:if="{{item.hasAvatar && avatarDisplay}}" src="{{avatarDisplay}}" mode="aspectFill"></image>
              <view class="card-avatar card-avatar--empty" wx:elif="{{item.hasAvatar}}"></view>
          <text class="card-title">{{item.name}}</text>
          <text class="card-arrow">〉</text>
          <text class="card-subtitle">{{item.subtitle}}</text>
        </view>
        <view class="card-divider card-divider--down"></view>
        <!-- 折线图 canvas（复用报表页 drawStockChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_line'}}" type="2d" id="ovLine_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 柱状图 canvas（复用报表页 drawBarChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_bar'}}" type="2d" id="ovBar_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 饼状图 canvas（复用报表页 drawPieChart） -->
        <canvas wx:if="{{item.previewStyle === 'chart_pie'}}" type="2d" id="ovPie_{{item.id}}" class="overview-canvas"></canvas>
        <!-- 非图表卡片：渲染 rows（简览/汇总样式） -->
        <block wx:if="{{!item.previewStyle || item.previewStyle === 'overview'}}" wx:for="{{item.rows}}" wx:key="label" wx:for-item="row">
          <block wx:if="{{!row.threeCol}}">
            <view class="card-row">
              <text class="row-label">{{row.label}}</text>
              <view class="value-tag {{row.color}}">
                <text class="value-yen">¥</text>
                <text class="value-num">{{row.value}}</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view class="card-divider card-divider--tight"></view>
            <view class="card-row three-col">
              <text class="col-label" wx:for="{{row.labels}}" wx:key="*this" wx:for-item="lbl">{{lbl}}</text>
            </view>
            <view class="card-row three-col">
              <view class="value-tag {{row.colors[ci]}}" wx:for="{{row.values}}" wx:key="*this" wx:for-item="val" wx:for-index="ci">
                <text class="value-yen">¥</text>
                <text class="value-num">{{val}}</text>
              </view>
            </view>
          </block>
        </block>
        <!-- 明细页风格：真实流水截断列表 -->
        <block wx:if="{{item.previewStyle === 'detail'}}">
          <view class="ov-detail-cols">
            <text class="ov-detail-col" style="width:64rpx">分类</text>
            <text class="ov-detail-col" style="width:52rpx">类型</text>
            <text class="ov-detail-col" style="flex:1">备注</text>
            <text class="ov-detail-col" style="width:88rpx;text-align:right">金额</text>
            <text class="ov-detail-col" style="width:72rpx;text-align:right">日期</text>
          </view>
          <view class="ov-detail-row" wx:for="{{item.previewItems}}" wx:key="index" wx:for-item="bill">
            <view class="ov-detail-dot {{bill.type === 'in' ? 'ov-detail-dot--in' : 'ov-detail-dot--out'}}"></view>
            <text class="ov-detail-cat">{{bill.category}}</text>
            <text class="ov-detail-type">{{bill.typeLabel}}</text>
            <text class="ov-detail-note">{{bill.note}}</text>
            <text class="ov-detail-val {{bill.type === 'in' ? 'ov-detail-val--in' : 'ov-detail-val--out'}}">¥{{bill.amount}}</text>
            <text class="ov-detail-date">{{bill.dateShort}}</text>
          </view>
          <view class="ov-detail-empty" wx:if="{{!item.previewItems || item.previewItems.length === 0}}">暂无流水</view>
          <view class="ov-detail-cut" wx:if="{{item.previewItems.length >= 4}}">···</view>
        </block>
      </view>
    </block>

    <!-- ===== 非简览页：各 Tab 内容 ===== -->
    <block wx:if="{{!showOverview}}">

    <!-- Tab 0: 明细 -->
    <block wx:if="{{currentTab === 0}}">
      <view class="card grid-span-3 detail-card">
        <view class="detail-header">
          <text class="detail-title">明细</text>
          <view class="report-type-toggle" bindtap="switchDetailType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{detailType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{detailType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{detailType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="report-period-bar">
          <view class="report-period-item {{detailPeriod === 0 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{0}}">
            <text class="report-period-text {{detailPeriod === 0 ? 'report-period-text--active' : ''}}">月度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 1 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{1}}">
            <text class="report-period-text {{detailPeriod === 1 ? 'report-period-text--active' : ''}}">季度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 2 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{2}}">
            <text class="report-period-text {{detailPeriod === 2 ? 'report-period-text--active' : ''}}">年度</text>
          </view>
          <view class="report-period-item {{detailPeriod === 3 ? 'report-period-item--active' : ''}}" bindtap="switchDetailPeriod" data-period="{{3}}">
            <text class="report-period-text {{detailPeriod === 3 ? 'report-period-text--active' : ''}}">日度</text>
          </view>
        </view>
        <view class="detail-list-area">
          <view class="detail-date-row">
            <picker wx:if="{{detailPeriod === 0}}" mode="date" fields="month" value="{{detailPickerDate}}" end="{{maxDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 1}}" mode="multiSelector" range="{{reportQuarterRange}}" value="{{reportQuarterMultiIndex}}" bindchange="onDetailQuarterChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 2}}" mode="date" fields="year" value="{{detailPickerDate}}" end="{{maxDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{detailPeriod === 3}}" mode="date" value="{{detailPickerDate}}" end="{{maxDate}}" bindchange="onDetailPickerChange">
              <view class="detail-date-box">
                <text class="report-date-text">{{detailDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <view class="detail-inout-box">
              <view class="report-inout-item">
                <view class="report-dot report-dot--green"></view>
                <text class="report-inout-label">收入</text>
              </view>
              <view class="report-inout-item">
                <view class="report-dot report-dot--red"></view>
                <text class="report-inout-label">支出</text>
              </view>
            </view>
          </view>
          <scroll-view class="detail-list" scroll-y enhanced show-scrollbar="{{false}}">
            <block wx:for="{{detailGroups}}" wx:key="dateLabel" wx:for-item="group">
              <view class="date-group-header">
                <text class="date-group-label">{{group.dateLabel}}</text>
              </view>
              <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item" class="bill-row">
                <view class="bill-actions">
                  <view wx:if="{{item.typeLabel === '应付' && item.settleStatus !== 'settled'}}" class="bill-act-btn bill-act-settle" catchtap="onBillSettle" data-id="{{item.id}}" data-from="detail">结清</view>
                  <view wx:elif="{{item.typeLabel === '垫付' && item.settleStatus === 'company_settled'}}" class="bill-act-btn bill-act-confirm" catchtap="onBillSettle" data-id="{{item.id}}" data-from="detail">确认到账</view>
                  <view wx:if="{{!item._autoSettle && item.typeLabel !== '垫付' && item.settleStatus !== 'settled' && item.scope !== 'company'}}" class="bill-act-btn bill-act-delete" catchtap="onBillDelete" data-id="{{item.id}}" data-from="detail">删除</view>
                  <view wx:if="{{!item._autoSettle && !item._voided && item.settleStatus !== 'settled'}}" class="bill-act-btn bill-act-void" catchtap="onBillVoid" data-id="{{item.id}}" data-from="detail">作废</view>
                  <view wx:elif="{{!item._autoSettle && item._voided}}" class="bill-act-btn bill-act-unvoid" catchtap="onBillUnvoid" data-id="{{item.id}}" data-from="detail">恢复</view>
                </view>
                <view class="bill-item {{item.typeLabel === '垫付' ? 'bill-item--advance' : ''}} {{item.typeLabel === '应付' ? 'bill-item--payable' : ''}} {{(item._voided || item.settleStatus === 'settled') ? 'bill-item--voided' : ''}} {{item.settleStatus === 'company_settled' ? 'bill-item--pending-confirm' : ''}}"
                      bindtouchstart="onBillTouchStart"
                      bindtouchmove="onBillTouchMove"
                      bindtouchend="onBillTouchEnd"
                      bindtap="onBillTap"
                      data-id="{{item.id}}"
                      data-from="detail">
                  <text class="bill-icon">{{item._icon}}</text>
                  <text class="bill-type">{{item.typeLabel}}</text>
                  <text wx:if="{{item.settleStatus === 'company_settled'}}" class="bill-settle-tag bill-settle-tag--pending">待确认</text>
                  <text wx:elif="{{item.settleStatus === 'settled'}}" class="bill-settle-tag bill-settle-tag--auto">结清</text>
                  <text wx:if="{{item.target}}" class="bill-target {{item.targetType === 'internal' ? 'bill-target--internal' : 'bill-target--external'}}">{{item.target}}</text>
                  <text class="bill-note-inline">{{item.note || '-'}}</text>
                  <text class="bill-amount {{item.type === 'in' ? 'bill-amount--in' : 'bill-amount--out'}}">¥{{item.amount}}</text>
                </view>
              </view>
            </block>
          </scroll-view>
        </view>
      </view>
    </block>

    <!-- Tab 1: 报表 -->
    <block wx:if="{{currentTab === 1}}">
      <view class="card grid-span-3 report-card">
        <view class="report-header">
          <text class="report-title">报表</text>
          <view class="report-type-toggle" bindtap="switchReportType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{reportType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{reportType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{reportType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="report-period-bar">
          <view class="report-period-item {{reportPeriod === 0 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{0}}">
            <text class="report-period-text {{reportPeriod === 0 ? 'report-period-text--active' : ''}}">月度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 1 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{1}}">
            <text class="report-period-text {{reportPeriod === 1 ? 'report-period-text--active' : ''}}">季度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 2 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{2}}">
            <text class="report-period-text {{reportPeriod === 2 ? 'report-period-text--active' : ''}}">年度</text>
          </view>
          <view class="report-period-item {{reportPeriod === 3 ? 'report-period-item--active' : ''}}" bindtap="switchReportPeriod" data-period="{{3}}">
            <text class="report-period-text {{reportPeriod === 3 ? 'report-period-text--active' : ''}}">日度</text>
          </view>
        </view>
        <view class="report-chart-area">
          <view class="report-info-row">
            <picker wx:if="{{reportPeriod === 0}}" mode="date" fields="month" value="{{reportPickerDate}}" end="{{maxDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 1}}" mode="multiSelector" range="{{reportQuarterRange}}" value="{{reportQuarterMultiIndex}}" bindchange="onReportQuarterChange" bindcolumnchange="onReportQuarterColumnChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 2}}" mode="date" fields="year" value="{{reportPickerDate}}" end="{{maxDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <picker wx:elif="{{reportPeriod === 3}}" mode="date" value="{{reportPickerDate}}" end="{{maxDate}}" bindchange="onReportPickerChange">
              <view class="report-date-box">
                <text class="report-date-text">{{reportDateText}}</text>
                <view class="report-date-arrow"></view>
              </view>
            </picker>
            <view class="report-inout-box">
              <view class="report-inout-item">
                <view class="report-dot report-dot--green"></view>
                <text class="report-inout-label">收入</text>
              </view>
              <view class="report-inout-item">
                <view class="report-dot report-dot--red"></view>
                <text class="report-inout-label">支出</text>
              </view>
            </view>
          </view>
          <view class="report-chart-tabs">
            <view class="rct-tab {{reportChartType === 0 ? 'rct-tab--active' : ''}}" bindtap="switchReportChart" data-t="{{0}}">折线图</view>
            <view class="rct-tab {{reportChartType === 1 ? 'rct-tab--active' : ''}}" bindtap="switchReportChart" data-t="{{1}}">柱状图</view>
            <view class="rct-tab {{reportChartType === 2 ? 'rct-tab--active' : ''}}" bindtap="switchReportChart" data-t="{{2}}">饼图</view>
          </view>
          <view class="report-chart-stage">
            <view wx:if="{{reportChartType === 0 && !showExpandMenu && !showCamera && !scanRecognizing && !showBookPopup && !modalItem && !showAiChat && !aiRecording && !searchRecording}}" class="report-chart-block">
              <canvas type="2d" id="lineChart" class="report-canvas" bindtouchstart="onChartTap"></canvas>
            </view>
            <view wx:elif="{{reportChartType === 1 && !showExpandMenu && !showCamera && !scanRecognizing && !showBookPopup && !modalItem && !showAiChat && !aiRecording && !searchRecording}}" class="report-chart-block">
              <canvas type="2d" id="barChart" class="report-canvas"></canvas>
            </view>
            <view wx:elif="{{reportChartType === 2 && !showExpandMenu && !showCamera && !scanRecognizing && !showBookPopup && !modalItem && !showAiChat && !aiRecording && !searchRecording}}" class="report-pie-block">
              <view class="report-pie-row">
                <view class="report-pie-cell">
                  <text class="report-pie-label">收入来源</text>
                  <canvas type="2d" id="pieIncome" class="report-pie-canvas" bindtouchstart="onPieIncomeTap"></canvas>
                </view>
                <view class="report-pie-cell">
                  <text class="report-pie-label">支出类别</text>
                  <canvas type="2d" id="pieExpense" class="report-pie-canvas" bindtouchstart="onPieExpenseTap"></canvas>
                </view>
              </view>
            </view>
          </view>
          <!-- 报表筛选汇总：图表下方独立滚动区；分类拆解 proUnlocked 预留鉴权 -->
          <scroll-view class="report-summary-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="report-summary">
            <view class="rsum-totals">
              <view class="rsum-tot">
                <text class="rsum-tot-label">总收入</text>
                <text class="rsum-tot-val rsum-tot-val--in">{{reportSummary.income}}</text>
              </view>
              <view class="rsum-tot">
                <text class="rsum-tot-label">总支出</text>
                <text class="rsum-tot-val rsum-tot-val--out">{{reportSummary.expense}}</text>
              </view>
              <view class="rsum-tot">
                <text class="rsum-tot-label">结余</text>
                <text class="rsum-tot-val {{reportSummary.balanceNeg ? 'rsum-tot-val--out' : 'rsum-tot-val--in'}}">{{reportSummary.balance}}</text>
              </view>
            </view>
            <view wx:if="{{reportSummary.empty}}" class="rsum-empty">本期暂无记录</view>
            <block wx:elif="{{reportSummary.proUnlocked}}">
              <view wx:if="{{reportSummary.expenseCats.length}}" class="rsum-group">
                <view class="rsum-group-title">
                  <text class="rsum-group-name">支出分类</text>
                  <text class="rsum-group-sum rsum-group-sum--out">-{{reportSummary.expense}}</text>
                </view>
                <view wx:for="{{reportSummary.expenseCats}}" wx:key="name" class="rsum-cat">
                  <text class="rsum-cat-emoji">{{item.emoji}}</text>
                  <text class="rsum-cat-name">{{item.name}}</text>
                  <view class="rsum-cat-bar"><view class="rsum-cat-bar-fill rsum-cat-bar-fill--out" style="width:{{item.pct}}%"></view></view>
                  <text class="rsum-cat-pct">{{item.pct}}%</text>
                  <text class="rsum-cat-amt rsum-cat-amt--out">{{item.amount}}</text>
                </view>
              </view>
              <view wx:if="{{reportSummary.incomeCats.length}}" class="rsum-group">
                <view class="rsum-group-title">
                  <text class="rsum-group-name">收入分类</text>
                  <text class="rsum-group-sum rsum-group-sum--in">+{{reportSummary.income}}</text>
                </view>
                <view wx:for="{{reportSummary.incomeCats}}" wx:key="name" class="rsum-cat">
                  <text class="rsum-cat-emoji">{{item.emoji}}</text>
                  <text class="rsum-cat-name">{{item.name}}</text>
                  <view class="rsum-cat-bar"><view class="rsum-cat-bar-fill rsum-cat-bar-fill--in" style="width:{{item.pct}}%"></view></view>
                  <text class="rsum-cat-pct">{{item.pct}}%</text>
                  <text class="rsum-cat-amt rsum-cat-amt--in">{{item.amount}}</text>
                </view>
              </view>
            </block>
            <!-- 预留：未解锁分类拆解时显示（后期接入鉴权后作为升级引导入口） -->
            <view wx:else class="rsum-locked">升级后可查看分类明细</view>
            <view class="rsum-footer">
              <text class="rsum-more-tip">更多详细请导出报表</text>
              <view class="rsum-export-btn" bindtap="onExportBillEntry">导出账单</view>
            </view>
          </view>
        </scroll-view>
        </view>
      </view>
    </block>

    <!-- Tab 2: 记账 -->
    <block wx:if="{{currentTab === 2}}">
      <view class="card grid-span-1 book-entry-card" bindtap="onBookEntry" data-type="income">
        <view class="book-entry-dot book-entry-dot--in"></view>
        <text class="book-entry-text">收入</text>
      </view>
      <view class="card grid-span-1 book-entry-card" bindtap="onBookEntry" data-type="expense">
        <view class="book-entry-dot book-entry-dot--out"></view>
        <text class="book-entry-text">支出</text>
      </view>
      <view class="card grid-span-1 book-entry-card" bindtap="onBookEntry" data-type="transfer">
        <view class="book-entry-dot book-entry-dot--transfer"></view>
        <text class="book-entry-text">转账</text>
      </view>
    </block>

    <!-- Tab 3: 结清 -->
    <block wx:if="{{currentTab === 3}}">
      <view class="card grid-span-3 settle-card">
        <view class="settle-header">
          <view>
            <text class="settle-title">结清</text>
            <view class="settle-subtitle">{{settleType === 0 ? '个人垫付 · 应付' : '公司垫付 · 应付'}}</view>
          </view>
          <view class="report-type-toggle" bindtap="switchSettleType">
            <view class="report-type-bg"></view>
            <view class="report-type-slider {{settleType === 1 ? 'report-type-slider--right' : ''}}"></view>
            <text class="report-type-text {{settleType === 0 ? 'report-type-text--active' : ''}}">个人</text>
            <text class="report-type-text {{settleType === 1 ? 'report-type-text--active' : ''}}">公司</text>
          </view>
        </view>
        <view class="settle-divider"></view>
        <scroll-view class="settle-list" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{settleItems}}" wx:key="id" class="bill-row">
            <view class="bill-actions">
              <view wx:if="{{item.typeLabel === '应付'}}" class="bill-act-btn bill-act-settle" catchtap="onBillSettle" data-id="{{item.id}}" data-from="settle">结清</view>
              <view wx:elif="{{item.typeLabel === '垫付' && item.settleStatus === 'company_settled'}}" class="bill-act-btn bill-act-confirm" catchtap="onBillSettle" data-id="{{item.id}}" data-from="settle">确认到账</view>
              <view wx:if="{{item.scope !== 'company'}}" class="bill-act-btn bill-act-delete" catchtap="onBillDelete" data-id="{{item.id}}" data-from="settle">删除</view>
              <view wx:if="{{!item._voided}}" class="bill-act-btn bill-act-void" catchtap="onBillVoid" data-id="{{item.id}}" data-from="settle">作废</view>
              <view wx:else class="bill-act-btn bill-act-unvoid" catchtap="onBillUnvoid" data-id="{{item.id}}" data-from="settle">恢复</view>
            </view>
            <view class="bill-item {{item.typeLabel === '垫付' ? 'bill-item--advance' : ''}} {{item.typeLabel === '应付' ? 'bill-item--payable' : ''}} {{item._voided ? 'bill-item--voided' : ''}} {{item.settleStatus === 'company_settled' ? 'bill-item--pending-confirm' : ''}}"
                  bindtouchstart="onBillTouchStart"
                  bindtouchmove="onBillTouchMove"
                  bindtouchend="onBillTouchEnd"
                  bindtap="onBillTap"
                  data-id="{{item.id}}"
                  data-from="settle">
              <view class="bill-dot"></view>
              <text class="bill-cat">{{item.category}}</text>
              <text class="bill-type">{{item.typeLabel}}</text>
              <text wx:if="{{item.settleStatus === 'company_settled'}}" class="bill-settle-tag bill-settle-tag--pending">待确认</text>
              <text wx:if="{{item.target}}" class="bill-target {{item.targetType === 'internal' ? 'bill-target--internal' : 'bill-target--external'}}">{{item.target}}</text>
              <text class="bill-note-inline">{{item.note || '-'}}</text>
              <text class="bill-amount {{item.type === 'in' ? 'bill-amount--in' : 'bill-amount--out'}}">¥{{item.amount}}</text>
              <text class="bill-date">{{item.date}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="settle-btn" bindtap="onSettleAll">
          <text class="settle-btn-text">一键全结清</text>
        </view>
        <text class="settle-warn">* 结清后相关收支将自动转为普通流水</text>
      </view>
    </block>

    <!-- Tab 4: 我的 -->
    <block wx:if="{{currentTab === 4}}">
      <!-- VIP升级页 -->
      <view class="card grid-span-3 my-card vip-main-card" wx:if="{{showVipPage}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onVipBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/VIP.png" mode="aspectFit"/><text class="custom-cat-title">{{t.vip_subscribe}}</text></view>
        </view>
        <!-- 试用激活横幅 -->
        <view class="vip-trial-banner" wx:if="{{showTrialBanner}}">
          <view class="vip-trial-banner-bg">
            <text class="vip-trial-banner-title">新用户限时福利</text>
            <text class="vip-trial-banner-desc">领取 3 个月企业版 PRO 免费试用</text>
            <view class="vip-trial-banner-countdown">
              <text class="vip-trial-banner-countdown-num">{{trialOfferDays}}</text>
              <text class="vip-trial-banner-countdown-label">天后截止</text>
            </view>
            <text class="vip-trial-banner-date">截止日期 2026-09-25</text>
            <view class="vip-trial-banner-btn" bindtap="onActivateTrial"><text class="vip-trial-banner-btn-text">立即领取</text></view>
            <text class="vip-trial-banner-note">试用期间导出账单和凭证扫描仍有广告</text>
          </view>
        </view>
        <scroll-view class="vip-plan-list" scroll-y enhanced show-scrollbar="{{false}}">
          <!-- 三张卡垂直排列 -->
          <view class="vip-plan-card vip-plan--{{item.theme}} {{vipSelected === index ? 'vip-plan--selected' : ''}}" wx:for="{{vipCards}}" wx:key="id" wx:for-index="index" bindtap="onVipSelect" data-id="{{index}}">
            <!-- 卡片头部 -->
            <view class="vip-plan-hd">
              <view class="vip-plan-name-row">
                <text class="vip-plan-name">{{item.name}}</text>
                <text class="vip-plan-tagline">{{item.tagline}}</text>
              </view>
            </view>
            <!-- 功能列表 -->
            <view class="vip-plan-features">
              <view class="vip-plan-feat" wx:for="{{item.features}}" wx:key="*this" wx:for-item="f">
                <view class="vip-plan-feat-dot"></view>
                <text class="vip-plan-feat-text">{{f}}</text>
              </view>
            </view>
            <!-- 企业版席位选择器 -->
            <view class="vip-seats-row" wx:if="{{item.isEnterprise}}">
              <text class="vip-seats-label">席位人数</text>
              <view class="vip-seats-ctrl">
                <view class="vip-seats-btn {{vipEnterpriseSeats <= item.enterpriseSeats.min ? 'vip-seats-btn--disabled' : ''}}" catchtap="onVipSeatsMinus"><text class="vip-seats-btn-text">−</text></view>
                <text class="vip-seats-num">{{vipEnterpriseSeats}}</text>
                <view class="vip-seats-btn {{vipEnterpriseSeats >= 20 ? 'vip-seats-btn--disabled' : ''}}" catchtap="onVipSeatsPlus"><text class="vip-seats-btn-text">+</text></view>
              </view>
              <text class="vip-seats-hint">4-20人</text>
            </view>
            <!-- 价格区域 -->
            <view class="vip-plan-price">
              <block wx:if="{{item.isContact}}">
                <view class="vip-contact-btn"><text class="vip-contact-text">联系我们</text></view>
              </block>
              <block wx:elif="{{item.isEnterprise}}">
                <!-- 企业版动态价格 -->
                <view class="vip-price-row" wx:if="{{vipEnterpriseSeats <= item.enterpriseSeats.annualOnlyAbove}}">
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{item.enterpriseSeats.basePrice + (vipEnterpriseSeats - item.enterpriseSeats.min) * item.enterpriseSeats.pricePerSeat}}</text>
                  <text class="vip-price-unit">/月</text>
                </view>
                <view class="vip-price-row" wx:else>
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{(item.enterpriseSeats.basePrice + (vipEnterpriseSeats - item.enterpriseSeats.min) * item.enterpriseSeats.pricePerSeat) * 12 * item.enterpriseSeats.annualDiscount}}</text>
                  <text class="vip-price-unit">/年</text>
                  <view class="vip-annual-badge"><text class="vip-annual-badge-text">8.8折</text></view>
                </view>
                <text class="vip-price-hint" wx:if="{{vipEnterpriseSeats > item.enterpriseSeats.annualOnlyAbove}}">超过10人仅提供年费</text>
                <text class="vip-per-seat-hint" wx:else>每增加1席位 +8元/月</text>
              </block>
              <block wx:else>
                <!-- 个人版固定价格 -->
                <view class="vip-price-row">
                  <text class="vip-price-yen">￥</text>
                  <text class="vip-price-int">{{item.price}}</text>
                  <text class="vip-price-unit">{{item.unit}}</text>
                </view>
              </block>
            </view>
          </view>
        </scroll-view>
        <!-- 底部确认按钮 -->
        <view class="vip-confirm-wrap" wx:if="{{vipSelected >= 0 && !vipCards[vipSelected].isContact}}">
          <view class="vip-confirm-btn" bindtap="onVipConfirm"><text class="vip-confirm-text">确认订阅</text></view>
        </view>
      </view>
      <!-- 自定义分类页 -->
      <view class="card grid-span-3 my-card custom-cat-card" wx:elif="{{showCustomCategory}}">
        <view class="custom-cat-header">
          <view class="custom-cat-back" bindtap="onCustomCategoryBack">
            <view class="custom-cat-back-arrow"></view>
          </view>
          <view class="custom-cat-right"><image class="custom-cat-icon" src="/assets/icons/fenlei.png" mode="aspectFit"/><text class="custom-cat-title">{{t.custom_cat_title}}</text></view>
        </view>
        <view class="custom-cat-divider"></view>
        <view class="custom-cat-personal-block">
          <view class="custom-cat-section-hd">
            <text class="custom-cat-section-label">个人分类</text>
            <view class="custom-cat-tabs">
              <view class="custom-cat-tab {{catTabPersonal === 'out' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="out">支出</view>
              <view class="custom-cat-tab {{catTabPersonal === 'in' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="in">收入</view>
              <view class="custom-cat-tab {{catTabPersonal === 'payForward' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="payForward">垫付</view>
              <view class="custom-cat-tab {{catTabPersonal === 'payable' ? 'custom-cat-tab--on' : ''}}" bindtap="onCatTabChange" data-scope="personal" data-tab="payable">应付</view>
            </view>
          </view>
          <view class="custom-cat-scroll-wrap">
            <scroll-view class="custom-cat-grid-scroll" scroll-y enhanced show-scrollbar="{{false}}" enable-flex>
              <view class="custom-cat-grid">
                <view class="custom-cat-item" wx:for="{{personalCategories}}" wx:key="id" wx:if="{{item.inOut === catTabPersonal}}" bindlongtap="onDeleteCategory" data-id="{{item.id}}" data-scope="personal">
                  <view class="custom-cat-icon-wrap">
                    <text class="custom-cat-emoji">{{item.emoji}}</text>
                  </view>
                  <text class="custom-cat-name">{{item.name}}</text>
                </view>
              </view>
