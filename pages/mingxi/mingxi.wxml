<view class="page {{isDarkMode ? 'page--dark' : ''}} {{isTablet ? 'page--tablet' : ''}}">
  <include src="./views/header.wxml"/>
  <!-- 卡片网格区 -->
  <view class="card-grid">
    <include src="./views/custom-overview.wxml"/>
    <include src="./views/overview.wxml"/>
    <!-- ===== 非简览页：各 Tab 内容 ===== -->
    <block wx:if="{{!showOverview}}">
      <include src="./views/tabs/detail.wxml"/>
      <include src="./views/tabs/report.wxml"/>
      <include src="./views/tabs/book-entry.wxml"/>
      <include src="./views/tabs/settle.wxml"/>
      <include src="./views/tabs/my.wxml"/>
    </block>
  </view>
  <include src="./views/overlays/overview-popup.wxml"/>
  <include src="./views/overlays/camera.wxml"/>
  <include src="./views/overlays/scan.wxml"/>
  <include src="./views/overlays/bill-detail.wxml"/>
  <include src="./views/overlays/booking.wxml"/>
  <include src="./views/overlays/assistant.wxml"/>
  <include src="./views/overlays/guide.wxml"/>
  <include src="./views/overlays/profile.wxml"/>
  <include src="./views/overlays/conflicts.wxml"/>
  <include src="./views/overlays/modals.wxml"/>
</view>
