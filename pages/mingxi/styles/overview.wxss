/* ===== 简览页网格布局（span 控制宽度占列） ===== */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
}

.overview-grid .card {
  flex: none;
}

.overview-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.overview-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.overview-grid .grid-span-3 {
  width: 100%;
}

/* ---- 卡片内部 ---- */
.card-header {
  position: relative;
  padding-left: 82rpx;
  padding-top: 12rpx;
  flex-shrink: 0;
}
.card-header.compact {
  padding-left: 0;
}
.card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #ccc;
}
.card-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.card-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
  position: absolute;
  right: 0;
  top: 0;
}
.card-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  display: block;
  margin-top: 2rpx;
}
.card-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}
.card-divider--tight {
  margin-top: -18rpx;
}
.card-divider--down {
  position: relative;
  top: 20rpx;
}

/* ---- 卡片行 ---- */
.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}
.card-row.three-col {
  justify-content: space-between;
}
.col-label {
  font-size: 37rpx;
  font-weight: 500;
  color: #a0a0a0;
  text-align: center;
  flex: 1;
}
.row-label {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* ---- 金额标签 ---- */
.value-tag {
  display: flex;
  align-items: baseline;
  white-space: nowrap;
  overflow: hidden;
}
.three-col .value-tag {
  flex: 1;
  justify-content: center;
}
.value-yen {
  font-size: 34rpx;
  font-weight: 500;
}
.value-num {
  font-size: 42rpx;
  font-weight: 500;
}
.green .value-yen,
.green .value-num {
  color: #ef4444;
}
.red .value-yen,
.red .value-num {
  color: #333333;
}

/* ---- 占位卡片 ---- */
.placeholder-card {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* ---- 底部 TabBar ---- */
.tab-bar-wrapper {
  position: relative;
  height: 129rpx;
  z-index: 999;
  overflow: visible;
  flex-shrink: 0;
  margin: 0 -26rpx;
}
.tab-bar-center-btn {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-center-label {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  letter-spacing: 6rpx;
  pointer-events: none;
}
.tab-bar {
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 0;
  right: 0;
  height: 103rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding-bottom: 16rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.tab-item--push-left {
  margin-right: 24rpx;
}
.tab-item--push-right {
  margin-left: 24rpx;
}
.tab-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
  position: relative;
}
.tab-icon-center-img {
  width: 70rpx;
  height: 70rpx;
}
.tab-icon-img {
  width: 56rpx;
  height: 56rpx;
}
.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  letter-spacing: 6rpx;
}
.tab-label-active {
  color: #000;
}

/* 底部 tab 栏「我的」红点 */
.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #333333;
  border: 2rpx solid #fff;
  box-shadow: 0 0 4rpx rgba(255,59,48,0.5);
}

/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  padding: 24rpx 36rpx;
  justify-content: space-evenly;
}

.my-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 头像区 */
.my-profile {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.my-login-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* 列表项 */
.my-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
/* 图标行卡片 */
.my-icon-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 23rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}
.my-icon-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
}
.my-icon-circle-img {
  width: 100%;
  height: 100%;
}
.my-icon-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.my-icon-row-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
}

/* ---- 报表卡片 ---- */
.report-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.report-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* 个人/公司 切换钮 */
.report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 190rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.report-type-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: inset 0rpx 2rpx 6rpx rgba(0,0,0,0.15);
}
.report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 95rpx;
  height: 42rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 22rpx;
  transition: left 0.25s ease;
}
.report-type-slider--right {
  left: 95rpx;
}
.report-type-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.35);
  z-index: 1;
  transition: color 0.25s ease;
}
.report-type-text--active {
  color: #000;
}

/* 周期切换条：月度/季度/年度/日度 */
.report-period-bar {
  display: flex;
  flex-shrink: 0;
}
.report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255,255,255,0.8);
}
.report-period-item:first-child {
  border-radius: 26rpx 0 0 26rpx;
}
.report-period-item:last-child {
  border-radius: 0 26rpx 26rpx 0;
}
.report-period-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-period-item--active {
  background: rgba(0,0,0,0.06);
}
.report-period-text--active {
  color: #000;
}

/* 图表区容器 */
.report-chart-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 10rpx;
  min-height: 0;
  overflow: hidden;
}
.report-summary-scroll {
  flex: 1;
  min-height: 0;
}

/* 日期 + 收入/支出 行 */
.report-info-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}
.report-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #a0a0a0;
}
.report-date-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.8);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-inout-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.report-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.report-dot--green {
  background: #ef4444;
}
.report-dot--red {
  background: #333333;
}
.report-inout-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
}

.report-chart-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
  flex-shrink: 0;
}
.report-chart-block {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8rpx;
  position: relative;
  min-height: 240rpx;
  flex-shrink: 0;
}
.report-canvas {
  flex: 1;
  width: 100%;
  border-radius: 12rpx;
}

/* 饼状图 */
.report-pie-block {
  flex: 1;
  min-height: 310rpx;
}
.report-pie-row {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.report-pie-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.report-pie-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-pie-canvas {
  width: 300rpx;
  height: 300rpx;
}

/* ---- 结清卡片 ---- */
.settle-card {
  padding: 28rpx 30rpx 20rpx;
  gap: 0;
}
.settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.settle-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.settle-subtitle {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(160,160,160,0.63);
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}
.settle-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 10rpx 0;
  flex-shrink: 0;
}
.settle-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.settle-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.settle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.settle-dot--in {
  background: #ef4444;
}
.settle-dot--out {
  background: #333333;
}
.settle-item-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
  flex: 1;
}
.settle-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.settle-amount {
  display: flex;
  align-items: baseline;
  min-width: 180rpx;
  flex-shrink: 0;
  white-space: nowrap;
  justify-content: flex-end;
}
.settle-yen {
  font-size: 24rpx;
  font-weight: 500;
}
.settle-num {
  font-size: 30rpx;
  font-weight: 500;
}
.settle-amount--in .settle-yen,
.settle-amount--in .settle-num {
  color: #ef4444;
}
.settle-amount--out .settle-yen,
.settle-amount--out .settle-num {
  color: #333333;
}
.settle-date {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  border-radius: 44rpx;
  padding: 18rpx 0;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.settle-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}
.settle-warn {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
  text-align: center;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ---- 明细卡片 ---- */
.detail-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.detail-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.detail-list-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 0;
  overflow: hidden;
}
.detail-col-headers {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-col-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.detail-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* ---- 统一账单明细项 ---- */
.bill-header-row {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  flex-shrink: 0;
}
.bill-header-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.bill-item {
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  background: #fff;
  height: 84rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.bill-item--in {
  background: #7f1d1d;
}
.bill-item--out {
  background: #1a1a1a;
}
.bill-item--advance {
  background: #7f1d1d;
}
.bill-item--payable {
  background: #1a1a1a;
}
.bill-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #d1d1d1;
}
.bill-icon {
  font-size: 32rpx;
  line-height: 1;
  width: 44rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
  text-align: center;
}
.bill-item--in .bill-dot,
.bill-item--out .bill-dot,
.bill-item--advance .bill-dot,
.bill-item--payable .bill-dot {
  background: rgba(255,255,255,0.5);
}
.bill-cat {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  width: 70rpx;
  flex-shrink: 0;
}
.bill-item--in .bill-cat,
.bill-item--out .bill-cat,
.bill-item--advance .bill-cat,
.bill-item--payable .bill-cat {
  font-weight: 400;
  color: #d7d7d7;
}
.bill-type {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  width: 70rpx;
  flex-shrink: 0;
}
.bill-target {
  font-size: 22rpx;
  font-weight: 400;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.bill-target--internal {
  color: #8d6e1f;
  background: rgba(141, 110, 31, 0.12);
}
.bill-target--external {
  color: #666;
  background: rgba(0, 0, 0, 0.06);
}
.bill-note-inline {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}
.bill-item--in .bill-note-inline,
.bill-item--out .bill-note-inline,
.bill-item--advance .bill-note-inline,
.bill-item--payable .bill-note-inline {
  color: #d7d7d7;
}
.bill-item--in .bill-type,
.bill-item--out .bill-type,
.bill-item--advance .bill-type,
.bill-item--payable .bill-type {
  font-weight: 400;
  color: #d7d7d7;
}
.bill-amount {
  font-size: 30rpx;
  font-weight: 500;
  min-width: 220rpx;
  flex-shrink: 0;
  text-align: right;
  margin-right: 12rpx;
}
.bill-amount--in {
  color: #ef4444;
}
.bill-amount--out {
  color: #333333;
}
.bill-item--in .bill-amount,
.bill-item--out .bill-amount,
.bill-item--advance .bill-amount,
.bill-item--payable .bill-amount {
  color: #fff;
}
/* date-group-header: 日期分组标题 */
.date-group-header {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx 8rpx;
  flex-shrink: 0;
}
.date-group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
}
.bill-note {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item--in .bill-note,
.bill-item--out .bill-note {
  color: #d7d7d7;
}

/* ---- 多笔记账卡片 ---- */
.bill-item--multi {
  flex-direction: column;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f8f9fc;
}
.bill-row--multi {
  height: auto;
}
.bill-multi-main {
  display: flex;
  align-items: center;
  width: 100%;
}
.bill-multi-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.bill-multi-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.bill-multi-count {
  font-size: 24rpx;
