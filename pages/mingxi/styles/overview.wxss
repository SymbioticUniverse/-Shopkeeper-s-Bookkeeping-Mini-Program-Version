  margin-top: 2rpx;
}

/* 玻璃框底部标签 */
.custom-glass-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.custom-glass-label-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #ef4444;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #ef4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #ef4444;
}

.custom-glass-add-btn--active text {
  color: #ef4444;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}
