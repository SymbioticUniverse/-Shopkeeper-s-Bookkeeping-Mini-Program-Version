page {
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 140rpx 26rpx 0;
  box-sizing: border-box;
}

/* ===== 模式指示色带 ===== */
.mode-accent {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 30vh;
  z-index: 0;
  pointer-events: none;
  transition: background 0.35s ease;
}
.mode-accent--personal {
  background: linear-gradient(180deg, rgba(74, 138, 254, 0.10) 0%, rgba(74, 138, 254, 0.03) 50%, transparent 100%);
}
.mode-accent--company {
  background: linear-gradient(180deg, rgba(255, 50, 50, 0.50) 0%, rgba(255, 50, 50, 0.15) 50%, transparent 100%);
}
.page--dark .mode-accent--personal {
  background: linear-gradient(180deg, rgba(74, 138, 254, 0.08) 0%, rgba(74, 138, 254, 0.01) 50%, transparent 100%);
}
.page--dark .mode-accent--company {
  background: linear-gradient(180deg, rgba(255, 50, 50, 0.40) 0%, rgba(255, 50, 50, 0.10) 50%, transparent 100%);
}

