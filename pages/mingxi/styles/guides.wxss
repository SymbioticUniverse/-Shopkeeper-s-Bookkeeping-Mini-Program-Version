  color: #ffb347;
}
.op-demo-detail-tag--pending {
  background: rgba(255,179,71,0.2);
  color: #ffb347;
}
.op-demo-detail-tag--confirm {
  background: rgba(74,138,254,0.2);
  color: #4a8afe;
}
.op-demo-detail-tag--done {
  background: rgba(76,217,100,0.2);
  color: #4cd964;
}
.op-demo-action-btn {
  height: 68rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
