/* 语音记账演示 */
.op-demo-voice-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.op-demo-tab-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  width: 100%;
  padding: 8rpx 0;
}
.op-demo-tab-item {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: rgba(255,255,255,0.3);
}
.op-demo-tab-center {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.op-demo-tab-center-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a8afe, #3a7bfd);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20rpx rgba(74,138,254,0.5);
  animation: pulse 1s ease-in-out infinite;
}
.op-demo-tab-center-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 300;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 20rpx rgba(74,138,254,0.5); }
  50% { box-shadow: 0 0 36rpx rgba(74,138,254,0.8); }
}
.op-demo-press-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.op-demo-press-finger {
  font-size: 40rpx;
  animation: pressDown 1.2s ease-in-out infinite;
}
@keyframes pressDown {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(12rpx); opacity: 1; }
}
.op-demo-press-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.35);
}
.op-demo-voice-bubble {
  background: rgba(74,138,254,0.12);
  border: 1rpx solid rgba(74,138,254,0.2);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.op-demo-voice-wave {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 32rpx;
}
.op-demo-voice-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: #4a8afe;
  animation: waveAnim 0.6s ease-in-out infinite;
}
.op-demo-voice-bar:nth-child(1) { height: 50%; animation-delay: 0s; }
.op-demo-voice-bar:nth-child(2) { height: 80%; animation-delay: 0.1s; }
.op-demo-voice-bar:nth-child(3) { height: 100%; animation-delay: 0.2s; }
.op-demo-voice-bar:nth-child(4) { height: 70%; animation-delay: 0.3s; }
.op-demo-voice-bar:nth-child(5) { height: 40%; animation-delay: 0.4s; }
@keyframes waveAnim {
  0%, 100% { transform: scaleY(0.5); opacity: 0.5; }
  50% { transform: scaleY(1); opacity: 1; }
}
.op-demo-voice-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.op-demo-voice-result {
  width: 100%;
  background: rgba(76,217,100,0.08);
  border: 1rpx solid rgba(76,217,100,0.15);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.op-demo-voice-result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.op-demo-voice-result-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}
.op-demo-voice-result-val {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}
.op-demo-voice-result-val--hl {
  color: #ffb347;
  font-weight: 700;
}

/* 总结 */
.op-demo-summary {
  width: 100%;
  max-width: 500rpx;
  margin-top: 10rpx;
}
.op-demo-summary-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}
.op-demo-summary-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(74,138,254,0.2);
  color: #4a8afe;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.op-demo-summary-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.op-demo-summary-title {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.op-demo-summary-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}
.op-demo-summary-arrow {
  font-size: 24rpx;
  color: rgba(255,255,255,0.2);
  text-align: center;
  padding: 4rpx 0;
}
.op-demo-rule-box {
  width: 100%;
  max-width: 500rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}
.op-demo-rule-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  margin-bottom: 12rpx;
}
.op-demo-rule-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.8;
}
.op-demo-rule-text--dim {
  color: rgba(255,255,255,0.35);
  font-size: 22rpx;
}
.op-demo-rule-text--bold {
  color: #ffb347;
  font-weight: 600;
}
.op-demo-rule-divider {
  height: 1rpx;
  background: rgba(255,255,255,0.08);
  margin: 10rpx 0;
}

/* 底部导航 */
.op-guide-nav {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.op-guide-skip {
  font-size: 24rpx;
  color: rgba(255,255,255,0.3);
}
.op-guide-dots {
  display: flex;
  gap: 12rpx;
}
.op-guide-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  transition: background 0.2s;
}
.op-guide-dot--on {
  background: #4a8afe;
}
.op-guide-nav-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
  max-width: 500rpx;
}
.op-guide-nav-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
}
.op-guide-nav-btn--primary {
  background: #4a8afe;
  color: #fff;
  flex: 2;
}
.op-guide-nav-btn--hide {
  visibility: hidden;
}

/* 动画 */
@keyframes popIn {
  from { opacity: 0; transform: scale(0.3); }
  to { opacity: 1; transform: scale(1); }
}

