}
.page--dark .contact-gift-link-item + .contact-gift-link-item {
  border-top-color: #333 !important;
}

/* 按钮 */
.page--dark .contact-gift-btn {
  background: linear-gradient(135deg, #5a9fe8, #4a7fc4);
}

/* 弹窗/模态 */
.page--dark .popup-mask {
  background: rgba(0, 0, 0, 0.6);
}
.page--dark .popup-card,
.page--dark .cat-modal,
.page--dark .bill-modal {
