}
.page--dark .bill-item--pending-confirm {
  border-left-color: #ff9500 !important;
}
.page--dark .bill-modal-auto-tag {
  color: #66bb6a;
}
.page--dark .bill-modal-settle-info {
  color: #888;
}

/* 我的页分组 */
.page--dark .my-item {
  background: #2a2a3a !important;
}
.page--dark .my-item + .my-item {
  border-top-color: #333 !important;
}

/* VIP 卡片 */
.page--dark .vip-plan-card {
  background: #2a2a3a !important;
}

/* header */
.page--dark .header {
  background: transparent;
}

/* 卡片玻璃效果 */
.page--dark .glass-card {
  background: rgba(30, 30, 46, 0.85);
}

/* 明细/结清条目 */
.page--dark .bill-item,
.page--dark .settle-item {
  background: #2a2a3a !important;
}
.page--dark .bill-item + .bill-item,
.page--dark .settle-item + .settle-item {
  border-top-color: #333 !important;
}

/* 报表期间栏 */
.page--dark .report-period-bar {
  background: #2a2a3a;
}
.page--dark .report-period-item--active {
  background: #4a7fc4;
}

/* 隐私政策页 */
.privacy-policy-body {
  padding: 8rpx 0 40rpx 0;
}

.privacy-policy-update {
  display: block;
  font-size: 24rpx;
  color: #a0a0a0;
  margin-bottom: 28rpx;
}

.privacy-policy-section {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  margin-top: 24rpx;
}

.privacy-policy-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.page--dark .privacy-policy-section {
  color: #e0e0e0;
}
.page--dark .privacy-policy-text {
  color: #888;
}
.page--dark .privacy-policy-update {
  color: #888;
}
