  text-align: center;
  line-height: 1.6;
}

.about-info-row {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 12rpx 0;
}

.about-info-label {
  font-size: 28rpx;
  color: #a0a0a0;
  width: 120rpx;
}

.about-info-value {
  font-size: 28rpx;
  color: #333;
}

.about-copyright {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 16rpx;
}

/* 输入框 */
.page--dark .contact-gift-textarea,
.page--dark .contact-gift-links {
  background: #2a2a3a;
}
.page--dark .contact-gift-textarea {
  color: #e0e0e0;
}

/* 分割线 */
