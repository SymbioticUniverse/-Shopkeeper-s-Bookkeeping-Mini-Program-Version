/* ---- 报表筛选汇总 ---- */
.report-summary {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  margin-top: 16rpx;
  padding: 22rpx 22rpx 8rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}
.rsum-totals {
  display: flex;
}
.rsum-tot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.rsum-tot + .rsum-tot::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}
.rsum-tot-label {
  font-size: 22rpx;
  color: #a0a0a0;
}
.rsum-tot-val {
  font-size: 36rpx;
  font-weight: 700;
}
.rsum-tot-val--in { color: #ef4444; }
.rsum-tot-val--out { color: #333333; }
.rsum-empty,
.rsum-locked {
  margin-top: 8rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b8b8b8;
}
.rsum-group {
  margin-top: 24rpx;
}
.rsum-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.rsum-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.rsum-group-sum {
  font-size: 26rpx;
  font-weight: 600;
}
.rsum-group-sum--in { color: #ef4444; }
.rsum-group-sum--out { color: #333333; }
.rsum-cat {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.rsum-cat + .rsum-cat {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}
.rsum-cat-emoji {
  width: 40rpx;
  font-size: 28rpx;
  text-align: center;
}
.rsum-cat-name {
  width: 132rpx;
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rsum-cat-bar {
  flex: 1;
  height: 12rpx;
  margin: 0 16rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
}
.rsum-cat-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  min-width: 4rpx;
}
.rsum-cat-bar-fill--in { background: #ef4444; }
.rsum-cat-bar-fill--out { background: #333333; }
.rsum-cat-pct {
  width: 60rpx;
  font-size: 22rpx;
  color: #a0a0a0;
  text-align: right;
}
.rsum-cat-amt {
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}
.rsum-cat-amt--in { color: #ef4444; }
.rsum-cat-amt--out { color: #333333; }

.page--dark .report-summary {
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}
.page--dark .rsum-tot + .rsum-tot::before { background: rgba(255, 255, 255, 0.08); }
.page--dark .rsum-group-name,
.page--dark .rsum-cat-name { color: #e6e6e6; }
.page--dark .rsum-cat + .rsum-cat { border-top-color: rgba(255, 255, 255, 0.06); }
.page--dark .rsum-cat-bar { background: rgba(255, 255, 255, 0.08); }
.page--dark .rsum-tot-label,
.page--dark .rsum-cat-pct,
.page--dark .rsum-empty,
.page--dark .rsum-locked { color: #888; }

/* ---- 报表图表三合一：切换 tab + 共用舞台 ---- */
.report-chart-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 6rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 14rpx;
}
.rct-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #a0a0a0;
  border-radius: 10rpx;
  transition: color 0.2s, background 0.2s;
}
.rct-tab--active {
  color: #fff;
  background: #ef4444;
  font-weight: 600;
}
.report-chart-stage {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  min-height: 360rpx;
}
.page--dark .report-chart-tabs { background: rgba(255, 255, 255, 0.06); }
.page--dark .rct-tab { color: #888; }
.page--dark .rct-tab--active { color: #fff; background: #ef4444; }

/* ---- 报表汇总底部：导出引导 ---- */
.rsum-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 0 8rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}
.rsum-more-tip {
  font-size: 22rpx;
  color: #b0b0b0;
}
.rsum-export-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #ef4444;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 208, 66, 0.25);
}
.rsum-export-btn:active { opacity: 0.85; }
.page--dark .rsum-footer { border-top-color: rgba(255, 255, 255, 0.06); }

/* ---- 冲突解决面板 ---- */
.conflict-panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.conflict-panel {
  width: 620rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.12);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow-y: auto;
}
.conflict-panel-header { text-align: center; }
.conflict-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  display: block;
}
.conflict-panel-subtitle {
  font-size: 24rpx;
  color: #a0a0a0;
  margin-top: 6rpx;
  display: block;
}
.conflict-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.conflict-progress-text {
  font-size: 22rpx;
  color: #a0a0a0;
  flex-shrink: 0;
}
.conflict-progress-bar {
  flex: 1;
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
}
.conflict-progress-fill {
  height: 100%;
  background: #ef4444;
  border-radius: 3rpx;
  transition: width 0.3s;
}
.conflict-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.conflict-reason {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff3cd;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.conflict-reason-icon {
  width: 36rpx;
  height: 36rpx;
  background: #ff9500;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.conflict-reason-text {
  font-size: 24rpx;
  color: #856404;
  flex: 1;
}
.conflict-version {
  background: #f8f9fa;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.conflict-version--deleted {
  background: #fef2f2;
  border: 1rpx dashed #fca5a5;
}
.conflict-version-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.conflict-version-label {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.conflict-version-label--local {
  background: #e3f2fd;
  color: #1565c0;
}
.conflict-version-label--server {
  background: #e8f5e9;
  color: #2e7d32;
}
.conflict-version-label--deleted {
  background: #fef2f2;
  color: #dc2626;
}
.conflict-version-badge {
  font-size: 18rpx;
  color: #ff9500;
  background: #fff3cd;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.conflict-item-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.conflict-item-icon { font-size: 28rpx; }
.conflict-item-cat { font-size: 26rpx; font-weight: 500; color: #333; }
.conflict-item-type { font-size: 22rpx; color: #a0a0a0; margin-left: auto; }
.conflict-item-amount { font-size: 34rpx; font-weight: 700; }
.conflict-amount--in { color: #ef4444; }
.conflict-amount--out { color: #333333; }
.conflict-item-date { font-size: 22rpx; color: #a0a0a0; }
.conflict-item-note { font-size: 24rpx; color: #666; }
.conflict-deleted-hint { font-size: 24rpx; color: #dc2626; }
.conflict-vs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 40rpx;
}
.conflict-vs-line { flex: 1; height: 1rpx; background: #e0e0e0; }
.conflict-vs-text { font-size: 22rpx; color: #ccc; font-weight: 600; }
.conflict-btns { display: flex; gap: 16rpx; }
.conflict-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #e0e0e0;
  color: #666;
  background: #fff;
}
.conflict-btn--local { border-color: #1565c0; color: #1565c0; }
.conflict-btn--server { border-color: #2e7d32; color: #2e7d32; }
.conflict-btn--active.conflict-btn--local { background: #1565c0; color: #fff; }
.conflict-btn--active.conflict-btn--server { background: #2e7d32; color: #fff; }
.conflict-resolved-tag { font-size: 22rpx; color: #ef4444; text-align: center; }
.conflict-nav { display: flex; align-items: center; gap: 16rpx; }
.conflict-nav-btn {
  width: 120rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
}
.conflict-nav-btn--disabled { opacity: 0.3; }
.conflict-nav-dots {
  flex: 1;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}
.conflict-nav-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e0e0e0;
}
.conflict-nav-dot--active { background: #333; }
.conflict-nav-dot--resolved { background: #ef4444; }
.conflict-apply {
  height: 80rpx;
  background: #ef4444;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.conflict-apply--loading { opacity: 0.6; }

/* 深色模式 */
.page--dark .conflict-panel { background: #1c1c1e; }
.page--dark .conflict-panel-title { color: #fff; }
.page--dark .conflict-version { background: #2c2c2e; }
.page--dark .conflict-item-cat { color: #fff; }
.page--dark .conflict-reason { background: #3a2e00; }
.page--dark .conflict-reason-text { color: #fbbf24; }
.page--dark .conflict-btn { background: #2c2c2e; border-color: #555; color: #ccc; }
.page--dark .conflict-nav-btn { background: #2c2c2e; color: #ccc; }
.page--dark .conflict-nav-dot { background: #555; }
.page--dark .conflict-nav-dot--active { background: #fff; }
.page--dark .conflict-progress-bar { background: #3a3a3c; }
.page--dark .rsum-more-tip { color: #888; }
.page--dark .bill-modal-multi-title { color: #7eb8ff; }
.page--dark .bill-modal-multi-date { color: #888; }
.page--dark .bill-modal-multi-amount { color: #ddd; }
.page--dark .bill-modal-multi-idx { color: #777; }

/* ===== 自定义 Modal（替代 wx.showModal） ===== */
.cu-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cuModalFadeIn 0.22s ease;
}
@keyframes cuModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.cu-modal {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.16);
  overflow: hidden;
  animation: cuModalScaleIn 0.25s cubic-bezier(0.32, 0.72, 0, 1);
}
@keyframes cuModalScaleIn {
  from { opacity: 0; transform: scale(0.88); }
  to { opacity: 1; transform: scale(1); }
}
.cu-modal-title {
  padding: 44rpx 36rpx 0;
  text-align: center;
  font-size: 37rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
}
.cu-modal-body {
  padding: 20rpx 36rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #888;
  line-height: 1.7;
  white-space: pre-wrap;
}
.cu-modal-input-wrap {
  margin: 28rpx 36rpx 0;
}
.cu-modal-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
  background: #f7f8fa;
  border-radius: 20rpx;
  box-sizing: border-box;
  text-align: center;
  letter-spacing: 4rpx;
}
.cu-modal-input-ph {
  color: #bbb;
  letter-spacing: 0;
}
.cu-modal-btns {
  display: flex;
  margin-top: 36rpx;
  border-top: 1rpx solid #f0f0f0;
}
.cu-modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 32rpx;
  line-height: 1.4;
}
.cu-modal-btn--cancel {
  color: #999;
  border-right: 1rpx solid #f0f0f0;
}
.cu-modal-btn--confirm {
  color: #4a8afe;
  font-weight: 600;
}
.cu-modal-btn--confirm:active { background: rgba(74, 138, 254, 0.05); }
.cu-modal-btn--cancel:active { background: rgba(0, 0, 0, 0.03); }

/* ===== 自定义操作面板（替代 wx.showActionSheet） ===== */
.cu-sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: cuSheetFadeIn 0.22s ease;
}
@keyframes cuSheetFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.cu-sheet {
  width: 92%;
  max-width: 680rpx;
  margin-bottom: 20rpx;
  background: transparent;
  animation: cuSheetSlideUp 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}
@keyframes cuSheetSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.cu-sheet-handle {
  width: 60rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 4rpx;
}
.cu-sheet-title {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}
.cu-sheet-list {
  background: #fff;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}
.cu-sheet-item {
  padding: 34rpx;
  text-align: center;
}
.cu-sheet-item--bordered {
  border-top: 1rpx solid #f0f0f0;
}
.cu-sheet-item:active {
  background: rgba(0, 0, 0, 0.04);
}
.cu-sheet-item-text {
  font-size: 34rpx;
  color: #333;
  letter-spacing: 1rpx;
}
.cu-sheet-cancel {
  margin-top: 16rpx;
  padding: 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.cu-sheet-cancel:active {
  background: rgba(0, 0, 0, 0.04);
}
.cu-sheet-cancel-text {
  font-size: 34rpx;
  color: #666;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 深色模式 */
.page--dark .cu-modal { background: #1c1c1e; }
.page--dark .cu-modal-title { color: #fff; }
.page--dark .cu-modal-body { color: #999; }
.page--dark .cu-modal-input { background: #2c2c2e; color: #ddd; }
.page--dark .cu-modal-input-ph { color: #666; }
.page--dark .cu-modal-btns { border-color: #333; }
.page--dark .cu-modal-btn--cancel { color: #777; border-color: #333; }
.page--dark .cu-modal-btn--confirm { color: #7eb8ff; }
.page--dark .cu-modal-btn--confirm:active { background: rgba(126, 184, 255, 0.08); }
.page--dark .cu-modal-btn--cancel:active { background: rgba(255, 255, 255, 0.04); }

.page--dark .cu-sheet-list { background: #1c1c1e; }
.page--dark .cu-sheet-item--bordered { border-color: #333; }
.page--dark .cu-sheet-item-text { color: #ddd; }
.page--dark .cu-sheet-cancel { background: #1c1c1e; }
.page--dark .cu-sheet-cancel-text { color: #999; }
.page--dark .cu-sheet-handle { background: rgba(255, 255, 255, 0.2); }
.page--dark .cu-sheet-title { color: rgba(255, 255, 255, 0.4); }
