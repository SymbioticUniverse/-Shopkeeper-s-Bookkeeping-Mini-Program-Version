/* 玻璃框网格 — 2列，每个框大小一致 */
.custom-glass-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding-bottom: 24rpx;
  justify-content: center;
}

/* 统一尺寸的玻璃框 */
.custom-glass-frame {
  width: calc((100% - 18rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

/* 玻璃框容器 — 透明玻璃质感 */
.custom-glass-inner {
  width: 100%;
  aspect-ratio: 0.92;
  background: rgba(255,255,255,0.25);
  border: 1rpx solid rgba(255,255,255,0.6);
  border-radius: 22rpx;
  box-shadow:
    inset 0 1rpx 2rpx rgba(255,255,255,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.custom-glass-inner--s1 {
  aspect-ratio: 0.72;
}
.custom-glass-inner--s2 {
  aspect-ratio: 2.2;
}

/* 玻璃框内的卡片 — 悬浮倾斜 */
.custom-tpl-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid #bbb;
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: rotate(-2.5deg);
}

/* 不同 span 的卡片宽度不同 */
.custom-tpl-card--span1 {
  width: 62%;
}

.custom-tpl-card--span2 {
  width: 86%;
}

/* 缩略卡片内所有文字等比缩小 */
