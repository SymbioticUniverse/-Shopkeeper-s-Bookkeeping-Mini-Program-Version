  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
}

.custom-tpl-card .card-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #888;
}

.custom-tpl-card .card-arrow {
  font-size: 16rpx;
  font-weight: 500;
  color: #c0c0c0;
  position: absolute;
  right: 0;
  top: 0;
