/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 自定义简览容器 */
.custom-overview-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: visible;
}

/* 已选卡片滚动区 */
.custom-cards-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 8rpx;
}

.custom-cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
  align-items: flex-start;
}

.custom-cards-grid .card {
  flex: none;
}

.custom-cards-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.custom-cards-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.custom-cards-grid .grid-span-3 {
  width: 100%;
}

.custom-card-wrapper {
  position: relative;
  overflow: visible;
}

.custom-card-wrapper + .custom-card-wrapper {
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-top: 24rpx;
  margin-top: 8rpx;
}


/* ===== 自定义编辑卡片 ===== */
.custom-edit-card {
  flex: 1;
  min-height: 0;
  padding: 16rpx 20rpx !important;
  gap: 12rpx;
  overflow: visible;
}

/* 画布容器 */
.custom-edit-canvas {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow-y: auto;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.03);
}

/* movable-area */
.custom-edit-area {
  width: 100%;
  height: 100%;
}

/* movable-view 卡片 */
.custom-edit-movable {
  display: flex;
  flex-direction: column;
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  overflow: hidden;
  box-sizing: border-box;
}

.custom-edit-card-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.custom-edit-card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-edit-card-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
  margin-top: 4rpx;
}

/* 空状态 */
.custom-edit-empty {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.custom-edit-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.12);
}

/* 分区标签 */
.custom-section-label {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.2);
  padding: 4rpx 0 8rpx;
}

/* 模版卡片行 */
.custom-card-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 模版卡片（仅负责尺寸，视觉效果由 glass-inner 提供） */
.custom-template-card {
  display: flex;
  flex-direction: column;
}

.custom-template-card--span1 {
  width: calc((100% - 12rpx) / 2);
}

.custom-template-card--span2 {
  width: 100%;
}

/* 玻璃框高度适配 */
.custom-glass-inner--s1 {
  aspect-ratio: 0.72;
}
.custom-glass-inner--s2 {
  aspect-ratio: 3.5;
}

/* span-2 内卡片更扁：缩减内边距、行间距 */
.custom-glass-inner--s2 .custom-tpl-card {
  padding: 8rpx 14rpx;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider {
  margin: 1rpx 0;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider--down {
  top: 4rpx;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider--tight {
  margin-top: -4rpx;
}

/* span-2 内卡片略宽，充分利用玻璃框空间 */
.custom-tpl-card--span2 {
  width: 82%;
}

/* ===== 三卡槽弹窗 ===== */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-card {
  width: 620rpx;
  height: 680rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.2);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.popup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.popup-card-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.popup-card-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
}

.popup-card-close-x {
  font-size: 32rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.4);
}

.popup-slots {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  overflow-y: auto;
}

.popup-slot {
  width: 100%;
  box-sizing: border-box;
  border: 3rpx dashed rgba(0,0,0,0.15);
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 20rpx;
  background: rgba(0,0,0,0.02);
  transition: border-color 0.15s, background 0.15s;
}

.popup-slot--span1 { min-height: 140rpx; flex: none; }
.popup-slot--span2 { min-height: 280rpx; flex: none; }
.popup-slot--span3 { min-height: 420rpx; flex: none; }

.popup-slot--hover {
  border-color: #ef4444;
  border-style: solid;
  background: rgba(0,208,66,0.06);
}

.popup-slot--filled {
  border-style: solid;
  border-color: rgba(0,0,0,0.25);
  background: rgba(255,255,255,0.6);
  align-items: flex-start;
}

.popup-slot-placeholder {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.15);
}

.popup-slot-card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
}

.popup-slot-card-type {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 4rpx;
}

.popup-hint {
  font-size: 22rpx;
  color: rgba(0,0,0,0.3);
  text-align: center;
  margin-top: 24rpx;
  flex-shrink: 0;
}

/* ===== 拖拽幽灵卡片 ===== */
.ghost-card {
  position: fixed;
  z-index: 400;
  pointer-events: none;
  opacity: 0.85;
}

.ghost-card-inner {
  width: 180rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #ef4444;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.ghost-card-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #000;
}


/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  padding: 24rpx 36rpx;
  justify-content: space-evenly;
}

.my-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 头像区 */
.my-profile {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.my-login-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* 列表项 */
.my-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-item-last {
  padding: 20rpx;
}
.my-item-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.my-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.my-item-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.my-item-sub {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  margin-top: 2rpx;
}
.my-item-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
  flex-shrink: 0;
}

/* ---- 我的 Tab VIP 入口特殊样式 ---- */
.my-item--vip-free {
  background: #fff;
  border: 2rpx dashed #e0e0e0;
}

.my-item--vip {
  background: linear-gradient(135deg, #fef9f0 0%, #fdf3e0 100%);
  border: 2rpx solid rgba(212, 168, 83, 0.35);
  box-shadow: 0 4rpx 20rpx rgba(212, 168, 83, 0.12);
}

.my-item-icon-wrap {
  position: relative;
  flex-shrink: 0;
}

.my-item-vip-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #cf9f40;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(207, 159, 64, 0.4);
}

.my-item-vip-badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #0d1d3e;
  letter-spacing: 1rpx;
}

.my-item-title--vip {
  color: #1a1a1a !important;
  font-weight: 700 !important;
  font-size: 34rpx !important;
}

.my-item-vip-expire {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.my-item-vip-expire-text {
  font-size: 22rpx;
  color: #999;
}

.my-item-vip-expire-days {
  font-size: 24rpx;
  color: #cf9f40;
  font-weight: 600;
}

.my-item-arrow--vip {
  color: #cf9f40 !important;
}

/* 图标行卡片 */
.my-icon-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 23rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}
.my-icon-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
}
.my-icon-circle-img {
  width: 100%;
  height: 100%;
}
.my-icon-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.my-icon-row-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
}

/* ---- 报表卡片 ---- */
.report-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.report-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* 个人/公司 切换钮 */
.report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 190rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.report-type-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: inset 0rpx 2rpx 6rpx rgba(0,0,0,0.15);
}
.report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 95rpx;
  height: 42rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 22rpx;
  transition: left 0.25s ease;
}
.report-type-slider--right {
  left: 95rpx;
}
.report-type-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.35);
  z-index: 1;
  transition: color 0.25s ease;
}
.report-type-text--active {
  color: #000;
}

/* 周期切换条：月度/季度/年度/日度 */
.report-period-bar {
  display: flex;
  flex-shrink: 0;
}
.report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255,255,255,0.8);
}
.report-period-item:first-child {
  border-radius: 26rpx 0 0 26rpx;
}
.report-period-item:last-child {
  border-radius: 0 26rpx 26rpx 0;
}
.report-period-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-period-item--active {
  background: rgba(0,0,0,0.06);
}
.report-period-text--active {
  color: #000;
}

/* 图表区容器 */
.report-chart-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 10rpx;
  min-height: 0;
  overflow: hidden;
}
.report-summary-scroll {
  flex: 1;
  min-height: 0;
}

/* 日期 + 收入/支出 行 */
.report-info-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}
.report-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #a0a0a0;
}
.report-date-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.8);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-inout-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.report-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.report-dot--green {
  background: #ef4444;
}
.report-dot--red {
  background: #333333;
}
.report-inout-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
}

.report-chart-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #a0a0a0;
  flex-shrink: 0;
}
.report-chart-block {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8rpx;
  position: relative;
  min-height: 240rpx;
  flex-shrink: 0;
}
.report-canvas {
  flex: 1;
  width: 100%;
  border-radius: 12rpx;
}

/* 饼状图 */
.report-pie-block {
  flex: 1;
  min-height: 310rpx;
}
.report-pie-row {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.report-pie-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.report-pie-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.report-pie-canvas {
  width: 300rpx;
  height: 300rpx;
}

/* ---- 结清卡片 ---- */
.settle-card {
  padding: 28rpx 30rpx 20rpx;
  gap: 0;
}
.settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.settle-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.settle-subtitle {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(160,160,160,0.63);
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}
.settle-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 10rpx 0;
  flex-shrink: 0;
}
.settle-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.settle-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.settle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.settle-dot--in {
  background: #ef4444;
}
.settle-dot--out {
  background: #333333;
}
.settle-item-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
  flex: 1;
}
.settle-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.settle-amount {
  display: flex;
  align-items: baseline;
  min-width: 180rpx;
  flex-shrink: 0;
  white-space: nowrap;
  justify-content: flex-end;
}
.settle-yen {
  font-size: 24rpx;
  font-weight: 500;
}
.settle-num {
  font-size: 30rpx;
  font-weight: 500;
}
.settle-amount--in .settle-yen,
.settle-amount--in .settle-num {
  color: #ef4444;
}
.settle-amount--out .settle-yen,
.settle-amount--out .settle-num {
  color: #333333;
}
.settle-date {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  border-radius: 44rpx;
  padding: 18rpx 0;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.settle-btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}
.settle-warn {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
  text-align: center;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ---- 明细卡片 ---- */
.detail-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.detail-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.detail-list-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 0;
  overflow: hidden;
}
.detail-col-headers {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-col-label {
