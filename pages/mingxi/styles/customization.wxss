}
.custom-tpl-bill-val--in {
  color: #fca5a5;
}
.custom-tpl-bill-val--out {
  color: #d1d5db;
}
.custom-tpl-bill-date {
  font-size: 14rpx;
  font-weight: 500;
  color: #b0b0b0;
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}
.custom-tpl-detail-cut {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.15);
