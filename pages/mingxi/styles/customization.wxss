  background: rgba(255,255,255,0.7);
}
.custom-tpl-detail-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rpx;
}
.custom-tpl-detail-date-tag {
  font-size: 14rpx;
  font-weight: 500;
  color: #888;
}
.custom-tpl-detail-inout {
  display: flex;
  align-items: center;
