/* ---- 通知页 ---- */
.notify-scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 24rpx;
}

.notify-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.notify-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: none;
  align-items: center;
  justify-content: center;
  background: #333333;
  border-radius: 0 20rpx 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.notify-swipe--open .notify-delete {
  display: flex;
}

.notify-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  transition: transform 0.25s ease;
}

.notify-item--open {
  transform: translateX(-160rpx);
}

.notify-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #333333;
  position: absolute;
  right: 20rpx;
  top: 24rpx;
}

.my-icon-circle--badge-host {
  overflow: visible;
  position: relative;
}

.notify-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #333333;
  border: 3rpx solid #fff;
  box-shadow: 0 0 10rpx rgba(255,59,48,0.6), 0 2rpx 6rpx rgba(255,59,48,0.3);
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 10rpx rgba(255,59,48,0.6), 0 2rpx 6rpx rgba(255,59,48,0.3); }
  50% { transform: scale(1.15); box-shadow: 0 0 18rpx rgba(255,59,48,0.8), 0 4rpx 10rpx rgba(255,59,48,0.5); }
}

.notify-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
}

.notify-time {
  font-size: 22rpx;
  color: #a0a0a0;
}

.notify-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #a0a0a0;
}

/* ---- 自定义简览页 ---- */
.custom-overview-body {
  flex: 1;
