}

/* 玻璃框底部标签 */
.custom-glass-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.custom-glass-label-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #ef4444;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #ef4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #ef4444;
}

.custom-glass-add-btn--active text {
  color: #ef4444;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 滚动画布 */
.edit-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 3 列网格 */
.edit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 4rpx;
}

/* 网格卡片 */
.edit-card-item {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.1);
  border-radius: 18rpx;
  padding: 12rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.edit-card-item--span1 {
  width: calc((100% - 32rpx) / 3);
}

.edit-card-item--span2 {
  width: calc((100% - 32rpx) * 2 / 3 + 16rpx);
}

.edit-card-item--span3 {
  width: 100%;
}

.edit-card-remove {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.edit-card-remove-x {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.35);
}

/* FAB 添加按钮 */
.edit-add-fab {
  position: absolute;
  bottom: 24rpx;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  background: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
  z-index: 90;
}

.edit-add-fab-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

/* 空态提示 */
.edit-empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.edit-empty-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* ===== 底部模版面板 ===== */
.template-panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.template-panel-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.template-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx 60rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.template-panel--show {
  transform: translateY(0);
}

.template-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.template-panel-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
}

.template-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-panel-close-x {
  font-size: 28rpx;
  color: #999;
}

.template-panel-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}

/* ===== 槽位拖放对话框 ===== */
.slot-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.25);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: modalFadeIn 0.28s ease-out;
  backdrop-filter: blur(4px);
}
@keyframes modalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.slot-modal {
  width: 600rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  padding: 32rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  animation: modalSlideUp 0.28s ease-out;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}
@keyframes modalSlideUp {
  from { transform: translateY(30rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.slot-modal-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}
.slot-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}
.slot-item {
  border: 2rpx dashed rgba(255,255,255,0.4);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  transition: border-color 0.15s, background 0.15s;
  width: 48%;
  aspect-ratio: 0.72;
}
.slot-item--hover {
  border-color: #07c160;
  background: rgba(7,193,96,0.06);
}
.slot-item--filled {
  border-style: solid;
  border-color: rgba(0,0,0,0.12);
  background: rgba(255,255,255,0.5);
}
.slot-item--h2 {
  width: 96%;
  aspect-ratio: 2.2;
}
.slot-card-span {
  font-size: 18rpx;
  font-weight: 500;
  color: #b0b0b0;
  margin-top: 2rpx;
}
.slot-placeholder {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.15);
}
.slot-card-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.slot-card-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  margin-top: 4rpx;
}
/* 全屏拖拽遮罩 */
.drag-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1002;
}
/* 手指跟随浮动卡片 */
.drag-float-card {
  position: fixed;
  width: 200rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.96);
  border: 2rpx solid #07c160;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1001;
  pointer-events: none;
  animation: floatPopIn 0.15s ease-out;
}
@keyframes floatPopIn {
  from { transform: scale(0.85); opacity: 0.6; }
  to { transform: scale(1); opacity: 1; }
}
.drag-float-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}
.drag-float-sub {
  font-size: 18rpx;
  font-weight: 500;
  color: #999;
  margin-top: 2rpx;
}
.slot-drag-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}
.slot-drag-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  margin-top: 2rpx;
}
/* 底部按钮 */
.slot-modal-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 8rpx;
}
.slot-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}
.slot-btn--cancel {
  background: rgba(0,0,0,0.06);
  color: #666;
}
.slot-btn--confirm {
  background: #07c160;
  color: #fff;
}

/* === 报表图表卡片迷你预览 === */
.custom-tpl-chart-preview {
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 折线图（参照报表页 drawStockChart：零线 + 横格线 + 点阵） */
.mini-chart--line {
  width: 100%;
  height: 80rpx;
  position: relative;
  margin: 4rpx 0 2rpx;
}
.mini-chart--line::before {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 2rpx;
  height: 1rpx;
  background: rgba(0,0,0,0.08);
}
.mini-chart--line::after {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 50%;
  height: 1rpx;
  background: rgba(0,0,0,0.10);
}
.mini-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #333;
}

/* 柱状图（参照报表页 drawBarChart：横格线 + 绿红柱对 + 虚线分隔 + 底部基线） */
.mini-chart--bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  width: 100%;
  height: 80rpx;
  margin: 4rpx 0 2rpx;
  position: relative;
  border-bottom: 1rpx solid rgba(0,0,0,0.15);
}
.mini-chart--bar::before {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 33%;
  height: 1rpx;
  background: rgba(0,0,0,0.06);
}
.mini-chart--bar::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 66%;
  height: 1rpx;
  background: rgba(0,0,0,0.06);
}
.mini-bar-group {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
}
.mini-bar {
  width: 8rpx;
  border-radius: 2rpx 2rpx 0 0;
}
.mini-bar--green { background: #ef4444; }
.mini-bar--red { background: #333333; }
.mini-bar-sep {
  width: 1rpx;
  align-self: stretch;
  background: repeating-linear-gradient(
    180deg,
    transparent 0rpx,
    transparent 4rpx,
    rgba(0,0,0,0.12) 4rpx,
    rgba(0,0,0,0.12) 6rpx
  );
}

/* 饼状图 */
.mini-chart--pie {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 4rpx 0 2rpx;
}
.mini-pie {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: conic-gradient(
    #ef4444 0deg 140deg,
    #333333 140deg 250deg,
    #ff9500 250deg 360deg
  );
}

/* 简览页图表 canvas */
.overview-canvas {
  width: 100%;
  height: 260rpx;
  margin: 6rpx 0;
}

/* 迷你图例行（参照报表页图表上的收入/支出图例） */
.mini-legend {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mini-legend-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.mini-legend-item text {
  font-size: 20rpx;
  color: #999;
}
.mini-legend-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.mini-legend-dot--green { background: #ef4444; }
.mini-legend-dot--red { background: #333333; }

/* === 自定义分类页（在 my-card 内） === */
.card.custom-cat-card {
  overflow: hidden;
  justify-content: flex-start;
  padding-left: 0;
  padding-right: 0;
}

.custom-cat-card .custom-cat-header {
  padding-left: 36rpx;
  padding-right: 36rpx;
}

.custom-cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0;
  margin-bottom: 0;
  flex-shrink: 0;
}
.custom-cat-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.custom-cat-icon {
  width: 36rpx;
  height: 36rpx;
}

.custom-cat-personal-block,
.custom-cat-company-block {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.custom-cat-scroll-wrap {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.custom-cat-grid-scroll {
  height: 100%;
}

.custom-cat-back {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-cat-back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #333;
  border-bottom: 4rpx solid #333;
  transform: rotate(45deg);
  margin-left: 10rpx;
}

.custom-cat-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}

.custom-cat-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.1);
  margin: 0;
  flex-shrink: 0;
}

.custom-cat-card > .custom-cat-divider {
  margin-left: 36rpx;
  margin-right: 36rpx;
}

.custom-cat-section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 36rpx 8rpx;
  flex-shrink: 0;
}

.custom-cat-section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(160, 160, 160, 0.7);
}

.custom-cat-tabs {
  display: flex;
  gap: 2rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 10rpx;
  padding: 3rpx;
}

.custom-cat-tab {
  font-size: 22rpx;
  color: #aaa;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.custom-cat-tab--on {
  background: #fff;
  color: #333;
  font-weight: 500;
  box-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.06);
}

.custom-cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 36rpx;
}

.custom-cat-item {
  width: calc(100% / 6);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}

.custom-cat-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-cat-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.custom-cat-name {
  font-size: 20rpx;
  color: #aaa;
  font-weight: 500;
  margin-top: 8rpx;
  text-align: center;
}

.custom-cat-add {
  display: flex;
  justify-content: center;
  padding: 0 36rpx 8rpx;
}

.custom-cat-add-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 2rpx dashed #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #d0d0d0;
  font-weight: 300;
  line-height: 1;
}

/* 添加分类弹窗 */
.cat-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.cat-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  z-index: 101;
  overflow: hidden;
}

.cat-modal-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.cat-modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}

.cat-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #aaa;
}

.cat-modal-body {
  padding: 0 32rpx 24rpx;
}

.cat-modal-field {
  margin-bottom: 24rpx;
}

.cat-modal-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 12rpx;
}

.cat-modal-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.cat-modal-emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 240rpx;
  overflow-y: auto;
}

.cat-modal-emoji-item {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
}

.cat-modal-emoji--on {
  background: #e8f4fd;
  box-shadow: 0 0 0 3rpx #4a90d9;
}

.cat-modal-ft {
  display: flex;
  border-top: 1rpx solid #eee;
}

.cat-modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.cat-modal-btn--cancel {
  color: #999;
  border-right: 1rpx solid #eee;
}

.cat-modal-btn--confirm {
  color: #4a90d9;
}

/* 联系我们获好礼页 */
.contact-gift-card {
  overflow: hidden;
}

.contact-gift-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 24rpx 28rpx;
}

.contact-gift-info {
  align-items: center;
  margin-bottom: 28rpx;
}

.contact-gift-info-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
  text-align: center;
  margin-bottom: 12rpx;
}

.contact-gift-info-desc {
  display: block;
  font-size: 24rpx;
  color: #a0a0a0;
  text-align: center;
  line-height: 1.6;
}

.contact-gift-form {
  margin-bottom: 28rpx;
}

.contact-gift-textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.contact-gift-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #4a90d9, #357abd);
  border-radius: 16rpx;
}

.contact-gift-btn text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
}

.contact-gift-links {
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 24rpx;
}

.contact-gift-links-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.contact-gift-link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.contact-gift-link-item + .contact-gift-link-item {
  border-top: 1rpx solid #e8e8e8;
}

.contact-gift-link-label {
  font-size: 26rpx;
  color: #666;
}

.contact-gift-link-value {
  font-size: 26rpx;
  color: #4a90d9;
}
