}
.custom-tpl-bill-cat {
  font-size: 14rpx;
  font-weight: 500;
  color: #555;
  width: 50rpx;
  flex-shrink: 0;
}
.custom-tpl-bill-type {
  font-size: 14rpx;
  font-weight: 500;
  color: #888;
  width: 44rpx;
