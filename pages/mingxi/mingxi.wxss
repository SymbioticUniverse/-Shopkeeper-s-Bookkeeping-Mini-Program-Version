  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #00d042;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #00d042;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #00d042;
}

.custom-glass-add-btn--active text {
  color: #00d042;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 自定义简览容器 */
.custom-overview-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: visible;
}

/* 已选卡片滚动区 */
.custom-cards-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 8rpx;
}

.custom-cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
  align-items: flex-start;
}

.custom-cards-grid .card {
  flex: none;
}

.custom-cards-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.custom-cards-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.custom-cards-grid .grid-span-3 {
  width: 100%;
}

.custom-card-wrapper {
  position: relative;
  overflow: visible;
}

.custom-card-wrapper + .custom-card-wrapper {
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-top: 24rpx;
  margin-top: 8rpx;
}


/* ===== 自定义编辑卡片 ===== */
.custom-edit-card {
  flex: 1;
  min-height: 0;
  padding: 16rpx 20rpx !important;
  gap: 12rpx;
  overflow: visible;
}

/* 画布容器 */
.custom-edit-canvas {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow-y: auto;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.03);
}

/* movable-area */
.custom-edit-area {
  width: 100%;
  height: 100%;
}

/* movable-view 卡片 */
.custom-edit-movable {
  display: flex;
  flex-direction: column;
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  overflow: hidden;
  box-sizing: border-box;
}

.custom-edit-card-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.custom-edit-card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-edit-card-sub {
  font-size: 22rpx;
  font-weight: 500;
  color: #a0a0a0;
  margin-top: 4rpx;
}

/* 空状态 */
.custom-edit-empty {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.custom-edit-empty-text {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.12);
}

/* 分区标签 */
.custom-section-label {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.2);
  padding: 4rpx 0 8rpx;
}

/* 模版卡片行 */
.custom-card-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 模版卡片（仅负责尺寸，视觉效果由 glass-inner 提供） */
.custom-template-card {
  display: flex;
  flex-direction: column;
}

.custom-template-card--span1 {
  width: calc((100% - 12rpx) / 2);
}

.custom-template-card--span2 {
  width: 100%;
}

/* 玻璃框高度适配 */
.custom-glass-inner--s1 {
  aspect-ratio: 0.72;
}
.custom-glass-inner--s2 {
  aspect-ratio: 3.5;
}

/* span-2 内卡片更扁：缩减内边距、行间距 */
.custom-glass-inner--s2 .custom-tpl-card {
  padding: 8rpx 14rpx;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider {
  margin: 1rpx 0;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider--down {
  top: 4rpx;
}
.custom-glass-inner--s2 .custom-tpl-card .card-divider--tight {
  margin-top: -4rpx;
}

/* span-2 内卡片略宽，充分利用玻璃框空间 */
.custom-tpl-card--span2 {
  width: 82%;
}

/* ===== 三卡槽弹窗 ===== */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-card {
  width: 620rpx;
  height: 680rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.2);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.popup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.popup-card-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.popup-card-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
}

.popup-card-close-x {
  font-size: 32rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.4);
}

.popup-slots {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  overflow-y: auto;
}

.popup-slot {
  width: 100%;
  box-sizing: border-box;
  border: 3rpx dashed rgba(0,0,0,0.15);
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 20rpx;
  background: rgba(0,0,0,0.02);
  transition: border-color 0.15s, background 0.15s;
}

.popup-slot--span1 { min-height: 140rpx; flex: none; }
.popup-slot--span2 { min-height: 280rpx; flex: none; }
.popup-slot--span3 { min-height: 420rpx; flex: none; }

.popup-slot--hover {
  border-color: #00d042;
  border-style: solid;
  background: rgba(0,208,66,0.06);
}

.popup-slot--filled {
  border-style: solid;
  border-color: rgba(0,0,0,0.25);
  background: rgba(255,255,255,0.6);
  align-items: flex-start;
}

.popup-slot-placeholder {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.15);
}

.popup-slot-card-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
}

.popup-slot-card-type {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 4rpx;
}

.popup-hint {
  font-size: 22rpx;
  color: rgba(0,0,0,0.3);
  text-align: center;
  margin-top: 24rpx;
  flex-shrink: 0;
}

/* ===== 拖拽幽灵卡片 ===== */
.ghost-card {
  position: fixed;
  z-index: 400;
  pointer-events: none;
  opacity: 0.85;
}

.ghost-card-inner {
  width: 180rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #00d042;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.ghost-card-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #000;
}


/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
