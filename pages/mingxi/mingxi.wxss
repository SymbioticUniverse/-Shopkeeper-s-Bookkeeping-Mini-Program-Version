}
.custom-tpl-period-item {
  flex: 1;
  text-align: center;
  font-size: 14rpx;
  font-weight: 500;
  color: #a0a0a0;
  background: rgba(255,255,255,0.8);
  padding: 2rpx 0;
  border-right: 0.5rpx solid rgba(0,0,0,0.1);
}
.custom-tpl-period-item:last-child {
  border-right: none;
}
.custom-tpl-period-item--active {
  color: #333;
  background: rgba(255,255,255,0.7);
}
.custom-tpl-detail-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rpx;
}
.custom-tpl-detail-date-tag {
  font-size: 14rpx;
  font-weight: 500;
  color: #888;
}
.custom-tpl-detail-inout {
  display: flex;
  align-items: center;
  gap: 3rpx;
}
.custom-tpl-inout-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.custom-tpl-inout-dot--in {
  background: #66d99a;
}
.custom-tpl-inout-dot--out {
  background: #f08080;
}
.custom-tpl-inout-label {
  font-size: 14rpx;
  font-weight: 500;
  color: #888;
  margin-right: 6rpx;
}
.custom-tpl-detail-cols {
  display: flex;
  align-items: center;
  border-bottom: 0.5rpx solid rgba(0,0,0,0.08);
  padding-bottom: 2rpx;
  margin-bottom: 2rpx;
}
.custom-tpl-col-hd {
  font-size: 14rpx;
  font-weight: 500;
  color: #999;
}
.custom-tpl-detail-bills {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.custom-tpl-bill-row {
  display: flex;
  align-items: center;
  gap: 2rpx;
}
.custom-tpl-bill-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.18);
  flex-shrink: 0;
}
.custom-tpl-bill-cat {
  font-size: 14rpx;
  font-weight: 500;
  color: #555;
  width: 50rpx;
  flex-shrink: 0;
}
.custom-tpl-bill-type {
  font-size: 14rpx;
  font-weight: 500;
  color: #888;
  width: 44rpx;
  flex-shrink: 0;
}
.custom-tpl-bill-note {
  font-size: 14rpx;
  font-weight: 500;
  color: #b0b0b0;
  flex: 1;
}
.custom-tpl-bill-val {
  font-size: 14rpx;
  font-weight: 500;
  color: #000;
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}
.custom-tpl-bill-val--in {
  color: #66d99a;
}
.custom-tpl-bill-val--out {
  color: #f08080;
}
.custom-tpl-bill-date {
  font-size: 14rpx;
  font-weight: 500;
  color: #b0b0b0;
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}
.custom-tpl-detail-cut {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.15);
  margin-top: 2rpx;
}

/* 玻璃框底部标签 */
.custom-glass-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.custom-glass-label-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #00d042;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #00d042;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #00d042;
}

.custom-glass-add-btn--active text {
  color: #00d042;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 滚动画布 */
.edit-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 3 列网格 */
.edit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 4rpx;
}

/* 网格卡片 */
.edit-card-item {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.1);
  border-radius: 18rpx;
  padding: 12rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.edit-card-item--span1 {
  width: calc((100% - 32rpx) / 3);
}

.edit-card-item--span2 {
  width: calc((100% - 32rpx) * 2 / 3 + 16rpx);
}

.edit-card-item--span3 {
  width: 100%;
}

.edit-card-remove {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.edit-card-remove-x {
  font-size: 32rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.35);
}

/* FAB 添加按钮 */
.edit-add-fab {
  position: absolute;
  bottom: 24rpx;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  background: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
  z-index: 90;
}

.edit-add-fab-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

/* 空态提示 */
.edit-empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.edit-empty-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* ===== 底部模版面板 ===== */
.template-panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.template-panel-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.template-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx 60rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.template-panel--show {
  transform: translateY(0);
}

.template-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.template-panel-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #000;
}

.template-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-panel-close-x {
  font-size: 28rpx;
  color: #999;
}

.template-panel-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}

/* ===== 槽位拖放对话框 ===== */
.slot-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.25);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: modalFadeIn 0.28s ease-out;
  backdrop-filter: blur(4px);
}
@keyframes modalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.slot-modal {
  width: 600rpx;
  background: rgba(255,255,255,0.5);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  padding: 32rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  animation: modalSlideUp 0.28s ease-out;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}
@keyframes modalSlideUp {
  from { transform: translateY(30rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
.slot-modal-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}
.slot-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}
.slot-item {
  border: 2rpx dashed rgba(255,255,255,0.4);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  transition: border-color 0.15s, background 0.15s;
  width: 48%;
  aspect-ratio: 0.72;
}
.slot-item--hover {
  border-color: #07c160;
  background: rgba(7,193,96,0.06);
}
.slot-item--filled {
  border-style: solid;
  border-color: rgba(0,0,0,0.12);
  background: rgba(255,255,255,0.5);
}
.slot-item--h2 {
  width: 96%;
  aspect-ratio: 2.2;
}
.slot-card-span {
  font-size: 18rpx;
  font-weight: 500;
  color: #b0b0b0;
  margin-top: 2rpx;
}
.slot-placeholder {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.15);
}
.slot-card-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.slot-card-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  margin-top: 4rpx;
}
/* 全屏拖拽遮罩 */
.drag-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1002;
}
/* 手指跟随浮动卡片 */
.drag-float-card {
  position: fixed;
  width: 200rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.96);
  border: 2rpx solid #07c160;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1001;
  pointer-events: none;
  animation: floatPopIn 0.15s ease-out;
}
@keyframes floatPopIn {
  from { transform: scale(0.85); opacity: 0.6; }
  to { transform: scale(1); opacity: 1; }
}
.drag-float-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}
.drag-float-sub {
  font-size: 18rpx;
  font-weight: 500;
  color: #999;
  margin-top: 2rpx;
}
.slot-drag-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}
.slot-drag-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  margin-top: 2rpx;
}
/* 底部按钮 */
.slot-modal-btns {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 8rpx;
}
.slot-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}
.slot-btn--cancel {
  background: rgba(0,0,0,0.06);
  color: #666;
}
.slot-btn--confirm {
  background: #07c160;
  color: #fff;
}

/* === 报表图表卡片迷你预览 === */
.custom-tpl-chart-preview {
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 折线图（参照报表页 drawStockChart：零线 + 横格线 + 点阵） */
.mini-chart--line {
  width: 100%;
  height: 80rpx;
  position: relative;
  margin: 4rpx 0 2rpx;
}
.mini-chart--line::before {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 2rpx;
  height: 1rpx;
  background: rgba(0,0,0,0.08);
}
.mini-chart--line::after {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 50%;
  height: 1rpx;
  background: rgba(0,0,0,0.10);
}
.mini-dot {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #333;
}

/* 柱状图（参照报表页 drawBarChart：横格线 + 绿红柱对 + 虚线分隔 + 底部基线） */
.mini-chart--bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  width: 100%;
  height: 80rpx;
  margin: 4rpx 0 2rpx;
  position: relative;
  border-bottom: 1rpx solid rgba(0,0,0,0.15);
}
.mini-chart--bar::before {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 33%;
  height: 1rpx;
  background: rgba(0,0,0,0.06);
}
.mini-chart--bar::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 66%;
  height: 1rpx;
  background: rgba(0,0,0,0.06);
}
.mini-bar-group {
  display: flex;
  align-items: flex-end;
  gap: 2rpx;
}
.mini-bar {
  width: 8rpx;
  border-radius: 2rpx 2rpx 0 0;
}
.mini-bar--green { background: #00d042; }
.mini-bar--red { background: #ed2e2e; }
.mini-bar-sep {
  width: 1rpx;
  align-self: stretch;
  background: repeating-linear-gradient(
    180deg,
    transparent 0rpx,
    transparent 4rpx,
    rgba(0,0,0,0.12) 4rpx,
    rgba(0,0,0,0.12) 6rpx
  );
}

/* 饼状图 */
.mini-chart--pie {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 4rpx 0 2rpx;
}
.mini-pie {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: conic-gradient(
    #00d042 0deg 140deg,
    #ed2e2e 140deg 250deg,
    #ff9500 250deg 360deg
  );
}

/* 简览页图表 canvas */
.overview-canvas {
  width: 100%;
  height: 260rpx;
  margin: 6rpx 0;
}

/* 迷你图例行（参照报表页图表上的收入/支出图例） */
.mini-legend {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.mini-legend-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.mini-legend-item text {
  font-size: 20rpx;
  color: #999;
}
.mini-legend-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.mini-legend-dot--green { background: #00d042; }
.mini-legend-dot--red { background: #ed2e2e; }

