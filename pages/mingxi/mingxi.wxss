/* ---- 自定义简览页 ---- */
.custom-overview-body {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.custom-section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  margin-bottom: 4rpx;
  padding: 0 8rpx;
}

.custom-section-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #a0a0a0;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

/* 玻璃框网格 — 2列，每个框大小一致 */
.custom-glass-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding-bottom: 24rpx;
  justify-content: center;
}

/* 统一尺寸的玻璃框 */
.custom-glass-frame {
  width: calc((100% - 18rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

/* 玻璃框容器 — 透明玻璃质感 */
.custom-glass-inner {
  width: 100%;
  aspect-ratio: 0.92;
  background: rgba(255,255,255,0.25);
  border: 1rpx solid rgba(255,255,255,0.6);
  border-radius: 22rpx;
  box-shadow:
    inset 0 1rpx 2rpx rgba(255,255,255,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* 玻璃框内的卡片 — 悬浮倾斜 */
.custom-tpl-card {
  background: rgba(255,255,255,0.3);
  border: 1rpx solid #bbb;
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  box-shadow:
    0rpx 3rpx 0rpx 1rpx rgba(0,0,0,0.2),
    0 6rpx 18rpx rgba(0,0,0,0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: rotate(-2.5deg);
}

/* 不同 span 的卡片宽度不同 */
.custom-tpl-card--span1 {
  width: 62%;
}

.custom-tpl-card--span2 {
  width: 86%;
}

/* 缩略卡片内所有文字等比缩小 */
.custom-tpl-card .card-header {
  position: relative;
  padding-left: 44rpx;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.custom-tpl-card .card-header.compact {
  padding-left: 0;
}

.custom-tpl-card .card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
}

.custom-tpl-card .card-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .card-arrow {
  font-size: 16rpx;
  font-weight: 700;
  color: #c0c0c0;
  position: absolute;
  right: 0;
  top: 0;
}

.custom-tpl-card .card-subtitle {
  font-size: 16rpx;
  font-weight: 700;
  color: #b0b0b0;
  display: block;
  margin-top: 1rpx;
}

.custom-tpl-card .card-divider {
  height: 1rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}

.custom-tpl-card .card-divider--down {
  position: relative;
  top: 10rpx;
}

.custom-tpl-card .card-divider--tight {
  margin-top: -10rpx;
}

.custom-tpl-card .card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}

.custom-tpl-card .card-row.three-col {
  justify-content: space-between;
}

.custom-tpl-card .row-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .col-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #b0b0b0;
  text-align: center;
  flex: 1;
}

.custom-tpl-card .value-tag {
  display: flex;
  align-items: baseline;
}

.custom-tpl-card .three-col .value-tag {
  flex: 1;
  justify-content: center;
}

.custom-tpl-card .value-yen {
  font-size: 18rpx;
  font-weight: 700;
}

.custom-tpl-card .value-num {
  font-size: 22rpx;
  font-weight: 700;
}

.custom-tpl-card .green .value-yen,
.custom-tpl-card .green .value-num {
  color: #66d99a;
}

.custom-tpl-card .red .value-yen,
.custom-tpl-card .red .value-num {
  color: #f08080;
}

/* 明细页元素缩小 */
.custom-tpl-card .detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.custom-tpl-card .detail-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 110rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.custom-tpl-card .report-type-bg {
  position: absolute;
  inset: 0;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: inset 0rpx 1rpx 3rpx rgba(0,0,0,0.15);
}

.custom-tpl-card .report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 55rpx;
  height: 28rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 14rpx;
}

.custom-tpl-card .report-type-text {
  flex: 1;
  text-align: center;
  font-size: 16rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
  z-index: 1;
}

.custom-tpl-card .report-type-text--active {
  color: #888;
}

.custom-tpl-card .report-period-bar {
  display: flex;
  flex-shrink: 0;
  margin: 6rpx 0;
}

.custom-tpl-card .report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 0;
  background: rgba(255,255,255,0.3);
  border: 1rpx solid #bbb;
  border-right: none;
  box-shadow: 0rpx 2rpx 2rpx 0rpx rgba(0,0,0,0.1);
}

.custom-tpl-card .report-period-item:first-child {
  border-radius: 12rpx 0 0 12rpx;
}

.custom-tpl-card .report-period-item:last-child {
  border-radius: 0 12rpx 12rpx 0;
  border-right: 1rpx solid #bbb;
}

.custom-tpl-card .report-period-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.custom-tpl-card .report-period-item--active {
  background: rgba(0,0,0,0.06);
}

.custom-tpl-card .report-period-text--active {
  color: #888;
}

.custom-tpl-card .detail-date-box {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  box-shadow: 0rpx 2rpx 2rpx 0rpx rgba(0,0,0,0.08);
  margin-bottom: 6rpx;
}

.custom-tpl-card .report-date-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.custom-tpl-card .report-date-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #a0a0a0;
}

.custom-tpl-card .settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.custom-tpl-card .settle-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #999;
  border-radius: 22rpx;
  padding: 10rpx 0;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.custom-tpl-card .settle-btn-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
}

/* 玻璃框底部标签 */
.custom-glass-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.custom-glass-label-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #00d042;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #00d042;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #00d042;
}

.custom-glass-add-btn--active text {
  color: #00d042;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

/* 自定义简览容器 */
.custom-overview-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: visible;
}

/* 已选卡片滚动区 */
.custom-cards-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 8rpx;
}

.custom-cards-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
  align-items: flex-start;
}

.custom-cards-grid .card {
  flex: none;
}

.custom-cards-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.custom-cards-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.custom-cards-grid .grid-span-3 {
  width: 100%;
}

.custom-card-wrapper {
  position: relative;
  overflow: visible;
}

.custom-card-wrapper + .custom-card-wrapper {
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-top: 24rpx;
  margin-top: 8rpx;
}

/* 自定义简览页中的大卡片 */
.custom-overview-container > .card {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 保存后的简览页卡片项 */
.saved-card-item + .saved-card-item {
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  padding-top: 24rpx;
  margin-top: 8rpx;
}

/* 编辑模式下的空卡槽占位 */
.custom-empty-slot {
  background: transparent !important;
  border: 2rpx dashed rgba(0,0,0,0.12) !important;
  box-shadow: none !important;
  min-height: 200rpx;
}

/* 非编辑模式下的空卡槽占位（不可见，仅占位） */
.overview-empty-slot {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  min-height: 10rpx;
}

.custom-card-remove {
  position: absolute;
  top: 8rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.custom-card-remove-x {
  font-size: 40rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.25);
}

.custom-cards-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.custom-cards-empty-text {
  font-size: 26rpx;
  color: rgba(0,0,0,0.2);
}

/* 模版库 */
.template-library {
  flex-shrink: 0;
  padding-top: 16rpx;
}

.edit-templates-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #000;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.edit-templates-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  flex-shrink: 0;
  padding-bottom: 12rpx;
  width: 100%;
}

.edit-templates-scroll .custom-glass-frame {
  flex-shrink: 0;
  width: 270rpx;
  margin-right: 20rpx;
}

/* 玻璃框激活态 */
.custom-glass-frame--active .custom-glass-inner {
  border-color: #00d042 !important;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06) !important;
}

/* ===== 三卡槽弹窗 ===== */
.popup-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-card {
  width: 620rpx;
  height: 680rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.2);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.popup-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.popup-card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.popup-card-close {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
}

.popup-card-close-x {
  font-size: 32rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.4);
}

.popup-slots {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  overflow-y: auto;
}

.popup-slot {
  width: 100%;
  box-sizing: border-box;
  border: 3rpx dashed rgba(0,0,0,0.15);
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 20rpx;
  background: rgba(0,0,0,0.02);
  transition: border-color 0.15s, background 0.15s;
}

.popup-slot--span1 { min-height: 140rpx; flex: none; }
.popup-slot--span2 { min-height: 280rpx; flex: none; }
.popup-slot--span3 { min-height: 420rpx; flex: none; }

.popup-slot--hover {
  border-color: #00d042;
  border-style: solid;
  background: rgba(0,208,66,0.06);
}

.popup-slot--filled {
  border-style: solid;
  border-color: rgba(0,0,0,0.25);
  background: rgba(255,255,255,0.6);
  align-items: flex-start;
}

.popup-slot-placeholder {
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(0,0,0,0.15);
}

.popup-slot-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
}

.popup-slot-card-type {
  font-size: 22rpx;
  color: #a0a0a0;
  margin-top: 4rpx;
}

.popup-hint {
  font-size: 22rpx;
  color: rgba(0,0,0,0.3);
  text-align: center;
  margin-top: 24rpx;
  flex-shrink: 0;
}

/* ===== 拖拽幽灵卡片 ===== */
.ghost-card {
  position: fixed;
  z-index: 400;
  pointer-events: none;
  opacity: 0.85;
}

.ghost-card-inner {
  width: 180rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.95);
  border: 2rpx solid #00d042;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.ghost-card-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #000;
}


/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.3);
  border: 2rpx solid #000;
  border-radius: 26rpx;
  box-shadow: 0rpx 6rpx 0rpx 1rpx rgba(0,0,0,0.2);
  padding: 24rpx 36rpx;
  justify-content: space-evenly;
}

.my-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 头像区 */
.my-profile {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.my-login-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}
.my-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* 列表项 */
.my-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.3);
  border-radius: 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-item-last {
  padding: 20rpx;
}
.my-item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #ddd;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.my-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.my-item-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.my-item-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
  margin-top: 2rpx;
}
.my-item-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d1d1;
  flex-shrink: 0;
}

/* 图标行卡片 */
.my-icon-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.3);
  border-radius: 22rpx;
  padding: 23rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.my-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ddd;
}
.my-icon-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.my-icon-row-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d1d1;
}

/* ---- 报表卡片 ---- */
.report-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.report-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}

/* 个人/公司 切换钮 */
.report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 190rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.report-type-bg {
  position: absolute;
  inset: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: inset 0rpx 2rpx 6rpx rgba(0,0,0,0.15);
}
.report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 95rpx;
  height: 42rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 22rpx;
  transition: left 0.25s ease;
}
.report-type-slider--right {
  left: 95rpx;
}
.report-type-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
  z-index: 1;
  transition: color 0.25s ease;
}
.report-type-text--active {
  color: #000;
}

/* 周期切换条：月度/季度/年度/日度 */
.report-period-bar {
  display: flex;
  flex-shrink: 0;
}
.report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255,255,255,0.3);
  border: 2rpx solid #000;
  border-right: none;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.1);
}
.report-period-item:first-child {
  border-radius: 26rpx 0 0 26rpx;
}
.report-period-item:last-child {
  border-radius: 0 26rpx 26rpx 0;
  border-right: 2rpx solid #000;
}
.report-period-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-period-item--active {
  background: rgba(0,0,0,0.06);
}
.report-period-text--active {
  color: #000;
}

/* 图表区容器 */
.report-chart-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 10rpx;
  overflow-y: auto;
}

/* 日期 + 收入/支出 行 */
.report-info-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}
.report-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #a0a0a0;
}
.report-date-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.3);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-inout-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.report-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.report-dot--green {
  background: #00d042;
}
.report-dot--red {
  background: red;
}
.report-inout-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.report-chart-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
  flex-shrink: 0;
}
.report-chart-block {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8rpx;
  position: relative;
  min-height: 240rpx;
  flex-shrink: 0;
}
.report-canvas {
  flex: 1;
  width: 100%;
  border-radius: 12rpx;
}

/* 饼状图 */
.report-pie-block {
  flex: 1;
  min-height: 310rpx;
}
.report-pie-row {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.report-pie-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.report-pie-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-pie-canvas {
  width: 300rpx;
  height: 300rpx;
}

/* ---- 结清卡片 ---- */
.settle-card {
  padding: 28rpx 30rpx 20rpx;
  gap: 0;
}
.settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.settle-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}
.settle-subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(160,160,160,0.63);
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}
.settle-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 10rpx 0;
  flex-shrink: 0;
}
.settle-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.settle-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.settle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.settle-dot--in {
  background: #00d042;
}
.settle-dot--out {
  background: #ed2e2e;
}
.settle-item-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #a0a0a0;
  flex: 1;
}
.settle-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.settle-amount {
  display: flex;
  align-items: baseline;
}
.settle-yen {
  font-size: 24rpx;
  font-weight: 700;
}
.settle-num {
  font-size: 30rpx;
  font-weight: 700;
}
.settle-amount--in .settle-yen,
.settle-amount--in .settle-num {
  color: #00d042;
}
.settle-amount--out .settle-yen,
.settle-amount--out .settle-num {
  color: #ed2e2e;
}
.settle-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.settle-btn {
  display: flex;
  align-items: center;
