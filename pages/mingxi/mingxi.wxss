/* ===== 页面左右切换动画 ===== */
@keyframes slideFromRight {
  from { opacity: 0; transform: translateX(120rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes slideFromLeft {
  from { opacity: 0; transform: translateX(-120rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.slide-right .card {
  animation: slideFromRight 0.3s cubic-bezier(0.25, 0.1, 0.25, 1) both;
}
.slide-left .card {
  animation: slideFromLeft 0.3s cubic-bezier(0.25, 0.1, 0.25, 1) both;
}

