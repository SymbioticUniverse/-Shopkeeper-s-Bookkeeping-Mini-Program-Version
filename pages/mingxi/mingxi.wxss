/* ---- 自定义简览页 ---- */
.custom-overview-body {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 12rpx;
}

.custom-section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  margin-bottom: 4rpx;
  padding: 0 8rpx;
}

.custom-section-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #a0a0a0;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

/* 玻璃框网格 — 2列，每个框大小一致 */
.custom-glass-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding-bottom: 24rpx;
  justify-content: center;
}

/* 统一尺寸的玻璃框 */
.custom-glass-frame {
  width: calc((100% - 18rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

/* 玻璃框容器 — 透明玻璃质感 */
.custom-glass-inner {
  width: 100%;
  aspect-ratio: 0.92;
  background: rgba(255,255,255,0.25);
  border: 1rpx solid rgba(255,255,255,0.6);
  border-radius: 22rpx;
  box-shadow:
    inset 0 1rpx 2rpx rgba(255,255,255,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* 玻璃框内的卡片 — 悬浮倾斜 */
.custom-tpl-card {
  background: rgba(255,255,255,0.3);
  border: 1rpx solid #bbb;
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  box-shadow:
    0rpx 3rpx 0rpx 1rpx rgba(0,0,0,0.2),
    0 6rpx 18rpx rgba(0,0,0,0.12);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: rotate(-2.5deg);
}

/* 不同 span 的卡片宽度不同 */
.custom-tpl-card--span1 {
  width: 62%;
}

.custom-tpl-card--span2 {
  width: 86%;
}

/* 缩略卡片内所有文字等比缩小 */
.custom-tpl-card .card-header {
  position: relative;
  padding-left: 44rpx;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.custom-tpl-card .card-header.compact {
  padding-left: 0;
}

.custom-tpl-card .card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
}

.custom-tpl-card .card-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .card-arrow {
  font-size: 16rpx;
  font-weight: 700;
  color: #c0c0c0;
  position: absolute;
  right: 0;
  top: 0;
}

.custom-tpl-card .card-subtitle {
  font-size: 16rpx;
  font-weight: 700;
  color: #b0b0b0;
  display: block;
  margin-top: 1rpx;
}

.custom-tpl-card .card-divider {
  height: 1rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}

.custom-tpl-card .card-divider--down {
  position: relative;
  top: 10rpx;
}

.custom-tpl-card .card-divider--tight {
  margin-top: -10rpx;
}

.custom-tpl-card .card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}

.custom-tpl-card .card-row.three-col {
  justify-content: space-between;
}

.custom-tpl-card .row-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .col-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #b0b0b0;
  text-align: center;
  flex: 1;
}

.custom-tpl-card .value-tag {
  display: flex;
  align-items: baseline;
}

.custom-tpl-card .three-col .value-tag {
  flex: 1;
  justify-content: center;
}

.custom-tpl-card .value-yen {
  font-size: 18rpx;
  font-weight: 700;
}

.custom-tpl-card .value-num {
  font-size: 22rpx;
  font-weight: 700;
}

.custom-tpl-card .green .value-yen,
.custom-tpl-card .green .value-num {
  color: #66d99a;
}

.custom-tpl-card .red .value-yen,
.custom-tpl-card .red .value-num {
  color: #f08080;
}

/* 明细页元素缩小 */
.custom-tpl-card .detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}

.custom-tpl-card .detail-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 110rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.custom-tpl-card .report-type-bg {
  position: absolute;
  inset: 0;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: inset 0rpx 1rpx 3rpx rgba(0,0,0,0.15);
}

.custom-tpl-card .report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 55rpx;
  height: 28rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 14rpx;
}

.custom-tpl-card .report-type-text {
  flex: 1;
  text-align: center;
  font-size: 16rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
  z-index: 1;
}

.custom-tpl-card .report-type-text--active {
  color: #888;
}

.custom-tpl-card .report-period-bar {
  display: flex;
  flex-shrink: 0;
  margin: 6rpx 0;
}

.custom-tpl-card .report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 5rpx 0;
  background: rgba(255,255,255,0.3);
  border: 1rpx solid #bbb;
  border-right: none;
  box-shadow: 0rpx 2rpx 2rpx 0rpx rgba(0,0,0,0.1);
}

.custom-tpl-card .report-period-item:first-child {
  border-radius: 12rpx 0 0 12rpx;
}

.custom-tpl-card .report-period-item:last-child {
  border-radius: 0 12rpx 12rpx 0;
  border-right: 1rpx solid #bbb;
}

.custom-tpl-card .report-period-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.custom-tpl-card .report-period-item--active {
  background: rgba(0,0,0,0.06);
}

.custom-tpl-card .report-period-text--active {
  color: #888;
}

.custom-tpl-card .detail-date-box {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  box-shadow: 0rpx 2rpx 2rpx 0rpx rgba(0,0,0,0.08);
  margin-bottom: 6rpx;
}

.custom-tpl-card .report-date-text {
  font-size: 16rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.custom-tpl-card .report-date-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #a0a0a0;
}

.custom-tpl-card .settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.custom-tpl-card .settle-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #888;
}

.custom-tpl-card .settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #999;
  border-radius: 22rpx;
  padding: 10rpx 0;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.custom-tpl-card .settle-btn-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
}

/* 玻璃框底部标签 */
.custom-glass-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0 4rpx;
}

.custom-glass-label-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #000;
}

.custom-glass-label-meta {
  font-size: 20rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* 选中态玻璃框 */
.custom-glass-frame--selected .custom-glass-inner {
  border-color: #00d042;
  box-shadow:
    inset 0 1rpx 2rpx rgba(0,208,66,0.3),
    0 0 0 3rpx rgba(0,208,66,0.15),
    0 4rpx 16rpx rgba(0,0,0,0.06);
}

/* 选中 ✓ 标记 */
.custom-glass-check {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  background: #00d042;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}

.custom-glass-check-icon {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

/* 标签区左侧 */
.custom-glass-label-left {
  display: flex;
  flex-direction: column;
}

/* 添加按钮 */
.custom-glass-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #000;
  flex-shrink: 0;
}

.custom-glass-add-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.custom-glass-add-btn--active {
  background: transparent;
  border: 2rpx solid #00d042;
}

.custom-glass-add-btn--active text {
  color: #00d042;
}

/* 全尺寸卡片移除按钮 */
.custom-card-remove {
  position: absolute;
  right: 0;
  top: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.custom-card-remove-x {
  font-size: 36rpx;
  font-weight: 400;
  color: #c0c0c0;
}

.custom-card-span-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: #000;
  border-radius: 26rpx 0 16rpx 0;
  padding: 10rpx 24rpx;
  z-index: 10;
}

.custom-card-span-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 编辑模式 ===== */
.edit-mode-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
  flex-shrink: 0;
}

.edit-mode-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.edit-done-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 28rpx;
  background: #000;
  border-radius: 28rpx;
}

.edit-done-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

/* 滚动画布 */
.edit-scroll {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* 3 列网格 */
.edit-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 4rpx;
}

/* 网格卡片 */
.edit-card-item {
  background: rgba(255,255,255,0.3);
  border: 2rpx solid rgba(0,0,0,0.4);
  border-radius: 18rpx;
  padding: 12rpx 10rpx;
  box-shadow: 0rpx 4rpx 0rpx 1rpx rgba(0,0,0,0.15);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.edit-card-item--span1 {
  width: calc((100% - 32rpx) / 3);
}

.edit-card-item--span2 {
  width: calc((100% - 32rpx) * 2 / 3 + 16rpx);
}

.edit-card-item--span3 {
  width: 100%;
}

.edit-card-remove {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.edit-card-remove-x {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
}

/* FAB 添加按钮 */
.edit-add-fab {
  position: absolute;
  bottom: 24rpx;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  background: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.18);
  z-index: 90;
}

.edit-add-fab-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

/* 空态提示 */
.edit-empty-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.edit-empty-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #a0a0a0;
}

/* ===== 底部模版面板 ===== */
.template-panel-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.template-panel-mask--show {
  opacity: 1;
  pointer-events: auto;
}

.template-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 24rpx 60rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.template-panel--show {
  transform: translateY(0);
}

.template-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.template-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
}

.template-panel-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-panel-close-x {
  font-size: 28rpx;
  color: #999;
}

.template-panel-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
}
