.ledger-due-desc {
  font-size: 22rpx;
  color: #b0b0b0;
}
.ledger-due-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ledger-due-val {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.ledger-due-val--in { color: #00d042; }
.ledger-due-val--out { color: #ed2e2e; }
.ledger-due-arrow {
  width: 14rpx;
