page {
  background: #FAF7F2;
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 140rpx 26rpx 0;
  box-sizing: border-box;
  background: linear-gradient(160deg, #FAF7F2 0%, #F5F0E8 40%, #EDE8DF 100%);
}

/* ===== 平板适配：等比缩小关键尺寸（rpx 减半补偿） ===== */
.page--tablet {
  padding: 70rpx 13rpx 0;
}
.page--tablet .header {
  height: 40rpx;
  margin-top: 15rpx;
  margin-bottom: -10rpx;
}
.page--tablet .header-left {
  transform: translateY(-10rpx);
}
.page--tablet .year-text {
  font-size: 13rpx;
  top: -15rpx;
}
.page--tablet .date-month-num {
  font-size: 30rpx;
}
.page--tablet .date-month-label {
  font-size: 14rpx;
  margin-top: 10rpx;
}
.page--tablet .header-title {
  font-size: 18rpx;
}
.page--tablet .card {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
}
.page--tablet .card-title {
  font-size: 15rpx;
}
.page--tablet .card-subtitle {
  font-size: 11rpx;
}
.page--tablet .card-header {
  margin-bottom: 8rpx;
  padding-left: 46rpx;
}
.page--tablet .card-grid {
  overflow-y: auto;
}
.page--tablet .expand-menu-card {
  padding: 24rpx 20rpx;
}
.page--tablet .expand-icon-text {
  font-size: 18rpx;
}
.page--tablet .report-chart-stage {
  max-height: 35vh;
}
.page--tablet .report-canvas {
  width: 100%;
  height: 300rpx;
}
.page--tablet .report-pie-canvas {
  width: 180rpx;
  height: 180rpx;
}
.page--tablet .overview-canvas {
  height: 160rpx;
}
.page--tablet .book-sheet {
  height: 62vh;
  padding: 16rpx 20rpx 0;
}
.page--tablet .book-sheet--with-photo {
  height: 70vh;
}
.page--tablet .book-photo-thumb {
  width: 80rpx;
  height: 80rpx;
}
.page--tablet .book-photo-tag {
  font-size: 20rpx;
}
.page--tablet .book-photo-hint {
  font-size: 16rpx;
}
.page--tablet .book-photo-remove {
  width: 36rpx;
  height: 36rpx;
  font-size: 18rpx;
}
.page--tablet .book-amount-value {
  font-size: 36rpx;
}
.page--tablet .book-key {
  height: 56rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
}
.page--tablet .book-keypad {
  padding: 6rpx 0 12rpx;
}
.page--tablet .book-keypad-row {
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.page--tablet .book-btn-save {
  padding: 14rpx 0;
  font-size: 16rpx;
  border-radius: 10rpx;
}
.page--tablet .book-cat-select {
  padding: 10rpx 0;
}
.page--tablet .book-cat-select-val,
.page--tablet .book-cat-select-label {
  font-size: 15rpx;
}
.page--tablet .book-date-picker {
  padding: 10rpx 0;
}
.page--tablet .book-date-label,
.page--tablet .book-date-value {
  font-size: 15rpx;
}
.page--tablet .book-note-input {
  font-size: 15rpx;
}
.page--tablet .book-yen {
  font-size: 28rpx;
}
.page--tablet .expand-menu-item {
  padding: 12rpx 14rpx;
  gap: 10rpx;
}
.page--tablet .expand-menu-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}
.page--tablet .card-avatar {
  width: 36rpx;
  height: 36rpx;
}
.page--tablet .tab-icon-img {
  width: 36rpx;
  height: 36rpx;
}
.page--tablet .tab-icon-center-img {
  width: 50rpx;
  height: 50rpx;
}
.page--tablet .tab-label {
  font-size: 16rpx;
}
.page--tablet .tab-bar-wrapper {
  height: 90rpx;
  margin: 0 -13rpx;
}
.page--tablet .tab-bar {
  height: 72rpx;
  padding-bottom: 10rpx;
  border-radius: 20rpx 20rpx 0 0;
}
.page--tablet .tab-bar-center-btn {
  width: 100rpx;
  height: 100rpx;
  top: -20rpx;
}
.page--tablet .tab-center-label {
  font-size: 16rpx;
  bottom: 10rpx;
}
.page--tablet .bill-item {
  padding: 12rpx 0;
}
.page--tablet .bill-modal-mask {
  padding: 30rpx;
}
.page--tablet .my-group {
  margin-bottom: 16rpx;
}
.page--tablet .my-card {
  padding: 24rpx;
}

/* ---- 标题栏 ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  height: 80rpx;
  margin-top: 30rpx;
  margin-bottom: -20rpx;
  flex-shrink: 0;
  position: relative;
}
.header-left {
  position: relative;
  flex-shrink: 0;
  transform: translateY(-20rpx);
}
.year-text {
  font-size: 26rpx;
  color: #a0a0a0;
  font-weight: 500;
  position: absolute;
  top: -30rpx;
  left: 4rpx;
}
.date-badge {
  display: flex;
  align-items: center;
  margin-top: -4rpx;
  margin-bottom: 12rpx;
}
.date-month-num {
  font-size: 60rpx;
  font-weight: 500;
  color: #000;
}
.date-month-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
  margin-top: 20rpx;
  margin-left: 2rpx;
}
.date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 14rpx solid #999;
  margin-left: 4rpx;
  margin-top: 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
  position: absolute;
  left: 50%;
  transform: translate(-50%, -80rpx);
  align-self: center;
}
.header-right-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: -16rpx;
  flex-shrink: 0;
}
.header-right-icon {
  flex-shrink: 0;
}
.header-expand-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.expand-plus {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}
.expand-plus::before,
.expand-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  background: #666;
  border-radius: 2rpx;
}
.expand-plus::before {
  width: 30rpx;
  height: 4rpx;
  transform: translate(-50%, -50%);
}
.expand-plus::after {
  width: 4rpx;
  height: 30rpx;
  transform: translate(-50%, -50%);
}
.header-left-group {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex-shrink: 0;
}
.header-back-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 40rpx;
  padding: 12rpx 26rpx 12rpx 20rpx;
  flex-shrink: 0;
  margin-top: -16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.header-back-btn:active {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #888;
  border-bottom: 4rpx solid #888;
  transform: rotate(45deg);
}
.back-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  letter-spacing: 1rpx;
}
.header-search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 380rpx;
  height: 56rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}
.header-search-mic {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.mic-head {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 20rpx;
  border-radius: 7rpx;
  background: #888;
}
.mic-base {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 14rpx;
  border: 2rpx solid #888;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}
.mic-base::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 8rpx;
  background: #888;
}
.header-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #333;
}
.header-search-go {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-search-go:active { opacity: 0.5; }
.search-go-icon {
  font-size: 30rpx;
  line-height: 1;
  color: #888;
}
.invisible {
  visibility: hidden;
}

/* 拓展菜单 */
.expand-menu-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 7500;
  background: rgba(0,0,0,0.15);
  animation: expandFadeIn 0.2s ease-out;
}
.expand-menu-card {
  position: absolute;
  top: 170rpx;
  right: 30rpx;
  width: 380rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  border: 1rpx solid rgba(0,0,0,0.06);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  padding: 16rpx 0;
  animation: expandSlideDown 0.25s ease-out;
}
.expand-menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 20rpx;
  transition: background 0.15s;
}
.expand-menu-item:active { background: rgba(0,0,0,0.04); }
.expand-menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.expand-menu-icon--scan { background: #e8f5e9; }
.expand-menu-icon--category { background: #fff3e0; }
.expand-menu-icon--ai { background: #e3f2fd; }
.expand-icon-text { font-size: 28rpx; font-weight: 700; color: #4caf50; }
.expand-icon-text--cat { font-size: 22rpx; color: #ff9800; letter-spacing: -2rpx; }
.expand-icon-text--ai { font-size: 32rpx; color: #3a7bfd; }
.expand-menu-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
}
.expand-menu-arrow {
  font-size: 24rpx;
  color: #ccc;
  flex-shrink: 0;
}
.expand-menu-divider {
  height: 1rpx;
  background: rgba(0,0,0,0.06);
  margin: 8rpx 28rpx;
}
@keyframes expandFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes expandSlideDown {
  from { opacity: 0; transform: translateY(-24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- 卡片网格 ---- */
.card-grid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 10rpx 0 20rpx;
  overflow: hidden;
  position: relative;
}

.card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 26rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.grid-span-1 { flex: 1; }
.grid-span-2 { flex: 2; }
.grid-span-3 { flex: 3; }

/* ===== 简览页网格布局（span 控制宽度占列） ===== */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
}

.overview-grid .card {
  flex: none;
}

.overview-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.overview-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.overview-grid .grid-span-3 {
  width: 100%;
}

/* ---- 卡片内部 ---- */
.card-header {
  position: relative;
  padding-left: 82rpx;
  padding-top: 12rpx;
  flex-shrink: 0;
}
.card-header.compact {
  padding-left: 0;
}
.card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #ccc;
}
.card-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}
.card-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
  position: absolute;
  right: 0;
  top: 0;
}
.card-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  display: block;
  margin-top: 2rpx;
}
.card-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}
.card-divider--tight {
  margin-top: -18rpx;
}
.card-divider--down {
  position: relative;
  top: 20rpx;
}

/* ---- 卡片行 ---- */
.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}
.card-row.three-col {
  justify-content: space-between;
}
.col-label {
  font-size: 37rpx;
  font-weight: 500;
  color: #a0a0a0;
  text-align: center;
  flex: 1;
}
.row-label {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* ---- 金额标签 ---- */
.value-tag {
  display: flex;
  align-items: baseline;
}
.three-col .value-tag {
  flex: 1;
  justify-content: center;
}
.value-yen {
  font-size: 34rpx;
  font-weight: 500;
}
.value-num {
  font-size: 42rpx;
  font-weight: 500;
}
.green .value-yen,
.green .value-num {
  color: #00d042;
}
.red .value-yen,
.red .value-num {
  color: red;
}

/* ---- 占位卡片 ---- */
.placeholder-card {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* ---- 底部 TabBar ---- */
.tab-bar-wrapper {
  position: relative;
  height: 129rpx;
  z-index: 999;
  overflow: visible;
  flex-shrink: 0;
  margin: 0 -26rpx;
}
.tab-bar-center-btn {
  position: absolute;
  top: -26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-center-label {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  letter-spacing: 6rpx;
  pointer-events: none;
}
.tab-bar {
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 0;
  right: 0;
  height: 103rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding-bottom: 16rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.tab-item--push-left {
  margin-right: 24rpx;
}
.tab-item--push-right {
  margin-left: 24rpx;
}
.tab-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
}
.tab-icon-center-img {
  width: 70rpx;
  height: 70rpx;
}
.tab-icon-img {
  width: 56rpx;
  height: 56rpx;
}
.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
  letter-spacing: 6rpx;
}
.tab-label-active {
  color: #000;
}

/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  padding: 24rpx 36rpx;
  justify-content: space-evenly;
}

.my-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 头像区 */
.my-profile {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.my-login-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-nickname {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
}
.my-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* 列表项 */
.my-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
/* 图标行卡片 */
.my-icon-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.8);
  border-radius: 22rpx;
  padding: 23rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}
.my-icon-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
}
.my-icon-circle-img {
  width: 100%;
  height: 100%;
}
.my-icon-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #a0a0a0;
}
.my-icon-row-arrow {
  font-size: 28rpx;
  font-weight: 500;
  color: #d1d1d1;
}

/* ---- 报表卡片 ---- */
.report-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.report-title {
  font-size: 37rpx;
  font-weight: 500;
  color: #000;
}

/* 个人/公司 切换钮 */
.report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 190rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.report-type-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: inset 0rpx 2rpx 6rpx rgba(0,0,0,0.15);
}
.report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 95rpx;
  height: 42rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 22rpx;
  transition: left 0.25s ease;
}
.report-type-slider--right {
  left: 95rpx;
}
.report-type-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(0,0,0,0.35);
  z-index: 1;
  transition: color 0.25s ease;
}
.report-type-text--active {
  color: #000;
}

/* 周期切换条：月度/季度/年度/日度 */
.report-period-bar {
  display: flex;
  flex-shrink: 0;
}
.report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255,255,255,0.8);
  border: 1rpx solid rgba(0,0,0,0.06);
  border-right: none;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.1);
}
.report-period-item:first-child {
  border-radius: 26rpx 0 0 26rpx;
}
.report-period-item:last-child {
  border-radius: 0 26rpx 26rpx 0;
