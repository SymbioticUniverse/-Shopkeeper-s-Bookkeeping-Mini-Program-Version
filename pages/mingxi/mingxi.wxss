/* ========== 记账入口卡片 ========== */
.book-entry-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  min-height: 160rpx;
}

.book-entry-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}
.book-entry-dot--in { background: #4caf50; }
.book-entry-dot--out { background: #f44336; }
.book-entry-dot--transfer { background: #2196f3; }

.book-entry-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* ========== 记账半屏弹窗 ========== */
.book-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

.book-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 55vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 0;
}
.book-sheet--with-photo { height: 64vh; }

/* 记账弹窗 - 凭证预览行 */
.book-photo-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}
.book-photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}
.book-photo-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.book-photo-tag { font-size: 28rpx; font-weight: 600; color: #333; }
.book-photo-hint { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.book-photo-remove {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #888;
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}

/* 凭证识别中 overlay */
.scan-recog-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9000;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: modalFadeIn 0.28s ease-out;
}
.scan-recog-card {
  width: 560rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border-radius: 28rpx;
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
  animation: modalSlideUp 0.28s ease-out;
}
.scan-recog-frame {
  position: relative;
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.scan-recog-photo { width: 100%; height: 100%; }
.scan-recog-line {
  position: absolute;
  left: 0; right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, transparent, #07C160, transparent);
  box-shadow: 0 0 20rpx 4rpx rgba(7,193,96,0.6);
  animation: scanLine 1.6s linear infinite;
}
.scan-recog-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-top: 28rpx;
  letter-spacing: 2rpx;
}
@keyframes scanLine {
  0% { top: 0; }
  50% { top: calc(100% - 6rpx); }
  100% { top: 0; }
}

/* 详情弹窗凭证缩略图 */
.bill-modal-voucher {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

/* 暗色模式 - 扫描凭证 */
.page--dark .book-photo-row { border-bottom-color: #333; }
.page--dark .book-photo-tag { color: #eee; }
.page--dark .book-photo-hint { color: #888; }
.page--dark .book-photo-thumb { background: #2a2a3a; }
.page--dark .book-photo-remove { background: #2a2a3a; color: #aaa; }
.page--dark .scan-recog-card {
  background: rgba(30,30,46,0.95);
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.4);
}
.page--dark .scan-recog-text { color: #e0e0e0; }
.page--dark .bill-modal-voucher { background: #2a2a3a; }

/* ---- 自定义相机扫描页 ---- */
.camera-page {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9500;
  background: #000;
  animation: modalFadeIn 0.28s ease-out;
}
.camera-view {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}

/* 左上角返回 */
.camera-back {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 32rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
}
.camera-back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-top: 5rpx solid #fff;
  border-left: 5rpx solid #fff;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  margin-left: 6rpx;
}

/* 取景框 */
.camera-scan-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 540rpx;
  height: 680rpx;
  transform: translate(-50%, -54%);
  border: 4rpx solid rgba(255,255,255,0.55);
  border-radius: 28rpx;
  box-shadow: 0 0 0 2000rpx rgba(0,0,0,0.28);
}
.camera-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 380rpx);
  color: rgba(255,255,255,0.92);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}

/* 底部操作栏 */
.camera-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  padding: 0 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.camera-album {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.16);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
}
.camera-album-icon {
  position: relative;
  width: 44rpx;
  height: 36rpx;
  border: 4rpx solid #fff;
  border-radius: 8rpx;
  overflow: hidden;
}
.camera-album-icon::before {
  content: '';
  position: absolute;
  top: 6rpx;
  right: 7rpx;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #fff;
}
.camera-album-icon::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: -2rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 18rpx solid #fff;
}

/* 快门 */
.camera-shutter {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}
.camera-shutter:active { transform: scale(0.92); }
.camera-shutter-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
}
.camera-bar-spacer {
  width: 88rpx;
  height: 88rpx;
}


.book-type-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.book-type-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #888;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-weight: 500;
}
.book-type-tab--active {
  color: #fff;
  font-weight: 600;
}
.book-type-tab--income.book-type-tab--active { background: #07C160; }
.book-type-tab--expense.book-type-tab--active { background: #e74c3c; }
.book-type-tab--payForward.book-type-tab--active { background: #f0ad4e; }
.book-type-tab--payable.book-type-tab--active { background: #4a90d9; }

.book-scope-bar {
  display: flex;
  background: #f0f0f0;
  border-radius: 20rpx;
  padding: 6rpx;
  flex-shrink: 0;
}
.book-scope-tab {
  width: 160rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #999;
  border-radius: 16rpx;
  font-weight: 600;
}
.book-scope-tab--active {
  background: #07C160;
  color: #fff;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.35);
}
.page--dark .book-scope-bar { background: #2a2a3a; }
.page--dark .book-scope-tab--active { background: #07C160; color: #fff; }

.book-amount-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.book-amount-left {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.book-yen {
  font-size: 40rpx;
  font-weight: 300;
  color: #333;
  margin-right: 8rpx;
}


/* 金额显示 */
.book-amount-value {
  font-size: 56rpx;
  font-weight: 600;
  color: #333;
}

/* 数字键盘 */
.book-keypad {
  padding: 8rpx 0 16rpx;
}

.book-keypad-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.book-key {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.book-key:active {
  background: #e0e0e0;
}

.book-key--dot {
  font-size: 40rpx;
}

.book-key--del {
  background: #e8e8e8;
}

.page--dark .book-key {
  background: #2a2a3a;
  color: #e0e0e0;
}
.page--dark .book-key:active {
  background: #3a3a4e;
}
.page--dark .book-key--del {
  background: #333;
}
.page--dark .book-amount-value {
  color: #e0e0e0;
}

.book-cat-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.book-cat-select-label {
  font-size: 24rpx;
  color: #fff;
  background: #4a90d9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.book-cat-select-label:first-child {
  background: #07C160;
}
.book-cat-select-sep {
  font-size: 24rpx;
  color: #ccc;
}
.book-cat-select-val {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.book-cat-select-arrow {
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
}

.book-cat-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}

.book-target-tag {
  font-size: 24rpx;
  color: #e8a735;
  background: rgba(232,167,53,0.12);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.page--dark .book-target-tag { background: rgba(232,167,53,0.2); color: #f0c060; }

.page--dark .book-cat-select { border-bottom-color: #333; }
.page--dark .book-cat-select-val { color: #e0e0e0; }

/* 分类选择面板 */
.book-cat-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 60vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1002;
  display: flex;
  flex-direction: column;
  padding: 28rpx 28rpx 0;
}
.book-cat-panel-scope {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}
.book-cat-panel-grid {
  flex: 1;
  margin-top: 20rpx;
}
.book-cat-panel-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 40rpx;
}
.book-cat-panel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc((100% - 80rpx) / 6);
  padding: 12rpx 0;
}
.book-cat-panel-emoji {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 18rpx;
  font-size: 34rpx;
}
.book-cat-panel-name {
  font-size: 20rpx;
  color: #888;
}

.page--dark .book-cat-select { border-bottom-color: #333; }
.page--dark .book-cat-panel { background: #1e1e2e; }
.page--dark .book-cat-panel-emoji { background: #2a2a3a; }
.page--dark .book-cat-panel-name { color: #aaa; }

.book-note-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #999;
  height: 48rpx;
  text-align: right;
  margin-left: 16rpx;
}

.book-date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #888;
}
.book-date-row picker {
  width: 100%;
}
.book-date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.book-btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
  padding: 20rpx 0 40rpx;
}

.book-btn-cancel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #f5f5f5;
  color: #888;
}

.book-btn-save {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4a90d9, #6c5ce7);
  color: #fff;
}

/* ========== 深色模式 ========== */
.page--dark .book-entry-card { background: #2a2a3a !important; }
.page--dark .book-entry-text { color: #e0e0e0 !important; }
.page--dark .book-sheet { background: #1e1e2e; }
.page--dark .book-type-bar { background: #2a2a3a; }
.page--dark .book-type-tab { background: #2a2a3a; color: #888; }
.page--dark .book-type-bar { background: transparent; }
.page--dark .book-type-tab--income.book-type-tab--active { background: #07C160; color: #fff; }
.page--dark .book-type-tab--expense.book-type-tab--active { background: #e74c3c; color: #fff; }
.page--dark .book-type-tab--payForward.book-type-tab--active { background: #f0ad4e; color: #fff; }
.page--dark .book-type-tab--payable.book-type-tab--active { background: #4a90d9; color: #fff; }
.page--dark .book-yen { color: #e0e0e0 !important; }
.page--dark .book-amount-row { border-bottom-color: #333; }
.page--dark .book-note-input { color: #aaa; }
.page--dark .book-date-row { border-bottom-color: #333; }
.page--dark .book-date-row { color: #aaa; }
.page--dark .book-btn-cancel { background: #2a2a3a; color: #aaa; }

/* ========== 首次启动引导 ========== */
.guide-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  background: linear-gradient(160deg, #FAF7F2 0%, #F5F0E8 40%, #EDE8DF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.guide-card {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255,255,255,0.6);
  padding: 56rpx 44rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 24rpx rgba(0,0,0,0.06),
    0 24rpx 64rpx rgba(0,0,0,0.08);
}

/* Logo */
.guide-logo {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #3a7bfd 0%, #6c5ce7 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(58,123,253,0.3);
  margin-bottom: 12rpx;
}
.guide-logo-icon {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 60rpx;
}
.guide-logo-bar {
  width: 14rpx;
  border-radius: 4rpx;
  background: rgba(255,255,255,0.9);
}
.guide-logo-bar--1 { height: 28rpx; }
.guide-logo-bar--2 { height: 48rpx; }
.guide-logo-bar--3 { height: 36rpx; }

.guide-app-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 6rpx;
  margin-top: 28rpx;
}
.guide-slogan {
  font-size: 26rpx;
  color: #888;
  margin-top: 12rpx;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}
.guide-card-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}
.guide-card-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 28rpx;
}
.guide-btn {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #4a8afe 0%, #3a7bfd 50%, #2d6ce0 100%);
  border-radius: 46rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  letter-spacing: 3rpx;
  box-shadow: 0 6rpx 20rpx rgba(58,123,253,0.3);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.guide-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(58,123,253,0.2);
}
.guide-form {
  width: 100%;
  margin-top: 20rpx;
}
.guide-input-row {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border: 1rpx solid rgba(0,0,0,0.05);
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 92rpx;
  margin-bottom: 16rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.guide-prefix {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}
.guide-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 92rpx;
}
.guide-code-btn {
  font-size: 26rpx;
  color: #3a7bfd;
  font-weight: 600;
  white-space: nowrap;
  padding: 10rpx 20rpx;
  background: rgba(58,123,253,0.08);
  border-radius: 12rpx;
}
.guide-code-btn--disabled {
  color: #ccc;
  background: transparent;
}
.guide-divider-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 28rpx 0;
  gap: 20rpx;
}
.guide-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.08) 50%, transparent 100%);
}
.guide-divider-text {
  font-size: 24rpx;
  color: #ccc;
}
.guide-wx-btn {
  width: 100% !important;
  height: 92rpx;
  background: linear-gradient(135deg, #1aad5a 0%, #07C160 50%, #06a855 100%) !important;
  border-radius: 46rpx;
  color: #fff !important;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 92rpx;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.25);
  transition: transform 0.15s ease;
}
.guide-wx-btn:active {
  transform: scale(0.97);
}
.guide-wx-btn::after { border: none; }

/* Role buttons */
.guide-role-btn {
  width: 100%;
  padding: 28rpx 24rpx;
  background: #f7f8fa;
  border: 1rpx solid rgba(0,0,0,0.04);
  border-radius: 22rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: background 0.15s ease, transform 0.1s ease;
}
.guide-role-btn:active {
  background: #eef1f6;
  transform: scale(0.98);
}
.guide-role-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}
.guide-role-icon--boss {
  background: linear-gradient(135deg, #ff9500 0%, #ff6b00 100%);
  box-shadow: 0 4rpx 12rpx rgba(255,149,0,0.3);
}
.guide-role-icon--emp {
  background: linear-gradient(135deg, #3a7bfd 0%, #2d6ce0 100%);
  box-shadow: 0 4rpx 12rpx rgba(58,123,253,0.3);
}
.guide-role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.guide-role-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.guide-role-hint {
  font-size: 24rpx;
  color: #999;
}
.guide-role-arrow {
  font-size: 28rpx;
  color: #ccc;
  font-weight: 300;
  flex-shrink: 0;
}
.guide-skip {
  font-size: 28rpx;
  color: #999;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  transition: color 0.15s ease;
}
.guide-skip:active {
  color: #666;
}
.guide-back {
  font-size: 28rpx;
  color: #3a7bfd;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  font-weight: 600;
}
.guide-back:active {
  opacity: 0.7;
}
.guide-uid-row {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border: 1rpx solid rgba(0,0,0,0.04);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.guide-uid-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.guide-uid-value {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  font-family: monospace;
}
.guide-uid-gen {
  font-size: 26rpx;
  color: #3a7bfd;
  font-weight: 600;
  padding: 10rpx 24rpx;
  background: rgba(58, 123, 253, 0.08);
  border-radius: 12rpx;
  flex-shrink: 0;
}
.guide-uid-gen:active {
  background: rgba(58, 123, 253, 0.15);
}
.guide-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 40rpx;
}
.guide-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.guide-dot--active {
  background: #3a7bfd;
  width: 30rpx;
  border-radius: 5rpx;
}

/* 引导页暗色模式 */
.page--dark .guide-overlay {
  background: linear-gradient(to top, #1a1a2e 0%, #16213e 37%, #1a1a3e 62%, #16213e 100%);
}
.page--dark .guide-card {
  background: rgba(30,30,46,0.95);
  border-color: rgba(255,255,255,0.08);
  box-shadow:
    0 2rpx 4rpx rgba(0,0,0,0.1),
    0 8rpx 24rpx rgba(0,0,0,0.2),
    0 24rpx 64rpx rgba(0,0,0,0.3);
}
.page--dark .guide-logo {
  background: linear-gradient(135deg, #4a8afe 0%, #6c5ce7 100%);
  box-shadow: 0 8rpx 28rpx rgba(58,123,253,0.2);
}
.page--dark .guide-app-name { color: #e8e8f0; }
.page--dark .guide-slogan { color: #777; }
.page--dark .guide-card-title { color: #e8e8f0; }
.page--dark .guide-card-desc { color: #666; }
.page--dark .guide-input-row {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.08);
}
.page--dark .guide-input { color: #e0e0e0; }
.page--dark .guide-prefix { color: #ccc; }
.page--dark .guide-code-btn { background: rgba(58,123,253,0.15); }
.page--dark .guide-divider-line {
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
}
.page--dark .guide-role-btn {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.06);
}
.page--dark .guide-role-btn:active { background: rgba(255,255,255,0.1); }
.page--dark .guide-role-label { color: #e0e0e0; }
.page--dark .guide-role-hint { color: #666; }
.page--dark .guide-role-arrow { color: #555; }
.page--dark .guide-uid-row {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.06);
}
.page--dark .guide-uid-label { color: #aaa; }
.page--dark .guide-uid-value { color: #e0e0e0; }
.page--dark .guide-dot { background: rgba(255, 255, 255, 0.12); }

/* ========== AI 对话窗口 ========== */
.ai-chat-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 8000;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.ai-chat-card {
  width: 100%;
  height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.12);
  overflow: hidden;
}
.ai-chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  flex-shrink: 0;
}
.ai-chat-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.ai-chat-close {
  font-size: 44rpx;
  color: #999;
  padding: 4rpx 16rpx;
  line-height: 1;
}

/* 录音中指示器 */
.ai-recording-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 0;
  background: linear-gradient(135deg, rgba(255,59,48,0.06) 0%, rgba(255,59,48,0.02) 100%);
  border-bottom: 1rpx solid rgba(255,59,48,0.1);
  flex-shrink: 0;
}
.ai-recording-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff3b30;
  animation: aiRecPulse 1s infinite ease-in-out;
}
@keyframes aiRecPulse {
  0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 0 rgba(255,59,48,0.4); }
  50% { opacity: 0.7; transform: scale(1.3); box-shadow: 0 0 0 8rpx rgba(255,59,48,0); }
}
.ai-recording-text {
  font-size: 26rpx;
  color: #ff3b30;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.ai-chat-messages {
  flex: 1;
  min-height: 0;
  padding: 24rpx 0;
}
.ai-msg {
  margin-bottom: 28rpx;
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}
.ai-msg-bubble {
  max-width: 75%;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.ai-msg-bubble--user {
  align-self: flex-end;
  background: linear-gradient(135deg, #4a8afe 0%, #3a7bfd 100%);
  color: #fff;
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(58,123,253,0.2);
}
.ai-msg-bubble--ai {
  align-self: flex-start;
  background: #f5f7fa;
  color: #333;
  border-bottom-left-radius: 8rpx;
}

/* 含卡片的 AI 消息：气泡撑满宽度 + 去背景/内边距，卡片自行控宽 */
.ai-msg-bubble--ai-card {
  align-self: stretch;
  max-width: 100%;
  background: transparent;
  padding: 0;
}

/* AI 对话内账单卡片 — 撑满屏宽，3行布局 */
.ai-bill-card {
  margin-top: 16rpx;
  margin-left: -36rpx;
  margin-right: -36rpx;
  border-radius: 16rpx;
  padding: 24rpx 32rpx 18rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.ai-bill-card--out { background: #7e0000; }
.ai-bill-card--in { background: #3a762e; }
.ai-bill-card--payForward { background: #6b3a00; }
.ai-bill-card--payable { background: #1a3a5c; }

/* Row 1: Amount + Type */
.ai-bill-row--main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ai-bill-amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.ai-bill-currency {
  font-size: 32rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.6);
}
.ai-bill-amount-input {
  width: 180rpx;
  height: 56rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  background: transparent;
}
.ai-bill-tag-picker {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.15);
}
.ai-bill-tag-picker--out { background: rgba(255,255,255,0.18); }
.ai-bill-tag-picker--in { background: rgba(255,255,255,0.18); }
.ai-bill-tag-picker--payForward { background: rgba(255,180,100,0.3); }
.ai-bill-tag-picker--payable { background: rgba(100,180,255,0.3); }
.ai-bill-tag-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

/* Row 2: Category + Date + Target chips */
.ai-bill-row--fields {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ai-bill-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.1);
  flex: 1;
  justify-content: center;
  min-width: 0;
}
.ai-bill-chip-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Row 3: Note */
.ai-bill-row--note {
  display: flex;
}
.ai-bill-input {
  flex: 1;
  height: 52rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #fff;
}

/* Arrow for all pickers */
.ai-bill-arrow {
  font-size: 16rpx;
  color: rgba(255,255,255,0.35);
  flex-shrink: 0;
}

/* Confirmed / cancelled card elements */
.ai-bill-row { display: flex; align-items: center; gap: 12rpx; }
.ai-bill-row--bottom { justify-content: space-between; }
.ai-bill-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  flex-shrink: 0;
}
.ai-bill-cat {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.9);
}
.ai-bill-type {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.ai-bill-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
.ai-bill-date {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  align-self: flex-end;
}
.ai-bill-target-confirmed {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.12);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.ai-bill-link {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  margin-left: auto;
}

/* Buttons */
.ai-bill-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255,255,255,0.12);
}
.ai-bill-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
}
.ai-bill-btn--reject {
  background: #fff;
  color: #333;
}
.ai-bill-btn--confirm {
  background: #34c759;
  color: #fff;
}
.ai-bill-btn--confirm:active {
  background: #2db14e;
}
.ai-bill-btn--reject:active {
  background: #e5e5e5;
}
/* 已取消卡片 */
.ai-bill-card--rejected {
  background: rgba(255,255,255,0.05) !important;
  opacity: 0.45;
}
.ai-bill-card--rejected .ai-bill-amount {
  text-decoration: line-through;
}
.ai-cancel-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  margin-top: 14rpx;
  padding: 10rpx 12rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 8rpx;
  border-left: 4rpx solid rgba(255,255,255,0.2);
}

.ai-msg-time {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 8rpx;
}
.ai-msg-time--user {
  align-self: flex-end;
}
.ai-msg-time--ai {
  align-self: flex-start;
}
.ai-thinking-dots {
  display: flex;
  gap: 8rpx;
  padding: 6rpx 4rpx;
}
.ai-thinking-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #bbb;
  animation: aiDotPulse 1.2s infinite ease-in-out;
}
.ai-thinking-dot:nth-child(2) { animation-delay: 0.2s; }
.ai-thinking-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes aiDotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.1); }
}
.ai-chat-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
  background: #fff;
  flex-shrink: 0;
}
.ai-chat-input {
  flex: 1;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}
.ai-chat-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s ease, transform 0.1s ease;
}
.ai-chat-send--active {
  background: linear-gradient(135deg, #4a8afe 0%, #3a7bfd 100%);
  box-shadow: 0 4rpx 12rpx rgba(58,123,253,0.25);
}
.ai-chat-send:active { transform: scale(0.92); }
.ai-send-arrow {
  font-size: 34rpx;
  color: #fff;
  font-weight: 700;
  margin-top: -4rpx;
}

/* 模式切换 */
.ai-input-toggle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #f0f1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ai-toggle-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #666;
}

/* 语音按钮 */
.ai-voice-btn {
  flex: 1;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0,0,0,0.06);
  transition: background 0.15s ease, transform 0.1s ease;
}
.ai-voice-btn:active,
.ai-voice-btn--recording {
  background: linear-gradient(135deg, #4a8afe 0%, #3a7bfd 100%);
  border-color: transparent;
  transform: scale(1.02);
}
.ai-voice-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  letter-spacing: 4rpx;
}
.ai-voice-btn--recording .ai-voice-text,
.ai-voice-btn:active .ai-voice-text {
  color: #fff;
}

/* AI 对话暗色模式 */
.page--dark .ai-chat-card {
  background: #1e1e2e;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.35);
}
.page--dark .ai-chat-header { border-bottom-color: rgba(255,255,255,0.08); }
.page--dark .ai-chat-title { color: #e0e0e0; }
.page--dark .ai-chat-close { color: #666; }
.page--dark .ai-recording-banner {
  background: linear-gradient(135deg, rgba(255,59,48,0.1) 0%, rgba(255,59,48,0.04) 100%);
  border-bottom-color: rgba(255,59,48,0.15);
}
.page--dark .ai-msg-bubble--ai { background: #2a2a3a; color: #e0e0e0; }
.page--dark .ai-msg-time { color: #555; }
.page--dark .ai-thinking-dot { background: #666; }
.page--dark .ai-chat-input-bar {
  border-top-color: rgba(255,255,255,0.08);
  background: #1e1e2e;
}
.page--dark .ai-chat-input { background: #2a2a3a; color: #e0e0e0; }
.page--dark .ai-chat-send { background: #333; }
.page--dark .ai-input-toggle { background: #2a2a3a; }
.page--dark .ai-toggle-label { color: #aaa; }
.page--dark .ai-voice-btn { background: #2a2a3a; border-color: rgba(255,255,255,0.08); }
.page--dark .ai-voice-text { color: #aaa; }
.page--dark .ai-bill-btn--reject { background: #555; color: #ddd; }
.page--dark .ai-bill-btn--confirm { background: #34c759; }
.page--dark .ai-cancel-hint { color: rgba(255,255,255,0.3); }

/* 暗色模式 - 拓展菜单 */
.page--dark .header-expand-btn {
  background: rgba(30,30,46,0.9);
  border-color: rgba(255,255,255,0.08);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}
.page--dark .expand-plus::before,
.page--dark .expand-plus::after { background: #aaa; }
.page--dark .expand-menu-overlay { background: rgba(0,0,0,0.4); }
.page--dark .expand-menu-card {
  background: rgba(30,30,46,0.95);
  border-color: rgba(255,255,255,0.08);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3);
}
.page--dark .expand-menu-label { color: #e0e0e0; }
.page--dark .expand-menu-arrow { color: #666; }
.page--dark .expand-menu-divider { background: rgba(255,255,255,0.06); }
.page--dark .expand-menu-item:active { background: rgba(255,255,255,0.06); }
.page--dark .expand-menu-icon--scan { background: #1a3a1e; }
.page--dark .expand-menu-icon--category { background: #3a2a1a; }
.page--dark .expand-menu-icon--ai { background: #1a2a3a; }

/* ===== 语音录入指示器（按钮附近） ===== */
.ai-voice-indicator {
  position: fixed;
  bottom: 180rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9000;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.18s ease, visibility 0.18s ease;
  background: rgba(7, 193, 96, 0.92);
  border-radius: 28rpx;
  padding: 28rpx 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 36rpx rgba(7, 193, 96, 0.35);
}
.ai-voice-indicator--show {
  opacity: 1;
  visibility: visible;
}
.ai-voice-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
}
.ai-voice-bar {
  width: 8rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 4rpx;
  animation: voiceWave 0.8s ease-in-out infinite;
}
.ai-voice-bar:nth-child(1) { height: 20rpx; animation-delay: 0s; }
.ai-voice-bar:nth-child(2) { height: 40rpx; animation-delay: 0.12s; }
.ai-voice-bar:nth-child(3) { height: 56rpx; animation-delay: 0.24s; }
.ai-voice-bar:nth-child(4) { height: 40rpx; animation-delay: 0.36s; }
.ai-voice-bar:nth-child(5) { height: 20rpx; animation-delay: 0.48s; }
@keyframes voiceWave {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1.2); }
}
.ai-voice-tip {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.page--dark .ai-voice-indicator {
  background: rgba(7, 193, 96, 0.85);
  box-shadow: 0 8rpx 36rpx rgba(7, 193, 96, 0.25);
}

/* ===== 资料设置弹窗（昵称/头像） ===== */
.profile-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-modal {
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.18);
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.profile-modal-title {
  font-size: 37rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.profile-modal-subtitle {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 36rpx;
}
.profile-avatar-pick {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}
.profile-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-avatar-ph {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 头像右下角相机角标：提示「可更换」 */
.profile-avatar-badge {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #00d042;
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 208, 66, 0.35);
}
.profile-avatar-badge-ico {
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
}
.profile-avatar-tip {
  font-size: 22rpx;
  color: #999;
  margin: 18rpx 0 30rpx;
}
.profile-field {
  width: 100%;
  margin-bottom: 36rpx;
}
.profile-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 14rpx;
}
.profile-field-label {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.profile-field-count {
  font-size: 22rpx;
  color: #bbb;
}
.profile-name-input {
  width: 100%;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}
.profile-name-ph {
  color: #bbb;
}
.profile-modal-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}
.profile-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.profile-btn--skip {
  background: #f2f3f5;
  color: #333;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.profile-btn--skip:active {
  background: #e7e9ec;
}
.profile-btn--save:active {
  box-shadow: 0 4rpx 12rpx rgba(0, 208, 66, 0.3);
  transform: translateY(1rpx);
}
.profile-btn--save {
  background: #00d042;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 208, 66, 0.3);
}
.profile-btn--save.is-disabled {
  opacity: 0.5;
}
/* 我的页空头像加号占位 */
.my-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.06);
}
.my-avatar-plus {
  font-size: 44rpx;
  color: #bbb;
  line-height: 1;
}
/* 暗色适配 */
.page--dark .profile-modal {
  background: #1e1e1e;
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.5);
}
.page--dark .profile-modal-title { color: #fff; }
.page--dark .profile-modal-subtitle { color: #888; }
.page--dark .profile-avatar-pick { background: rgba(255, 255, 255, 0.08); }
.page--dark .profile-avatar-badge { border-color: #1e1e1e; }
.page--dark .profile-field-label { color: #fff; }
.page--dark .profile-name-input {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}
.page--dark .profile-name-ph { color: #777; }
.page--dark .profile-btn--skip {
  background: rgba(255, 255, 255, 0.12);
  color: #eee;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.page--dark .profile-btn--skip:active {
  background: rgba(255, 255, 255, 0.18);
}
.page--dark .my-avatar--empty { background: rgba(255, 255, 255, 0.1); }

/* ---- 报表筛选汇总 ---- */
.report-summary {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  margin-top: 16rpx;
  padding: 22rpx 22rpx 8rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}
.rsum-totals {
  display: flex;
}
.rsum-tot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
}
.rsum-tot + .rsum-tot::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: rgba(0, 0, 0, 0.06);
}
.rsum-tot-label {
  font-size: 22rpx;
  color: #a0a0a0;
}
.rsum-tot-val {
  font-size: 36rpx;
  font-weight: 700;
}
.rsum-tot-val--in { color: #00d042; }
.rsum-tot-val--out { color: #ed2e2e; }
.rsum-empty,
.rsum-locked {
  margin-top: 8rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #b8b8b8;
}
.rsum-group {
  margin-top: 24rpx;
}
.rsum-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.rsum-group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.rsum-group-sum {
  font-size: 26rpx;
  font-weight: 600;
}
.rsum-group-sum--in { color: #00d042; }
.rsum-group-sum--out { color: #ed2e2e; }
.rsum-cat {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}
.rsum-cat + .rsum-cat {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}
.rsum-cat-emoji {
  width: 40rpx;
  font-size: 28rpx;
  text-align: center;
}
.rsum-cat-name {
  width: 132rpx;
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rsum-cat-bar {
  flex: 1;
  height: 12rpx;
  margin: 0 16rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 6rpx;
  overflow: hidden;
}
.rsum-cat-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  min-width: 4rpx;
}
.rsum-cat-bar-fill--in { background: #00d042; }
.rsum-cat-bar-fill--out { background: #ed2e2e; }
.rsum-cat-pct {
  width: 60rpx;
  font-size: 22rpx;
  color: #a0a0a0;
  text-align: right;
}
.rsum-cat-amt {
  width: 140rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}
.rsum-cat-amt--in { color: #00d042; }
.rsum-cat-amt--out { color: #ed2e2e; }

.page--dark .report-summary {
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}
.page--dark .rsum-tot + .rsum-tot::before { background: rgba(255, 255, 255, 0.08); }
.page--dark .rsum-group-name,
.page--dark .rsum-cat-name { color: #e6e6e6; }
.page--dark .rsum-cat + .rsum-cat { border-top-color: rgba(255, 255, 255, 0.06); }
.page--dark .rsum-cat-bar { background: rgba(255, 255, 255, 0.08); }
.page--dark .rsum-tot-label,
.page--dark .rsum-cat-pct,
.page--dark .rsum-empty,
.page--dark .rsum-locked { color: #888; }

/* ---- 报表图表三合一：切换 tab + 共用舞台 ---- */
.report-chart-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 6rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 14rpx;
}
.rct-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #a0a0a0;
  border-radius: 10rpx;
  transition: color 0.2s, background 0.2s;
}
.rct-tab--active {
  color: #fff;
  background: #00d042;
  font-weight: 600;
}
.report-chart-stage {
  flex-shrink: 1;
  display: flex;
  flex-direction: column;
  min-height: 120rpx;
  max-height: 45vh;
  overflow: hidden;
}
.page--dark .report-chart-tabs { background: rgba(255, 255, 255, 0.06); }
.page--dark .rct-tab { color: #888; }
.page--dark .rct-tab--active { color: #fff; background: #00d042; }

/* ---- 报表汇总底部：导出引导 ---- */
.rsum-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 0 8rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}
.rsum-more-tip {
  font-size: 22rpx;
  color: #b0b0b0;
}
.rsum-export-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: #00d042;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 208, 66, 0.25);
}
.rsum-export-btn:active { opacity: 0.85; }
.page--dark .rsum-footer { border-top-color: rgba(255, 255, 255, 0.06); }

/* ---- 冲突解决面板 ---- */
.conflict-panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.conflict-panel {
  width: 620rpx;
  max-height: 85vh;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.12);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  overflow-y: auto;
}
.conflict-panel-header { text-align: center; }
.conflict-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
  display: block;
}
.conflict-panel-subtitle {
  font-size: 24rpx;
  color: #a0a0a0;
  margin-top: 6rpx;
  display: block;
}
.conflict-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.conflict-progress-text {
  font-size: 22rpx;
  color: #a0a0a0;
  flex-shrink: 0;
}
.conflict-progress-bar {
  flex: 1;
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
}
.conflict-progress-fill {
  height: 100%;
  background: #34c759;
  border-radius: 3rpx;
  transition: width 0.3s;
}
.conflict-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.conflict-reason {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff3cd;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.conflict-reason-icon {
  width: 36rpx;
  height: 36rpx;
  background: #ff9500;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.conflict-reason-text {
  font-size: 24rpx;
  color: #856404;
  flex: 1;
}
.conflict-version {
  background: #f8f9fa;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.conflict-version--deleted {
  background: #fef2f2;
  border: 1rpx dashed #fca5a5;
}
.conflict-version-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.conflict-version-label {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.conflict-version-label--local {
  background: #e3f2fd;
  color: #1565c0;
}
.conflict-version-label--server {
  background: #e8f5e9;
  color: #2e7d32;
}
.conflict-version-label--deleted {
  background: #fef2f2;
  color: #dc2626;
}
.conflict-version-badge {
  font-size: 18rpx;
  color: #ff9500;
  background: #fff3cd;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
.conflict-item-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.conflict-item-icon { font-size: 28rpx; }
.conflict-item-cat { font-size: 26rpx; font-weight: 500; color: #333; }
.conflict-item-type { font-size: 22rpx; color: #a0a0a0; margin-left: auto; }
.conflict-item-amount { font-size: 34rpx; font-weight: 700; }
.conflict-amount--in { color: #34c759; }
.conflict-amount--out { color: #ff3b30; }
.conflict-item-date { font-size: 22rpx; color: #a0a0a0; }
.conflict-item-note { font-size: 24rpx; color: #666; }
.conflict-deleted-hint { font-size: 24rpx; color: #dc2626; }
.conflict-vs {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 40rpx;
}
.conflict-vs-line { flex: 1; height: 1rpx; background: #e0e0e0; }
.conflict-vs-text { font-size: 22rpx; color: #ccc; font-weight: 600; }
.conflict-btns { display: flex; gap: 16rpx; }
.conflict-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #e0e0e0;
  color: #666;
  background: #fff;
}
.conflict-btn--local { border-color: #1565c0; color: #1565c0; }
.conflict-btn--server { border-color: #2e7d32; color: #2e7d32; }
.conflict-btn--active.conflict-btn--local { background: #1565c0; color: #fff; }
.conflict-btn--active.conflict-btn--server { background: #2e7d32; color: #fff; }
.conflict-resolved-tag { font-size: 22rpx; color: #34c759; text-align: center; }
.conflict-nav { display: flex; align-items: center; gap: 16rpx; }
.conflict-nav-btn {
  width: 120rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
}
.conflict-nav-btn--disabled { opacity: 0.3; }
.conflict-nav-dots {
  flex: 1;
  display: flex;
  justify-content: center;
  gap: 10rpx;
}
.conflict-nav-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e0e0e0;
}
.conflict-nav-dot--active { background: #333; }
.conflict-nav-dot--resolved { background: #34c759; }
.conflict-apply {
  height: 80rpx;
  background: #34c759;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.conflict-apply--loading { opacity: 0.6; }

/* 深色模式 */
.page--dark .conflict-panel { background: #1c1c1e; }
.page--dark .conflict-panel-title { color: #fff; }
.page--dark .conflict-version { background: #2c2c2e; }
.page--dark .conflict-item-cat { color: #fff; }
.page--dark .conflict-reason { background: #3a2e00; }
.page--dark .conflict-reason-text { color: #fbbf24; }
.page--dark .conflict-btn { background: #2c2c2e; border-color: #555; color: #ccc; }
.page--dark .conflict-nav-btn { background: #2c2c2e; color: #ccc; }
.page--dark .conflict-nav-dot { background: #555; }
.page--dark .conflict-nav-dot--active { background: #fff; }
.page--dark .conflict-progress-bar { background: #3a3a3c; }
.page--dark .rsum-more-tip { color: #888; }
