}
.bill-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
  width: 70rpx;
  flex-shrink: 0;
}
.bill-note-inline {
  font-size: 26rpx;
  color: #a0a0a0;
  width: 80rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item--in .bill-note-inline,
.bill-item--out .bill-note-inline,
.bill-item--advance .bill-note-inline,
.bill-item--payable .bill-note-inline {
  color: #d7d7d7;
}
.bill-item--in .bill-type,
.bill-item--out .bill-type,
.bill-item--advance .bill-type,
.bill-item--payable .bill-type {
  font-weight: 400;
  color: #d7d7d7;
}
.bill-amount {
  font-size: 28rpx;
  font-weight: 500;
