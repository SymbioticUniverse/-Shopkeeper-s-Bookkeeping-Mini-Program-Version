/* 玻璃框网格 — 2列，每个框大小一致 */
.custom-glass-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding-bottom: 24rpx;
  justify-content: center;
}

/* 统一尺寸的玻璃框 */
.custom-glass-frame {
  width: calc((100% - 18rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

/* 玻璃框容器 — 透明玻璃质感 */
.custom-glass-inner {
  width: 100%;
  aspect-ratio: 0.92;
  background: rgba(255,255,255,0.25);
  border: 1rpx solid rgba(255,255,255,0.6);
  border-radius: 22rpx;
  box-shadow:
    inset 0 1rpx 2rpx rgba(255,255,255,0.6),
    0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.custom-glass-inner--s1 {
  aspect-ratio: 0.72;
}
.custom-glass-inner--s2 {
  aspect-ratio: 2.2;
}

/* 玻璃框内的卡片 — 悬浮倾斜 */
.custom-tpl-card {
  background: rgba(255,255,255,0.8);
  border: 1rpx solid #bbb;
  border-radius: 12rpx;
  padding: 16rpx 14rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: rotate(-2.5deg);
}

/* 不同 span 的卡片宽度不同 */
.custom-tpl-card--span1 {
  width: 62%;
}

.custom-tpl-card--span2 {
  width: 86%;
}

/* 缩略卡片内所有文字等比缩小 */
.custom-tpl-card .card-header {
  position: relative;
  padding-left: 44rpx;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.custom-tpl-card .card-header.compact {
  padding-left: 0;
}

.custom-tpl-card .card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
}

.custom-tpl-card .card-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #888;
}

.custom-tpl-card .card-arrow {
  font-size: 16rpx;
  font-weight: 500;
  color: #c0c0c0;
  position: absolute;
  right: 0;
  top: 0;
}

.custom-tpl-card .card-subtitle {
  font-size: 16rpx;
  font-weight: 500;
  color: #b0b0b0;
  display: block;
  margin-top: 1rpx;
}

.custom-tpl-card .card-divider {
  height: 1rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}

.custom-tpl-card .card-divider--down {
  position: relative;
  top: 10rpx;
}

.custom-tpl-card .card-divider--tight {
  margin-top: -10rpx;
}

.custom-tpl-card .card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}

.custom-tpl-card .card-row.three-col {
  justify-content: space-between;
}

.custom-tpl-card .row-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #888;
}

.custom-tpl-card .col-label {
  font-size: 18rpx;
  font-weight: 500;
  color: #b0b0b0;
  text-align: center;
  flex: 1;
}

.custom-tpl-card .value-tag {
  display: flex;
  align-items: baseline;
}

.custom-tpl-card .three-col .value-tag {
  flex: 1;
  justify-content: center;
