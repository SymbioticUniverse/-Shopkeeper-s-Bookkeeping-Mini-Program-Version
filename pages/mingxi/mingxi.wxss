page {
  background: linear-gradient(to top, #BEDAFF 0%, #DBEAFF 37%, #DDF4FF 62%, #CEE9FB 100%);
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 60rpx 26rpx 0;
  box-sizing: border-box;
}

/* ---- 标题栏 ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 30rpx;
  margin-bottom: -20rpx;
  flex-shrink: 0;
  position: relative;
}
.header-left {
  position: relative;
  flex-shrink: 0;
}
.year-text {
  font-size: 26rpx;
  color: #a0a0a0;
  font-weight: 500;
  position: absolute;
  top: -30rpx;
  left: 4rpx;
}
.date-badge {
  display: flex;
  align-items: center;
  margin-top: -4rpx;
  margin-bottom: 12rpx;
}
.date-month-num {
  font-size: 60rpx;
  font-weight: 500;
  color: #000;
}
.date-month-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
  margin-top: 20rpx;
  margin-left: 2rpx;
}
.date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 14rpx solid #000;
  margin-left: 4rpx;
  margin-top: 24rpx;
}
.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #000;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  align-self: center;
}
.header-right-icon {
  margin-top: -16rpx;
  flex-shrink: 0;
}
.header-back-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
  flex-shrink: 0;
}
.back-arrow {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-right: 14rpx solid #000;
}
.back-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
}
.invisible {
  visibility: hidden;
}
.avatar-circle {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* ---- 卡片网格 ---- */
.card-grid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 10rpx 0;
  overflow: hidden;
  position: relative;
}

.card {
  background: rgba(255,255,255,0.3);
  border: 2rpx solid #000;
  border-radius: 26rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0rpx 6rpx 0rpx 1rpx rgba(0,0,0,0.2);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.grid-span-1 { flex: 1; }
.grid-span-2 { flex: 2; }
.grid-span-3 { flex: 3; }

/* ===== 简览页网格布局（span 控制宽度占列） ===== */
.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
}

.overview-grid .card {
  flex: none;
}

.overview-grid .grid-span-1 {
  width: calc((100% - 24rpx) / 3);
}

.overview-grid .grid-span-2 {
  width: calc((100% - 24rpx) / 3 * 2 + 12rpx);
}

.overview-grid .grid-span-3 {
  width: 100%;
}

/* ---- 卡片内部 ---- */
.card-header {
  position: relative;
  padding-left: 82rpx;
  padding-top: 12rpx;
  flex-shrink: 0;
}
.card-header.compact {
  padding-left: 0;
}
.card-avatar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #ccc;
}
.card-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}
.card-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d1d1;
  position: absolute;
  right: 0;
  top: 0;
}
.card-subtitle {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
  display: block;
  margin-top: 2rpx;
}
.card-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 2rpx 0;
  flex-shrink: 0;
}
.card-divider--tight {
  margin-top: -18rpx;
}
.card-divider--down {
  position: relative;
  top: 20rpx;
}

/* ---- 卡片行 ---- */
.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex: 1;
}
.card-row.three-col {
  justify-content: space-between;
}
.col-label {
  font-size: 37rpx;
  font-weight: 700;
  color: #a0a0a0;
  text-align: center;
  flex: 1;
}
.row-label {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}

/* ---- 金额标签 ---- */
.value-tag {
  display: flex;
  align-items: baseline;
}
.three-col .value-tag {
  flex: 1;
  justify-content: center;
}
.value-yen {
  font-size: 34rpx;
  font-weight: 700;
}
.value-num {
  font-size: 42rpx;
  font-weight: 700;
}
.green .value-yen,
.green .value-num {
  color: #00d042;
}
.red .value-yen,
.red .value-num {
  color: red;
}

/* ---- 占位卡片 ---- */
.placeholder-card {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}

/* ---- 底部 TabBar ---- */
.tab-bar-wrapper {
  position: relative;
  height: 129rpx;
  z-index: 999;
  overflow: visible;
  flex-shrink: 0;
  margin: 0 -26rpx;
}
.tab-bar-center-bg {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 119rpx;
  height: 119rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08);
  z-index: 2;
}
.tab-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 103rpx;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding-bottom: 16rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}
.tab-item-center {
  position: relative;
  z-index: 3;
}
.tab-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
}
.tab-icon-placeholder {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #ddd;
}
.tab-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #a0a0a0;
  letter-spacing: 6rpx;
}
.tab-label-active {
  color: #000;
}

/* ---- 我的页面卡片 ---- */
.my-card {
  background: rgba(255,255,255,0.3);
  border: 2rpx solid #000;
  border-radius: 26rpx;
  box-shadow: 0rpx 6rpx 0rpx 1rpx rgba(0,0,0,0.2);
  padding: 24rpx 36rpx;
  justify-content: space-evenly;
}

.my-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 头像区 */
.my-profile {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.my-login-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
}
.my-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ddd;
}

/* 列表项 */
.my-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.3);
  border-radius: 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-item-last {
  padding: 20rpx;
}
.my-item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #ddd;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.my-item-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.my-item-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.my-item-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
  margin-top: 2rpx;
}
.my-item-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d1d1;
  flex-shrink: 0;
}

/* 图标行卡片 */
.my-icon-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.3);
  border-radius: 22rpx;
  padding: 23rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.my-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.my-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ddd;
}
.my-icon-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.my-icon-row-arrow {
  font-size: 28rpx;
  font-weight: 700;
  color: #d1d1d1;
}

/* ---- 报表卡片 ---- */
.report-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.report-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}

/* 个人/公司 切换钮 */
.report-type-toggle {
  position: relative;
  display: flex;
  align-items: center;
  width: 190rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.report-type-bg {
  position: absolute;
  inset: 0;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: inset 0rpx 2rpx 6rpx rgba(0,0,0,0.15);
}
.report-type-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 95rpx;
  height: 42rpx;
  background: rgba(0,0,0,0.08);
  border-radius: 22rpx;
  transition: left 0.25s ease;
}
.report-type-slider--right {
  left: 95rpx;
}
.report-type-text {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
  z-index: 1;
  transition: color 0.25s ease;
}
.report-type-text--active {
  color: #000;
}

/* 周期切换条：月度/季度/年度/日度 */
.report-period-bar {
  display: flex;
  flex-shrink: 0;
}
.report-period-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  background: rgba(255,255,255,0.3);
  border: 2rpx solid #000;
  border-right: none;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.1);
}
.report-period-item:first-child {
  border-radius: 26rpx 0 0 26rpx;
}
.report-period-item:last-child {
  border-radius: 0 26rpx 26rpx 0;
  border-right: 2rpx solid #000;
}
.report-period-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-period-item--active {
  background: rgba(0,0,0,0.06);
}
.report-period-text--active {
  color: #000;
}

/* 图表区容器 */
.report-chart-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 10rpx;
  overflow-y: auto;
}

/* 日期 + 收入/支出 行 */
.report-info-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}
.report-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-date-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #a0a0a0;
}
.report-date-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.3);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.08);
}
.report-inout-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.report-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}
.report-dot--green {
  background: #00d042;
}
.report-dot--red {
  background: red;
}
.report-inout-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
}

.report-chart-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
  flex-shrink: 0;
}
.report-chart-block {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8rpx;
  position: relative;
  min-height: 240rpx;
  flex-shrink: 0;
}
.report-canvas {
  flex: 1;
  width: 100%;
  border-radius: 12rpx;
}

/* 饼状图 */
.report-pie-block {
  flex: 1;
  min-height: 310rpx;
}
.report-pie-row {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}
.report-pie-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.report-pie-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.report-pie-canvas {
  width: 300rpx;
  height: 300rpx;
}

/* ---- 结清卡片 ---- */
.settle-card {
  padding: 28rpx 30rpx 20rpx;
  gap: 0;
}
.settle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.settle-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}
.settle-subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(160,160,160,0.63);
  margin-top: 4rpx;
  margin-bottom: 10rpx;
}
.settle-divider {
  height: 2rpx;
  background: #d1d1d1;
  margin: 10rpx 0;
  flex-shrink: 0;
}
.settle-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.settle-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.settle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.settle-dot--in {
  background: #00d042;
}
.settle-dot--out {
  background: #ed2e2e;
}
.settle-item-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #a0a0a0;
  flex: 1;
}
.settle-item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.settle-amount {
  display: flex;
  align-items: baseline;
}
.settle-yen {
  font-size: 24rpx;
  font-weight: 700;
}
.settle-num {
  font-size: 30rpx;
  font-weight: 700;
}
.settle-amount--in .settle-yen,
.settle-amount--in .settle-num {
  color: #00d042;
}
.settle-amount--out .settle-yen,
.settle-amount--out .settle-num {
  color: #ed2e2e;
}
.settle-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
  border-radius: 44rpx;
  padding: 18rpx 0;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.settle-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}
.settle-warn {
  font-size: 24rpx;
  font-weight: 700;
  color: #000;
  text-align: center;
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* ---- 明细卡片 ---- */
.detail-card {
  padding: 24rpx 28rpx;
  gap: 14rpx;
}
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.detail-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
}
.detail-list-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(246,246,246,0.5);
  border-radius: 26rpx;
  padding: 14rpx 18rpx;
  gap: 0;
  overflow: hidden;
}
.detail-col-headers {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-row {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  margin-bottom: 10rpx;
}
.detail-date-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-inout-box {
  flex: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  box-shadow: 0rpx 4rpx 4rpx 0rpx rgba(0,0,0,0.25);
}
.detail-col-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.detail-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

/* ---- 统一账单明细项 ---- */
.bill-header-row {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  flex-shrink: 0;
}
.bill-header-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #a0a0a0;
}
.bill-item {
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  background: #fff;
  height: 84rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.bill-item--in {
  background: #3a762e;
}
.bill-item--out {
  background: #7e0000;
}
.bill-item--advance {
  background: #3a762e;
}
.bill-item--payable {
  background: #7e0000;
}
.bill-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #d1d1d1;
}
.bill-item--in .bill-dot,
.bill-item--out .bill-dot,
.bill-item--advance .bill-dot,
.bill-item--payable .bill-dot {
  background: rgba(255,255,255,0.5);
}
.bill-cat {
  font-size: 30rpx;
  font-weight: 700;
  color: #000;
  width: 70rpx;
  flex-shrink: 0;
}
.bill-item--in .bill-cat,
.bill-item--out .bill-cat,
.bill-item--advance .bill-cat,
.bill-item--payable .bill-cat {
  font-weight: 400;
  color: #d7d7d7;
}
.bill-type {
  font-size: 28rpx;
  font-weight: 500;
  color: #000;
  width: 70rpx;
  flex-shrink: 0;
}
.bill-note-inline {
  font-size: 26rpx;
  color: #a0a0a0;
  width: 80rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item--in .bill-note-inline,
.bill-item--out .bill-note-inline,
.bill-item--advance .bill-note-inline,
.bill-item--payable .bill-note-inline {
  color: #d7d7d7;
}
.bill-item--in .bill-type,
.bill-item--out .bill-type,
.bill-item--advance .bill-type,
.bill-item--payable .bill-type {
  font-weight: 400;
  color: #d7d7d7;
}
.bill-amount {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
  text-align: right;
  margin-right: 12rpx;
}
.bill-amount--in {
  color: #00d042;
}
.bill-amount--out {
  color: #ed2e2e;
}
.bill-item--in .bill-amount,
.bill-item--out .bill-amount,
.bill-item--advance .bill-amount,
.bill-item--payable .bill-amount {
  color: #fff;
}
.bill-date {
  font-size: 24rpx;
  color: #a0a0a0;
  width: 110rpx;
  flex-shrink: 0;
  text-align: right;
}
.bill-item--in .bill-date,
.bill-item--out .bill-date,
.bill-item--advance .bill-date,
.bill-item--payable .bill-date {
  color: #d7d7d7;
}
.bill-note {
  font-size: 22rpx;
  font-weight: 700;
  color: #a0a0a0;
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bill-item--in .bill-note,
.bill-item--out .bill-note {
  color: #d7d7d7;
}

/* ---- 滑动操作 ---- */
.bill-row {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  height: 84rpx;
}
.bill-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  z-index: 0;
}
.bill-act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}
.bill-act-settle { background: #00d042; }
.bill-act-delete { background: #ed2e2e; }
.bill-act-void { background: #333; }
.bill-act-unvoid { background: #007aff; }
.bill-item {
  position: relative;
  z-index: 1;
}
/* ---- 作废状态 ---- */
.bill-item--voided {
  background: #f5f5f5 !important;
}
.bill-item--voided .bill-cat,
.bill-item--voided .bill-type,
.bill-item--voided .bill-amount,
.bill-item--voided .bill-date {
  text-decoration: line-through;
  color: #999 !important;
}
.bill-item--voided .bill-dot {
  background: #999 !important;
}

/* ---- 详情弹窗 ---- */
.bill-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.35);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bill-modal {
  width: 580rpx;
  background: #fff;
  border: 2rpx solid #000;
  border-radius: 26rpx;
  box-shadow: 0rpx 6rpx 0rpx 1rpx rgba(0,0,0,0.2);
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.bill-modal-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #000;
  text-align: center;
}
.bill-modal-divider {
  height: 2rpx;
  background: #d1d1d1;
  flex-shrink: 0;
}
.bill-modal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.bill-modal-label {
  font-size: 28rpx;
  color: #a0a0a0;
  width: 90rpx;
  flex-shrink: 0;
}
.bill-modal-value {
  font-size: 28rpx;
  color: #000;
  flex: 1;
  text-align: right;
}
.bill-modal-value--in { color: #00d042; }
.bill-modal-value--out { color: #ed2e2e; }
.bill-modal-input {
  font-size: 28rpx;
  color: #000;
  text-align: right;
  flex: 1;
  background: rgba(246,246,246,0.8);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  box-shadow: inset 0rpx 2rpx 4rpx rgba(0,0,0,0.06);
}
.bill-modal-btns {
  display: flex;
  gap: 14rpx;
  margin-top: 4rpx;
}
.bill-modal-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}
.bill-modal-save { background: #000; }
.bill-modal-settle { background: #00d042; }
.bill-modal-delete { background: #ed2e2e; }
.bill-modal-void { background: #333; }
.bill-modal-unvoid { background: #007aff; }

/* ---- VIP 升级卡片（内嵌在 Tab4 中） ---- */
.vip-main-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.vip-main-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.vip-back-btn {
  display: flex;
  align-items: center;
}

.vip-main-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.vip-header-spacer {
  width: 100rpx;
}

/* 缩略图滚动区 */
.vip-thumb-scroll {
  flex: 1;
  overflow-y: auto;
  display: flex;
  align-items: center;
}

/* 缩略图网格 — 3列 */
.vip-thumb-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx 12rpx;
  gap: 20rpx;
  width: 100%;
}

.vip-thumb-item {
  width: calc((100% - 40rpx) / 3);
  aspect-ratio: 0.82;
  border-radius: 22rpx;
  padding: 28rpx 10rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
  overflow: hidden;
  animation: vipThumbIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.vip-thumb-item:active {
  transform: scale(0.94);
}

@keyframes vipThumbIn {
  from { opacity: 0; transform: translateY(80rpx) scale(0.85); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 缩略图统一样式 — 纯白 50% 透明 */
.vip-thumb--free,
.vip-thumb--default,
.vip-thumb--ultra {
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.vip-thumb-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  letter-spacing: 1rpx;
}

.vip-thumb--free .vip-thumb-name { color: #a0a0a0; }
.vip-thumb--ultra .vip-thumb-name { color: #8a7a5a; }

.vip-thumb-tagline {
  font-size: 20rpx;
  font-weight: 500;
  color: #888;
  text-align: center;
}

.vip-thumb--free .vip-thumb-tagline { color: #b0b0b0; }
.vip-thumb--ultra .vip-thumb-tagline { color: #b8a080; }

.vip-thumb-discount {
  font-size: 18rpx;
  font-weight: 700;
  color: #cf9f40;
  background: rgba(207,159,64,0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.vip-thumb-contact {
  background: #0d1d3e;
  border-radius: 14rpx;
  padding: 12rpx 28rpx;
  margin-top: 4rpx;
}

.vip-thumb-contact-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #cf9f40;
  letter-spacing: 3rpx;
}

/* 详情页过渡 */
@keyframes vipDetailIn {
  from { opacity: 0; transform: scale(0.88) translateY(30rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* 详情页 — 点击空白区域返回缩略图 */
.vip-detail-body {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  animation: vipDetailIn 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.vip-detail-backdrop {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.vip-detail-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 768rpx;
  white-space: nowrap;
}

.vip-card-row {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding: 0 24rpx;
  gap: 24rpx;
  align-items: center;
}

.vip-card-row::after {
  content: '';
  flex-shrink: 0;
  width: 24rpx;
}

/* ---- 单卡 ---- */
.vip-card-single {
  width: 552rpx;
  height: 768rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  padding: 28rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

/* 选中态 — 彩虹流光呼吸 */
.vip-card-single--selected {
  border-width: 8rpx;
  border-style: solid;
  animation: vipRainbowFlow 3.6s linear infinite;
}

@keyframes vipRainbowFlow {
  0%   {
    border-color: #ff6b6b;
    box-shadow: 0 0 6rpx rgba(255,107,107,0.5);
    background: linear-gradient(180deg, rgba(255,107,107,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  16%  {
    border-color: #ffaa33;
    box-shadow: 0 0 6rpx rgba(255,170,51,0.5);
    background: linear-gradient(180deg, rgba(255,170,51,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  33%  {
    border-color: #ffe83d;
    box-shadow: 0 0 6rpx rgba(255,232,61,0.5);
    background: linear-gradient(180deg, rgba(255,232,61,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  50%  {
    border-color: #56d870;
    box-shadow: 0 0 6rpx rgba(86,216,112,0.5);
    background: linear-gradient(180deg, rgba(86,216,112,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  66%  {
    border-color: #4da6ff;
    box-shadow: 0 0 6rpx rgba(77,166,255,0.5);
    background: linear-gradient(180deg, rgba(77,166,255,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  83%  {
    border-color: #a855f7;
    box-shadow: 0 0 6rpx rgba(168,85,247,0.5);
    background: linear-gradient(180deg, rgba(168,85,247,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  100% {
    border-color: #ff6b6b;
    box-shadow: 0 0 6rpx rgba(255,107,107,0.5);
    background: linear-gradient(180deg, rgba(255,107,107,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
}

/* 套餐名 */
.vip-card-single-name {
  font-size: 40rpx;
  font-weight: 500;
  color: #000;
  text-align: center;
  margin-bottom: 20rpx;
}

/* 功能列表 */
.vip-card-single-features {
