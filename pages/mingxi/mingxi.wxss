}

/* ---- 滑动操作 ---- */
.bill-row {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  height: 84rpx;
}
.bill-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
