/* ---- VIP 升级卡片（内嵌在 Tab4 中） ---- */
.vip-main-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.vip-main-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.vip-back-btn {
  display: flex;
  align-items: center;
}

.vip-main-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}

.vip-header-spacer {
  width: 100rpx;
}

/* 缩略图滚动区 */
.vip-thumb-scroll {
  flex: 1;
  overflow-y: auto;
  display: flex;
  align-items: center;
}

/* 缩略图网格 — 3列 */
.vip-thumb-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 24rpx 12rpx;
  gap: 20rpx;
  width: 100%;
}

.vip-thumb-item {
  width: calc((100% - 40rpx) / 3);
  aspect-ratio: 0.82;
  border-radius: 22rpx;
  padding: 28rpx 10rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  position: relative;
  overflow: hidden;
  animation: vipThumbIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.vip-thumb-item:active {
  transform: scale(0.94);
}

@keyframes vipThumbIn {
  from { opacity: 0; transform: translateY(80rpx) scale(0.85); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 缩略图统一样式 — 纯白 50% 透明 */
.vip-thumb--free,
.vip-thumb--default,
.vip-thumb--ultra {
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.vip-thumb-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  letter-spacing: 1rpx;
}

.vip-thumb--free .vip-thumb-name { color: #a0a0a0; }
.vip-thumb--ultra .vip-thumb-name { color: #8a7a5a; }

.vip-thumb-tagline {
  font-size: 20rpx;
  font-weight: 500;
  color: #888;
  text-align: center;
}

.vip-thumb--free .vip-thumb-tagline { color: #b0b0b0; }
.vip-thumb--ultra .vip-thumb-tagline { color: #b8a080; }

.vip-thumb-discount {
  font-size: 18rpx;
  font-weight: 700;
  color: #cf9f40;
  background: rgba(207,159,64,0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.vip-thumb-contact {
  background: #0d1d3e;
  border-radius: 14rpx;
  padding: 12rpx 28rpx;
  margin-top: 4rpx;
}

.vip-thumb-contact-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #cf9f40;
  letter-spacing: 3rpx;
}

/* 详情页过渡 */
@keyframes vipDetailIn {
  from { opacity: 0; transform: scale(0.88) translateY(30rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

/* 详情页 — 点击空白区域返回缩略图 */
.vip-detail-body {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  animation: vipDetailIn 0.45s cubic-bezier(0.16, 1, 0.3, 1);
}

.vip-detail-backdrop {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.vip-detail-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 768rpx;
  white-space: nowrap;
}

.vip-card-row {
  display: flex;
  flex-direction: row;
  height: 100%;
  padding: 0 24rpx;
  gap: 24rpx;
  align-items: center;
}

.vip-card-row::after {
  content: '';
  flex-shrink: 0;
  width: 24rpx;
}

/* ---- 单卡 ---- */
.vip-card-single {
  width: 552rpx;
  height: 768rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  padding: 28rpx 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

/* 选中态 — 彩虹流光呼吸 */
.vip-card-single--selected {
  border-width: 8rpx;
  border-style: solid;
  animation: vipRainbowFlow 3.6s linear infinite;
}

@keyframes vipRainbowFlow {
  0%   {
    border-color: #ff6b6b;
    box-shadow: 0 0 6rpx rgba(255,107,107,0.5);
    background: linear-gradient(180deg, rgba(255,107,107,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  16%  {
    border-color: #ffaa33;
    box-shadow: 0 0 6rpx rgba(255,170,51,0.5);
    background: linear-gradient(180deg, rgba(255,170,51,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  33%  {
    border-color: #ffe83d;
    box-shadow: 0 0 6rpx rgba(255,232,61,0.5);
    background: linear-gradient(180deg, rgba(255,232,61,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  50%  {
    border-color: #56d870;
    box-shadow: 0 0 6rpx rgba(86,216,112,0.5);
    background: linear-gradient(180deg, rgba(86,216,112,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  66%  {
    border-color: #4da6ff;
    box-shadow: 0 0 6rpx rgba(77,166,255,0.5);
    background: linear-gradient(180deg, rgba(77,166,255,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  83%  {
    border-color: #a855f7;
    box-shadow: 0 0 6rpx rgba(168,85,247,0.5);
    background: linear-gradient(180deg, rgba(168,85,247,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
  100% {
    border-color: #ff6b6b;
    box-shadow: 0 0 6rpx rgba(255,107,107,0.5);
    background: linear-gradient(180deg, rgba(255,107,107,0.1) 0%, rgba(255,255,255,0.5) 70%);
  }
}

/* 套餐名 */
.vip-card-single-name {
  font-size: 40rpx;
  font-weight: 500;
  color: #000;
  text-align: center;
  margin-bottom: 20rpx;
}

