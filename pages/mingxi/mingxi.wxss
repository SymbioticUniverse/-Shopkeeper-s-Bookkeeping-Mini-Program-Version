/* ==================== 账本页：本月概览 + 月度预算 ==================== */
.ledger-card {
  flex: 1 1 auto;
  width: 100%;
  box-sizing: border-box;
  align-self: stretch;
  overflow: visible;
}
.ledger-sec {
  background: #fff;
