/* ---- 通知页 ---- */
.notify-scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 24rpx;
}

.notify-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.notify-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: none;
  align-items: center;
  justify-content: center;
  background: #ff3b30;
  border-radius: 0 20rpx 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

.notify-swipe--open .notify-delete {
  display: flex;
}

.notify-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  transition: transform 0.25s ease;
}

.notify-item--open {
  transform: translateX(-160rpx);
}

.notify-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff3b30;
  position: absolute;
  right: 20rpx;
  top: 24rpx;
}

