}

.custom-tpl-card .settle-btn-text {
  font-size: 18rpx;
  font-weight: 500;
  color: #fff;
}

/* 明细页截断预览 — 参照明细页交易流水列表 */
.custom-tpl-detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rpx;
}
.custom-tpl-detail-title {
  font-size: 20rpx;
  font-weight: 500;
  color: #333;
}
.custom-tpl-detail-toggle {
  display: flex;
  background: rgba(0,0,0,0.06);
  border-radius: 6rpx;
  padding: 1rpx;
}
.custom-tpl-toggle-item {
  font-size: 14rpx;
  font-weight: 500;
  color: #a0a0a0;
  padding: 1rpx 8rpx;
