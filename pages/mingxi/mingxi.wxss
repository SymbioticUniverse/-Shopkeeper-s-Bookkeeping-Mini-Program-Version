}
.bill-item--in .bill-date,
.bill-item--out .bill-date,
.bill-item--advance .bill-date,
.bill-item--payable .bill-date {
  color: #d7d7d7;
}
.bill-note {
  font-size: 22rpx;
  font-weight: 700;
  color: #a0a0a0;
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
